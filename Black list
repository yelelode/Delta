if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- LocalPlayer aur UserId load hone tak safe wait
while not lp or not lp.UserId or lp.UserId == 0 do
    lp = Players.LocalPlayer or Players.PlayerAdded:Wait()
    task.wait(0.1)
end

-- 🎯 TARGET LIST
local BLACKLISTED_USERS = {
    10097226859, -- Pehla Target
    11414201166, -- Target 2
    -- 11542536882,
    -- 7976332217,
}

local currentUserId = lp.UserId
local isTarget = false

for _, id in ipairs(BLACKLISTED_USERS) do
    if tonumber(id) == tonumber(currentUserId) then
        isTarget = true
        break
    end
end

if isTarget then
    warn("[TXR SECURITY] Blacklisted User Detected: " .. tostring(currentUserId))
    
    local chatMsg = "Sorry yaar Ashu papa"
    local messageSent = false

    -- STEP 1: PEHLE CHAT MESSAGE BHEJO
    pcall(function()
        local TextChatService = game:GetService("TextChatService")
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = TextChatService:WaitForChild("TextChannels", 3)
            local general = channels and channels:WaitForChild("RBXGeneral", 3)
            if general then
                general:SendAsync(chatMsg)
                messageSent = true
            end
        end
    end)

    -- Legacy Chat Fallback (Agar TextChatService na chale)
    if not messageSent then
        pcall(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 3)
            local sayReq = chatEvents and chatEvents:WaitForChild("SayMessageRequest", 3)
            if sayReq then
                sayReq:FireServer(chatMsg, "All")
            end
        end)
    end

    -- STEP 2: WAIT KARO TAAKI SERVER SABKO CHAT BROADCAST KAR DE
    task.wait(1.5)

    -- STEP 3: SCREEN CLEAR AUR CHARACTER DESTROY
    pcall(function()
        if lp:FindFirstChild("PlayerGui") then
            lp.PlayerGui:ClearAllChildren()
        end
        if lp.Character then
            lp.Character:Destroy()
        end
    end)

    -- STEP 4: SABSE AAKHIR ME KICK TRIGGER HOGA
    lp:Kick("Disrespected the Owner? Go use your other scripts. Appeal on Discord.")

    -- STEP 5: THREAD FREEZE (UI KISI BHI HAAL ME LOAD NA HO)
    while true do
        task.wait(999999)
    end

    return true
end

return false
