-- 🚀 ULTRA-PRECISE 20% BOUNDARY & 100% ORB CLAMPING DRAG ENGINE[span_191](start_span)[span_191](end_span)
local function makeDraggable(frame, handle, ghostAura, isOrb)[span_192](start_span)[span_192](end_span)
    local dragging = false[span_193](start_span)[span_193](end_span)
    local dragStart = nil[span_194](start_span)[span_194](end_span)
    local startPos = nil[span_195](start_span)[span_195](end_span)
    local targetPos = frame.Position[span_196](start_span)[span_196](end_span)
