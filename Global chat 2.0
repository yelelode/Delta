    local lastInputPos = Vector2.new(0, 0)[span_198](start_span)[span_198](end_span)
    local dragLoop = nil[span_199](start_span)[span_199](end_span)

    local function getClampedTarget(newXScale, newXOffset, newYScale, newYOffset)[span_200](start_span)[span_200](end_span)
        local parentSize = gui.AbsoluteSize[span_201](start_span)[span_201](end_span)
        local frameSize = frame.AbsoluteSize[span_202](start_span)[span_202](end_span)
        local anchor = frame.AnchorPoint[span_203](start_span)[span_203](end_span)

        local absX = (newXScale * parentSize.X) + newXOffset[span_204](start_span)[span_204](end_span)
        local absY = (newYScale * parentSize.Y) + newYOffset[span_205](start_span)[span_205](end_span)

        local minX, maxX, minY, maxY[span_206](start_span)[span_206](end_span)

        if isOrb then[span_207](start_span)[span_207](end_span)
            minX = frameSize.X * anchor.X[span_208](start_span)[span_208](end_span)
            maxX = parentSize.X - (frameSize.X * (1 - anchor.X))[span_209](start_span)[span_209](end_span)
            minY = frameSize.Y * anchor.Y[span_210](start_span)[span_210](end_span)
            maxY = parentSize.Y - (frameSize.Y * (1 - anchor.Y))[span_211](start_span)[span_211](end_span)
        else[span_212](start_span)[span_212](end_span)
            local visibleWidth = frameSize.X * 0.20[span_213](start_span)[span_213](end_span)
            local visibleHeight = frameSize.Y * 0.20[span_214](start_span)[span_214](end_span)

            minX = (frameSize.X * anchor.X) - (frameSize.X - visibleWidth)[span_215](start_span)[span_215](end_span)
            maxX = parentSize.X - (frameSize.X * (1 - anchor.X)) + (frameSize.X - visibleWidth)[span_216](start_span)[span_216](end_span)
            minY = (frameSize.Y * anchor.Y) - (frameSize.Y - visibleHeight)[span_217](start_span)[span_217](end_span)
            maxY = parentSize.Y - (frameSize.Y * (1 - anchor.Y)) + (frameSize.Y - visibleHeight)[span_218](start_span)[span_218](end_span)
        end[span_219](start_span)[span_219](end_span)

        local clampedX = math.clamp(absX, minX, maxX)[span_220](start_span)[span_220](end_span)
        local clampedY = math.clamp(absY, minY, maxY)[span_221](start_span)[span_221](end_span)

        return UDim2.new(newXScale, clampedX - (newXScale * parentSize.X), newYScale, clampedY - (newYScale * parentSize.Y))[span_222](start_span)[span_222](end_span)
    end[span_223](start_span)[span_223](end_span)

    handle.InputBegan:Connect(function(input)[span_224](start_span)[span_224](end_span)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then[span_225](start_span)[span_225](end_span)
            dragging = true[span_226](start_span)[span_226](end_span)
