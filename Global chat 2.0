                if dragging then[span_244](start_span)[span_244](end_span)
                    frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 25, 0, 1))[span_245](start_span)[span_245](end_span)
                else[span_246](start_span)[span_246](end_span)
                    if velocity.Magnitude > 0.5 then[span_247](start_span)[span_247](end_span)
                        velocity = velocity * 0.90[span_248](start_span)[span_248](end_span)
                        targetPos = getClampedTarget(targetPos.X.Scale, targetPos.X.Offset + velocity.X, targetPos.Y.Scale, targetPos.Y.Offset + velocity.Y)[span_249](start_span)[span_249](end_span)
                        frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 15, 0, 1))[span_250](start_span)[span_250](end_span)
                    else[span_251](start_span)[span_251](end_span)
                        dragLoop:Disconnect()[span_252](start_span)[span_252](end_span)
                        dragLoop = nil[span_253](start_span)[span_253](end_span)
                    end[span_254](start_span)[span_254](end_span)
                end[span_255](start_span)[span_255](end_span)
                
                if ghostAura then[span_256](start_span)[span_256](end_span)
                    ghostAura.Position = frame.Position[span_257](start_span)[span_257](end_span)
                end[span_258](start_span)[span_258](end_span)
            end)[span_259](start_span)[span_259](end_span)
        end[span_260](start_span)[span_260](end_span)
    end)[span_261](start_span)[span_261](end_span)

    handle.InputEnded:Connect(function(input)[span_262](start_span)[span_262](end_span)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then[span_263](start_span)[span_263](end_span)
            dragging = false[span_264](start_span)[span_264](end_span)
            if isOrb then[span_265](start_span)[span_265](end_span)
                isDraggingOrb = false[span_266](start_span)[span_266](end_span)
                orbHovered = false[span_267](start_span)[span_267](end_span)
            end[span_268](start_span)[span_268](end_span)
        end[span_269](start_span)[span_269](end_span)
    end)[span_270](start_span)[span_270](end_span)

    UserInputService.InputChanged:Connect(function(input)[span_271](start_span)[span_271](end_span)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then[span_272](start_span)[span_272](end_span)
            local delta = input.Position - dragStart[span_273](start_span)[span_273](end_span)
