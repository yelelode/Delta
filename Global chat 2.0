    PrimaryDark   = Color3.fromRGB(0, 160, 140),     
    Danger        = Color3.fromRGB(255, 40, 80),          
    Warning       = Color3.fromRGB(255, 170, 0),         
    Purple        = Color3.fromRGB(160, 50, 255),         
    Text          = Color3.fromRGB(240, 245, 255),          
    SubText       = Color3.fromRGB(120, 135, 160),       
    TextDark      = Color3.fromRGB(10, 15, 22),
    MentionGold   = Color3.fromRGB(255, 200, 50),
    MentionBg     = Color3.fromRGB(42, 34, 14),
