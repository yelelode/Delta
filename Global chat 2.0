local emojiRaw = "😃😁😆😂🤣😎🫡🔥💀❤️🖤✨💯👑⚡⚠️🔒💬🍜🍕🚀🎉"
if utf8 and utf8.graphemes then
    for p, c in utf8.graphemes(emojiRaw) do
        local em = string.sub(emojiRaw, p, c)
        local btn = Instance.new("TextButton", emojiScroll)
        btn.Text = em
        btn.TextSize = 15
        btn.BackgroundTransparency = 1
        btn.ZIndex = 32
        btn.MouseButton1Click:Connect(function()
            chatInput.Text = chatInput.Text .. em
            chatInput:CaptureFocus()
        end)
    end
end

