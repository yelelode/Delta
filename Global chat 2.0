            end[span_235](start_span)[span_235](end_span)
            
            if dragLoop then[span_236](start_span)[span_236](end_span)
                dragLoop:Disconnect()[span_237](start_span)[span_237](end_span)
            end[span_238](start_span)[span_238](end_span)
            
            dragLoop = RunService.RenderStepped:Connect(function(dt)[span_239](start_span)[span_239](end_span)
                if _G.TXR_ChatInstanceID ~= currentExecutionID then[span_240](start_span)[span_240](end_span)
                    dragLoop:Disconnect()[span_241](start_span)[span_241](end_span)
                    return[span_242](start_span)[span_242](end_span)
