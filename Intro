-- ⚡ PROGRESSION SEQUENCE
-- =========================================================
task.spawn(function()
    local bootSteps = {
        {target = 0.22, text = "🔐 Establishing Quantum Encryption Bridge...", duration = LOAD_DURATION * 0.16},
        {target = 0.48, text = "⚡ Synchronizing 144Hz Lerp Subsystems...", duration = LOAD_DURATION * 0.20},
        {target = 0.72, text = "🛡️ Loading Apex Cyber Memory Allocator...", duration = LOAD_DURATION * 0.24},
        {target = 0.90, text = "🔮 Injecting Dynamic Shader Layer...", duration = LOAD_DURATION * 0.22},
        {target = 0.97, text = "✨ Finalizing Secure Runtime Core...", duration = LOAD_DURATION * 0.10},
        {target = 1.00, text = "👑 TXR HUB READY!", duration = LOAD_DURATION * 0.08}
    }
    
    for _, step in ipairs(bootSteps) do
        statusLabel.Text = step.text
        local startTime = os.clock()
        local startPct = targetProgress
        
        while (os.clock() - startTime) < step.duration do
            local alpha = (os.clock() - startTime) / step.duration
            local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
            targetProgress = startPct + (step.target - startPct) * smoothAlpha
            task.wait()
        end
        targetProgress = step.target
    end
    
    targetProgress = 1.0
    task.wait(0.2)

    isIntroActive = false
    renderConn:Disconnect()

    local softFadeInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    TweenService:Create(mainCanvas, softFadeInfo, {GroupTransparency = 1}):Play()
    TweenService:Create(bg, softFadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(blur, softFadeInfo, {Size = 0}):Play()

    task.wait(0.4)

    pcall(function()
        introGui:Destroy()
        blur:Destroy()
    end)

    -- 🚀 INSTANT EXECUTION (0ms DELAY)
    if preloadedScript then
        task.spawn(preloadedScript)
    else
        task.spawn(function()
            local success, rawCode = pcall(function()
                return game:HttpGet("https://raw.githubusercontent.com/yelelode/Delta/refs/heads/main/Secure1Version.lua")
            end)
            if success and rawCode then
                local runScript = loadstring(rawCode)
                if runScript then runScript() end
            end
        end)
    end
end)
