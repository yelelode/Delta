-- =========================================================
-- 🔄 LIGHTWEIGHT RENDER LOOP
-- =========================================================
local isIntroActive = true
local currentProgress = 0.0
local targetProgress = 0.0
local lastPct = -1

local renderConn = RunService.RenderStepped:Connect(function(dt)
    if not isIntroActive then return end
    local t = os.clock()
    
    currentProgress = currentProgress + (targetProgress - currentProgress) * math.clamp(dt * 14, 0, 1)
    local displayPct = math.clamp(math.floor(currentProgress * 100), 0, 100)
    
    if displayPct ~= lastPct then
        percentLabel.Text = displayPct .. "%"
        lastPct = displayPct
    end
    
    barFill.Size = UDim2.new(currentProgress, 0, 1, 0)
    laserTip.Position = UDim2.new(currentProgress, 0, 0.5, 0)

    for _, pt in ipairs(bgParticles) do
        local yPos = ((t * pt.speed * 0.04) + pt.offset) % 1
        pt.frame.Position = UDim2.new(pt.frame.Position.X.Scale, 0, yPos, 0)
    end
    
    liveDot.BackgroundTransparency = 0.3 + math.abs(math.sin(t * 3)) * 0.5
    
    local rot1 = (t * 45) % 360
    square1.Rotation = rot1
    square2.Rotation = -rot1 * 1.2
    square3.Rotation = rot1 * 1.5
    
    for _, spData in ipairs(sparks) do
        local angle = (t * spData.orbitSpeed) + spData.offset
        spData.frame.Position = UDim2.new(0.5, math.cos(angle) * spData.orbitX, 0.5, math.sin(angle) * spData.orbitY)
    end
end)

