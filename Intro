-- =========================================================
-- 🔄 144HZ FLUID RENDER LOOP
-- =========================================================
local isIntroActive = true
local currentProgress = 0.0
local targetProgress = 0.0

local renderConn = RunService.RenderStepped:Connect(function(dt)
    if not isIntroActive then return end
    local t = tick()
    
    currentProgress = currentProgress + (targetProgress - currentProgress) * math.clamp(dt * 15, 0, 1)
    percentLabel.Text = math.clamp(math.floor(currentProgress * 100), 0, 100) .. "%"
    barFill.Size = UDim2.new(currentProgress, 0, 1, 0)

    for _, pt in ipairs(bgParticles) do
        local yPos = ((t * pt.speed * 0.04) + pt.offset) % 1
        pt.frame.Position = UDim2.new(pt.frame.Position.X.Scale, 0, yPos, 0)
    end
    
    local scaleX1 = 0.4 + math.abs(math.sin(t * 1.8)) * 0.6
    local scaleY1 = 0.4 + math.abs(math.cos(t * 1.8)) * 0.6
    square1.Size = UDim2.fromOffset(128 * scaleX1, 128 * scaleY1)
    square1.Rotation = (t * 50) % 360
    
    local scaleX2 = 0.4 + math.abs(math.cos(t * 2.2)) * 0.6
    local scaleY2 = 0.4 + math.abs(math.sin(t * 2.2)) * 0.6
    square2.Size = UDim2.fromOffset(102 * scaleX2, 102 * scaleY2)
    square2.Rotation = -(t * 65) % 360

    local scaleX3 = 0.4 + math.abs(math.sin(t * 2.6)) * 0.6
    local scaleY3 = 0.4 + math.abs(math.cos(t * 2.6)) * 0.6
    square3.Size = UDim2.fromOffset(80 * scaleX3, 80 * scaleY3)
    square3.Rotation = (t * 80) % 360
end)

-- =========================================================
-- ⚡ 5-SECOND TIMELINE SEQUENCE
-- =========================================================
task.spawn(function()
    local bootSteps = {
        {target = 0.25, text = "🔐 Establishing Quantum Encryption Bridge...", duration = LOAD_DURATION * 0.20},
        {target = 0.55, text = "⚡ Synchronizing 144Hz Lerp Subsystems...", duration = LOAD_DURATION * 0.25},
        {target = 0.80, text = "🛡️ Loading Apex Cyber Memory Allocator...", duration = LOAD_DURATION * 0.30},
        {target = 0.95, text = "🔮 Injecting Dynamic Shader Layer...", duration = LOAD_DURATION * 0.15},
        {target = 1.00, text = "👑 TXR HUB READY!", duration = LOAD_DURATION * 0.10}
    }
    
    for _, step in ipairs(bootSteps) do
        statusLabel.Text = step.text
        local startTime = tick()
        local startPct = targetProgress
        
        while (tick() - startTime) < step.duration do
            local alpha = (tick() - startTime) / step.duration
            local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
            targetProgress = startPct + (step.target - startPct) * smoothAlpha
            task.wait()
        end
        targetProgress = step.target
    end
    
    targetProgress = 1.0
    task.wait(0.2)
    
    -- Smooth Fade Out
    isIntroActive = false
    renderConn:Disconnect()

    local fadeTween = TweenService:Create(mainCanvas, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {GroupTransparency = 1})
    TweenService:Create(bg, TweenInfo.new(0.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
    TweenService:Create(blur, TweenInfo.new(0.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Size = 0}):Play()
    fadeTween:Play()

    task.wait(0.4)

    pcall(function()
        introGui:Destroy()
        blur:Destroy()
    end)

    -- =========================================================
    -- 🚀 MAIN SCRIPT EXECUTION
    -- =========================================================
    task.spawn(function()
        local success, rawCode = pcall(function()
            return game:HttpGet("https://raw.githubusercontent.com/yelelode/Delta/refs/heads/main/Secure1Version.lua")
        end)
        
        if success and rawCode then
            local runScript, err = loadstring(rawCode)
            if runScript then
                runScript()
            else
                warn("[TXR HUB] Script Compile Error: " .. tostring(err))
            end
        else
            warn("[TXR HUB] Failed to fetch script from GitHub!")
        end
    end)
end)
