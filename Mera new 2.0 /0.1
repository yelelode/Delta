                maxWait = maxWait + 0.1
                
                local repeatScan = workspace:GetPartBoundsInRadius(hrp.Position, 40)
                for _, obj in ipairs(repeatScan) do
                    if string.sub(obj.Name, 1, 4) == "Prop" then
                        local ownerName = string.sub(obj.Name, 5)
                        if ownerName ~= "" and ownerName ~= lp.Name then
                            local p = Players:FindFirstChild(ownerName)
                            if p and not protectedVictims[p] then 
                                attackersToBan[p] = true 
                                attackerArrived = true
                            end
                        end
                    end
                    local pModel = obj:FindFirstAncestorOfClass("Model")
                    if pModel and pModel ~= lp.Character and not protectedVictims[pModel] then
                        local p = Players:GetPlayerFromCharacter(pModel)
                        if p and not protectedVictims[p] then 
                            attackersToBan[p] = true 
                            attackerArrived = true
                        end
                    end
                end
                
                if attackerArrived and maxWait >= 0.4 then 
                    break 
                end
            end
            
            local hasBannedSomeone = false
            if houseData.Disallow then
                for attacker, _ in pairs(attackersToBan) do
                    if attacker and attacker.Parent and not protectedVictims[attacker] then
                        hasBannedSomeone = true
                        task.spawn(function() pcall(function() houseData.Disallow:FireServer(attacker) end) end)
                    end
                end
            end

            if houseData.Remote then
                for i = 1, 20 do
                    task.spawn(function() pcall(function() houseData.Remote:InvokeServer() end) end)
                    task.wait(0.01)
                end
            end
            
            task.wait(0.1) 
            hrp.CFrame = originalPos

            if houseData.Allow then
                for attacker, _ in pairs(attackersToBan) do
                    if attacker and attacker.Parent and not protectedVictims[attacker] then
                        task.spawn(function()
                            task.wait(0.5)
                            pcall(function() houseData.Allow:FireServer(attacker) end)
                        end)
                    end
                end
            end

            if hasBannedSomeone or attackerArrived then
                sendNotif("✅ SUCCESS", "Hacker Banned & Safe!", 3)
            else
                sendNotif("⚠️ NO TARGET FOUND", "No attacking props detected.", 2)
            end

            task.spawn(function()
                local myHouseData = getMyHouse()
                local myClearRemote = myHouseData and myHouseData.Remote

                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj.Name == "Permissions:ClearProps" and obj:IsA("RemoteFunction") then
                        if obj ~= myClearRemote then 
                            task.spawn(function() pcall(function() obj:InvokeServer() end) end)
                            task.wait(0.01) 
                        end
                    end
                end
            end)
        end)
        
        if not success then warn("TXR Error:", err) end
        task.wait(0.3) 
        isEvading = false 
        banTrapDebounce = false
    end)
end)

