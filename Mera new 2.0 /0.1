local function notif(t, b, d) pcall(function() StarterGui:SetCore("SendNotification",{Title=t,Text=b,Duration=d or 3}) end) end

local function stroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke", parent)
    s.Color = color; s.Thickness = thick or 1.5; s.Transparency = trans or 0.2
    return s
end

local function corner(parent, rad)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, rad or 10)
    return c
end

local function shadow(parent, zIndex)
    local sh = Instance.new("ImageLabel", parent)
    sh.Name = "Shadow"
    sh.Size = UDim2.fromScale(1.18, 1.18)
    sh.Position = UDim2.fromScale(0.5, 0.5)
    sh.AnchorPoint = Vector2.new(0.5, 0.5)
    sh.BackgroundTransparency = 1
    sh.Image = "rbxassetid://6014054959"
    sh.ImageColor3 = Color3.new(0,0,0)
    sh.ImageTransparency = 0.5
    sh.ZIndex = zIndex or 1
    sh.ScaleType = Enum.ScaleType.Slice
    sh.SliceCenter = Rect.new(49, 49, 450, 450)
    return sh
end

local function glow(parent, color, trans, size, zIdx)
    local g = Instance.new("ImageLabel", parent)
    g.Name = "Glow"
    g.Size = UDim2.fromScale(size or 1.7, size or 1.7)
    g.Position = UDim2.fromScale(0.5, 0.5)
    g.AnchorPoint = Vector2.new(0.5, 0.5)
    g.BackgroundTransparency = 1
    g.Image = "rbxassetid://10470601783"
    g.ImageColor3 = color
    g.ImageTransparency = trans or 0.5
    g.ZIndex = zIdx or (parent.ZIndex - 1)
    return g
end

local function crisp(el)
    local s = Instance.new("UIStroke", el)
    s.Color = Color3.new(0,0,0); s.Transparency = 0.7; s.Thickness = 1.2
end

local function tween(obj, t, props, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props)
end

