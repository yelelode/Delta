        -- 1. Scan near player body (Radius 45 for slow/fast bots)
        if hrp then
            for _, obj in ipairs(workspace:GetPartBoundsInRadius(hrp.Position, 45)) do
                local parentName = obj.Parent and obj.Parent.Name or ""
                if (obj.Name:match("Prop") or parentName:match("Prop") or obj.Name:match("Robot") or parentName:match("Robot") or obj.Name:match("Screen")) and not obj.Name:match(lp.Name) and not parentName:match(lp.Name) then
