local lastScan=0; local cachedRemotes={}

local function getRemotes()
    if tick()-lastScan<0.25 then
        local v={}; for _,r in ipairs(cachedRemotes) do if r and r.Parent then table.insert(v,r) end end; return v
    end
    lastScan=tick(); table.clear(propsCache)
    local com=workspace:FindFirstChild("WorkspaceCom")
    if com then
        for _,f in ipairs(com:GetChildren()) do
            for _,c in ipairs(f:GetChildren()) do
                if c.Name=="Prop"..lp.Name then table.insert(propsCache,c) end
            end
        end
    end
    local r={}
    for _,p in ipairs(propsCache) do
        local re=p:FindFirstChild("SetCurrentCFrame")
        if re and re.Parent then table.insert(r,re) end
    end
    cachedRemotes=r; return r
end

local function isAssigned(remote)
    for _,a in pairs(assignedRemotes) do
        if type(a)=="table" then for _,sr in pairs(a) do if sr==remote then return true end end
        elseif a==remote then return true end
    end
    return false
end

local function dispatch(remote, cf)
    if not remote or not remote.Parent then return end
    pcall(function()
        local p=remote.Parent
        if p:IsA("Model") then
            local pt=p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart")
            if pt then pt.CFrame=pt.CFrame:Lerp(cf,0.6) end
        elseif p:IsA("BasePart") then p.CFrame=p.CFrame:Lerp(cf,0.6) end
    end)
    task.spawn(function() pcall(function() remote:InvokeServer(cf) end) end)
end

