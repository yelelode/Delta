    knob.BackgroundColor3 = Colors.Text
    knob.ZIndex = 11
    
    local knobCorner = Instance.new("UICorner", knob)
    knobCorner.CornerRadius = UDim.new(1,0)
    
    local knobDot = Instance.new("Frame", knob)
    knobDot.Size = UDim2.new(0, 6, 0, 6)
    knobDot.AnchorPoint = Vector2.new(0.5, 0.5)
    knobDot.Position = UDim2.fromScale(0.5, 0.5)
    knobDot.BackgroundColor3 = Colors.Primary
    knobDot.BorderSizePixel = 0
    knobDot.ZIndex = 12
    
    local dotCorner = Instance.new("UICorner", knobDot)
    dotCorner.CornerRadius = UDim.new(1,0)
    
    local knobStroke = Instance.new("UIStroke", knob)
    knobStroke.Color = Colors.Primary
    knobStroke.Transparency = 0.8
    knobStroke.Thickness = 2

    local value = defaultVal
    local dragging = false
    
    local function update(input) 
        local rawPos = input.Position.X
        local relativeX = math.clamp(rawPos - bg.AbsolutePosition.X, 0, bg.AbsoluteSize.X)
        local pos = relativeX / bg.AbsoluteSize.X
        
        local tInfo = TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        TweenService:Create(fill, tInfo, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        
        value = math.floor(min + (pos * (max - min)))
        valLabel.Text = value .. (suffix or "")
    end
    
    hitbox.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = true
            uiHoverCount = uiHoverCount + 1
            
            local tInfo1 = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            local tInfo2 = TweenInfo.new(0.3, Enum.EasingStyle.Quart)
            
            TweenService:Create(knob, tInfo1, {Size = UDim2.new(0, 18, 0, 18)}):Play()
            TweenService:Create(knobDot, tInfo2, {Size = UDim2.new(0, 8, 0, 8)}):Play()
            TweenService:Create(knobStroke, tInfo2, {Transparency = 0.1, Thickness = 4}):Play()
            TweenService:Create(valBadge, tInfo2, {BackgroundTransparency = 0.2}):Play()
            TweenService:Create(valStroke, tInfo2, {Transparency = 0}):Play()
            
            TweenService:Create(fill, tInfo2, {BackgroundColor3 = Color3.fromRGB(150, 255, 240)}):Play()
            update(input) 
        end 
    end)
    
    hitbox.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false
            uiHoverCount = math.max(0, uiHoverCount - 1)
            
            local tInfo1 = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
            local tInfo2 = TweenInfo.new(0.4, Enum.EasingStyle.Quart)
            
            TweenService:Create(knob, tInfo1, {Size = UDim2.new(0, 14, 0, 14)}):Play()
            TweenService:Create(knobDot, tInfo2, {Size = UDim2.new(0, 6, 0, 6)}):Play()
            TweenService:Create(knobStroke, tInfo2, {Transparency = 0.8, Thickness = 2}):Play()
            TweenService:Create(valBadge, tInfo2, {BackgroundTransparency = 0.85}):Play()
            TweenService:Create(valStroke, tInfo2, {Transparency = 0.5}):Play()
            
            TweenService:Create(fill, tInfo2, {BackgroundColor3 = Colors.PrimaryDark}):Play()
        end 
    end)
    
    UserInputService.InputChanged:Connect(function(input) 
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
            update(input) 
        end 
    end)
    
    return function() 
        return value 
    end
end

