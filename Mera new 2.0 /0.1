local function PlayMusic()
    local soundId = "134489447055645"
    local RE = ReplicatedStorage:WaitForChild("RE")
    pcall(function()
        local sv = RE:FindFirstChild("1NoMoto1rVehicle1s")
        if sv then sv:FireServer("SegwaySmall"); task.wait(0.3) end
        for _, r in ipairs(RE:GetChildren()) do
            if r:IsA("RemoteEvent") then
                pcall(function()
                    r:FireServer("PickingScooterMusicText", soundId, true)
                    r:FireServer("ToolMusicText", soundId, true)
                    r:FireServer("Music", soundId, true)
                end)
            end
        end
    end)
    notif("⚡ TXR SOUND", "Audio Core Injected!", 2)
end

local function StopMusic()
    local RE = ReplicatedStorage:WaitForChild("RE")
    pcall(function()
        if lp.Character then
            local h = lp.Character:FindFirstChildOfClass("Humanoid")
            if h then h.Sit = false; h.Jump = true end
            for _, v in ipairs(lp.Character:GetDescendants()) do
                if v.Name == "SeatWeld" or (v:IsA("Weld") and v.Part1 and string.match(v.Part1.Name,"Seat")) then
                    pcall(function() v:Destroy() end)
                end
            end
        end
        task.wait(0.25)
        for _, r in ipairs(RE:GetChildren()) do
            if r:IsA("RemoteEvent") then
                pcall(function()
                    r:FireServer("PickingScooterMusicText","0",true)
                    r:FireServer("ToolMusicText","0",true)
                    r:FireServer("Music","0",true)
                end)
            end
        end
        local dv = RE:FindFirstChild("1DeSpawnVehi1cle")
        if dv then pcall(function() dv:FireServer() end) end
        task.spawn(function()
            local vf = workspace:FindFirstChild("Vehicles")
            if vf then
                for _, v in ipairs(vf:GetChildren()) do
                    if string.find(string.lower(v.Name),"segway") then pcall(function() v:Destroy() end) end
                end
            end
        end)
    end)
end

local function clearProps() pcall(function() ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("ClearAllProps") end); task.wait(0.35) end
local function spawnProp(n,c) pcall(function() ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer("RequestingPropName",n,c) end) end
local function getActiveProp()
    if activeModes["Chair"] and not (activeModes["Robot"] or activeModes["MultiRobot"] or activeModes["Orbit"] or activeModes["Ring"] or activeModes["HeadBang"]) then
        return "FurnitureBleachers","Furniture"
    end
    return customPropName, customPropCategory
end

