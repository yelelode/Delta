local function createSlider(name, min, max, defaultVal, suffix)
    local container = Instance.new("Frame", mainList)
    container.Size = UDim2.new(1, 0, 0, 46)
    container.BackgroundTransparency = 1
    container.LayoutOrder = getOrder()
    container.ZIndex = 7
    
    local titleLabel = Instance.new("TextLabel", container)
    titleLabel.Size = UDim2.new(0.6, 0, 0, 14)
    titleLabel.Position = UDim2.new(0, 6, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = name
    titleLabel.TextColor3 = Colors.SubText
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 10
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 8
    crispText(titleLabel)

    local valBadge = Instance.new("Frame", container)
    valBadge.Size = UDim2.new(0, 48, 0, 16)
    valBadge.AnchorPoint = Vector2.new(1, 0)
    valBadge.Position = UDim2.new(1, -6, 0, -1)
    valBadge.BackgroundColor3 = Colors.Primary
    valBadge.BackgroundTransparency = 0.85
    valBadge.ZIndex = 8
    
    local badgeCorner = Instance.new("UICorner", valBadge)
    badgeCorner.CornerRadius = UDim.new(0, 4)
    
    local valStroke = Instance.new("UIStroke", valBadge)
    valStroke.Color = Colors.Primary
    valStroke.Transparency = 0.5
    valStroke.Thickness = 1
    
    local valLabel = Instance.new("TextLabel", valBadge)
    valLabel.Size = UDim2.new(1, 0, 1, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = defaultVal .. (suffix or "")
    valLabel.TextColor3 = Colors.Primary
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextSize = 10
    valLabel.ZIndex = 9
    crispText(valLabel)

    local bg = Instance.new("Frame", container)
    bg.Size = UDim2.new(1, -20, 0, 4)
    bg.Position = UDim2.new(0, 10, 0, 26)
    bg.BackgroundColor3 = Colors.SurfaceHover
    bg.ZIndex = 8
    
    local bgCorner = Instance.new("UICorner", bg)
    bgCorner.CornerRadius = UDim.new(1, 0)
    
    local hitbox = Instance.new("TextButton", container)
    hitbox.Size = UDim2.new(1, 0, 0, 30)
    hitbox.Position = UDim2.new(0, 0, 0, 13)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = 15
    
    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Colors.PrimaryDark
    fill.ZIndex = 9
    
    local fillCorner = Instance.new("UICorner", fill)
    fillCorner.CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", fill)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(1, 0, 0.5, 0)
    knob.BackgroundColor3 = Colors.Text
    knob.ZIndex = 11
    
    local knobCorner = Instance.new("UICorner", knob)
    knobCorner.CornerRadius = UDim.new(1,0)
    
    local knobDot = Instance.new("Frame", knob)
    knobDot.Size = UDim2.new(0, 6, 0, 6)
    knobDot.AnchorPoint = Vector2.new(0.5, 0.5)
    knobDot.Position = UDim2.fromScale(0.5, 0.5)
    knobDot.BackgroundColor3 = Colors.Primary
    knobDot.BorderSizePixel = 0
    knobDot.ZIndex = 12
    
    local dotCorner = Instance.new("UICorner", knobDot)
    dotCorner.CornerRadius = UDim.new(1,0)
    
    local knobStroke = Instance.new("UIStroke", knob)
    knobStroke.Color = Colors.Primary
    knobStroke.Transparency = 0.8
    knobStroke.Thickness = 2

    local value = defaultVal
    local dragging = false
    
    local function update(input) 
        local rawPos = input.Position.X
        local relativeX = math.clamp(rawPos - bg.AbsolutePosition.X, 0, bg.AbsoluteSize.X)
        local pos = relativeX / bg.AbsoluteSize.X
        
        local tInfo = TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        TweenService:Create(fill, tInfo, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        
        value = math.floor(min + (pos * (max - min)))
        valLabel.Text = value .. (suffix or "")
    end
    
    hitbox.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = true
            uiHoverCount = uiHoverCount + 1
            
            local tInfo1 = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            local tInfo2 = TweenInfo.new(0.3, Enum.EasingStyle.Quart)
            
            TweenService:Create(knob, tInfo1, {Size = UDim2.new(0, 18, 0, 18)}):Play()
            TweenService:Create(knobDot, tInfo2, {Size = UDim2.new(0, 8, 0, 8)}):Play()
            TweenService:Create(knobStroke, tInfo2, {Transparency = 0.1, Thickness = 4}):Play()
            TweenService:Create(valBadge, tInfo2, {BackgroundTransparency = 0.2}):Play()
            TweenService:Create(valStroke, tInfo2, {Transparency = 0}):Play()
            
            TweenService:Create(fill, tInfo2, {BackgroundColor3 = Color3.fromRGB(150, 255, 240)}):Play()
            update(input) 
        end 
    end)
    
    hitbox.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false
            uiHoverCount = math.max(0, uiHoverCount - 1)
            
            local tInfo1 = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
            local tInfo2 = TweenInfo.new(0.4, Enum.EasingStyle.Quart)
            
            TweenService:Create(knob, tInfo1, {Size = UDim2.new(0, 14, 0, 14)}):Play()
            TweenService:Create(knobDot, tInfo2, {Size = UDim2.new(0, 6, 0, 6)}):Play()
            TweenService:Create(knobStroke, tInfo2, {Transparency = 0.8, Thickness = 2}):Play()
            TweenService:Create(valBadge, tInfo2, {BackgroundTransparency = 0.85}):Play()
            TweenService:Create(valStroke, tInfo2, {Transparency = 0.5}):Play()
            
            TweenService:Create(fill, tInfo2, {BackgroundColor3 = Colors.PrimaryDark}):Play()
        end 
    end)
    
    UserInputService.InputChanged:Connect(function(input) 
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
            update(input) 
        end 
    end)
    
    return function() 
        return value 
    end
end

