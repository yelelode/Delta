                end
            end
        end
        
        -- 2. Scan WorkspaceCom for fast teleporting & slow creeping props
        if not found then
            local com = workspace:FindFirstChild("WorkspaceCom")
            if com then
                for _, folder in ipairs(com:GetChildren()) do
                    if folder.Name ~= "Prop" .. lp.Name then
                        for _, c in ipairs(folder:GetChildren()) do
                            if hrp and (c:IsA("BasePart") or c:IsA("Model")) then
                                local cPos = c:IsA("BasePart") and c.Position or (c.PrimaryPart and c.PrimaryPart.Position)
                                if cPos and (cPos - hrp.Position).Magnitude < 50 then
                                    found = true
                                    break
                                end
                            end
                        end
                    end
                    if found then break end
                end
            end
        end
        
        -- 3. Scan our house boundary area
        if not found and houseData and houseData.Lot then
            local housePos = houseData.Lot.WorldPivot.Position
            for _, obj in ipairs(workspace:GetPartBoundsInBox(CFrame.new(housePos), Vector3.new(120, 80, 120))) do
