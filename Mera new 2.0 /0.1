                    if pt and r then
                        task.spawn(function() pcall(function() r:InvokeServer(CFrame.new(pt.Position.X, 15000, pt.Position.Z)) end) end)
                    end
                end
            end
        end
    end
    
    task.wait(0.2) -- Give the server 200ms to register our props are safe in the sky
    
    if hrp and houseData then
        local safePos = houseData.Lot.WorldPivot.Position + Vector3.new(0, 3, 0)
        hrp.CFrame = CFrame.new(safePos)
        
        if houseData.Remote then
            task.spawn(function() pcall(function() houseData.Remote:InvokeServer() end) end)
        end
        
        task.wait(0.1) -- slightly longer to ensure clear happens
        hrp.CFrame = originalPos -- True location restoration
        sendNotif("🚀 BOOM!", "Evaded & Wiped Attackers!", 2)
    else
        sendNotif("⚠️ ALERT", "House Not Found! Deploying Global Wipe...", 2)
    end

    -- 💥 UNIVERSAL MAP WIPE (Only clear OTHER houses)
    task.spawn(function()
        local myHouseData = getMyHouse()
