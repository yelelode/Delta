local function syncComboUI()
    for key, data in pairs(modeBtns) do
        local btn = data.btn
        local accent = btn:FindFirstChild("Accent")
        local tInfo1 = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        local tInfo2 = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        if activeModes[key] then 
            TweenService:Create(btn, tInfo1, {BackgroundColor3 = Colors.ActiveTint, TextColor3 = Colors.Primary}):Play()
            if accent then 
                TweenService:Create(accent, tInfo2, {Size = UDim2.new(0, 4, 0.7, 0)}):Play() 
            end
        else 
            TweenService:Create(btn, tInfo1, {BackgroundColor3 = Colors.Surface, TextColor3 = Colors.Text}):Play()
            if accent then 
                TweenService:Create(accent, tInfo1, {Size = UDim2.new(0, 0, 0, 0)}):Play() 
            end
        end
    end
end

for key, data in pairs(modeBtns) do
    data.btn.MouseButton1Click:Connect(function()
        activeModes[key] = not activeModes[key]
        syncComboUI()
        sendNotif("⚙️ ENGINE MODE", key .. " mode " .. (activeModes[key] and "Activated" or "Deactivated"), 2)
    end)
end

