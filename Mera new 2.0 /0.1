local function getMyHouse()
    local lotsFolder = workspace:FindFirstChild("001_Lots")
    if lotsFolder then
        for _, lot in ipairs(lotsFolder:GetChildren()) do
            if string.find(string.lower(lot.Name), string.lower(lp.Name)) then
                local picked = lot:FindFirstChild("HousePickedByPlayer")
                if picked then
                    local houseModel = picked:FindFirstChild("HouseModel")
                    if houseModel then
                        local clearRemote = houseModel:FindFirstChild("Permissions:ClearProps", true)
                        local disallowRemote = houseModel:FindFirstChild("Permissions:Disallow", true)
                        local allowRemote = houseModel:FindFirstChild("Permissions:Allow", true)
                        if clearRemote and clearRemote:IsA("RemoteFunction") then
                            return {Lot = lot, Remote = clearRemote, Disallow = disallowRemote, Allow = allowRemote, Type = "Normal"}
                        end
                    end
                end
            end
        end
    end
    
    for _, desc in ipairs(workspace:GetChildren()) do
        if desc.Name == "001_Lots" or desc.Name == "Lots" then
            for _, lot in ipairs(desc:GetChildren()) do
                local picked = lot:FindFirstChild("HousePickedByPlayer")
                if picked and (tostring(picked.Value) == lp.Name or picked.Value == lp) then
                    local clearRemote = lot:FindFirstChild("Permissions:ClearProps", true)
                    local disallowRemote = lot:FindFirstChild("Permissions:Disallow", true)
                    local allowRemote = lot:FindFirstChild("Permissions:Allow", true)
                    if clearRemote and clearRemote:IsA("RemoteFunction") then
                        return {Lot = lot, Remote = clearRemote, Disallow = disallowRemote, Allow = allowRemote, Type = "Apartment"}
                    end
                end
            end
        end
    end
    
    return nil
end

