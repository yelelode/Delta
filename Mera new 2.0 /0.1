                        maxWait = maxWait + 0.05
                        local propsFollowed = false
                        local checkParts = workspace:GetPartBoundsInRadius(hrp.Position, 40)
                        for _, obj in ipairs(checkParts) do
                            if string.sub(obj.Name, 1, 4) == "Prop" then
                                local ownerName = string.sub(obj.Name, 5)
                                if ownerName ~= "" and ownerName ~= lp.Name then
                                    propsFollowed = true
                                    break
                                end
                            end
                        end
                        if propsFollowed then break end
                    end
                end
                
                if houseData.Remote then
                    for i = 1, 20 do
