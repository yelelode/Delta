local lastRemoteScan = 0
local cachedRemotes = {}

local function getAvailableRemotes()
    if tick() - lastRemoteScan < 0.25 then
        local valid = {}
        for _, r in ipairs(cachedRemotes) do
            if r and r.Parent then 
                table.insert(valid, r) 
            end
        end
        return valid
    end
    
    lastRemoteScan = tick()
    table.clear(propsCache)
    
    local com = workspace:FindFirstChild("WorkspaceCom")
    if com then 
        for _, f in ipairs(com:GetChildren()) do 
            for _, c in ipairs(f:GetChildren()) do 
                if c.Name == "Prop" .. lp.Name then 
                    table.insert(propsCache, c) 
                end 
            end 
        end 
    end
    
    local remotes = {}
    for _, p in ipairs(propsCache) do 
        local r = p:FindFirstChild("SetCurrentCFrame")
        if r and r.Parent then 
            table.insert(remotes, r) 
        end 
    end 
    
    cachedRemotes = remotes
    return remotes
end

local function isRemoteAssigned(remote) 
    for _, assigned in pairs(assignedRemotes) do 
        if type(assigned) == "table" then 
            for _, sr in pairs(assigned) do 
                if sr == remote then 
                    return true 
                end 
            end 
        elseif assigned == remote then 
            return true 
        end 
    end 
    return false 
end

local lastRemoteFireTimes = {}
local FIRE_INTERVAL = 0.035 

local function dispatchRemote(remote, targetCFrame)
    if not remote or not remote.Parent then return end
    
    local isEmergency = false
    if activeModes["HouseProt"] then
        local checkPos = targetCFrame.Position
        local params = OverlapParams.new()
        local ignoreList = {lp.Character}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(ignoreList, p.Character) end
        end
        if workspace:FindFirstChild("Vehicles") then table.insert(ignoreList, workspace.Vehicles) end
        if workspace:FindFirstChild("WorkspaceCom") then table.insert(ignoreList, workspace.WorkspaceCom) end
        params.FilterDescendantsInstances = ignoreList
        params.FilterType = Enum.RaycastFilterType.Exclude
        
        local inDangerZone = false
        local partsInBubble = workspace:GetPartBoundsInBox(CFrame.new(checkPos), Vector3.new(6, 100000, 6), params)
        for _, hitInst in ipairs(partsInBubble) do
            local currentInst = hitInst
            local bName = string.lower(hitInst.Name)
            local isSafe = string.find(bName, "plot") or string.find(bName, "road") or string.find(bName, "driveway")
            while currentInst and currentInst ~= workspace do
                local lowerName = string.lower(currentInst.Name)
                if currentInst.Name == "AsliBanZone_TXR" or string.find(lowerName, "ban") or string.find(lowerName, "pool") or (string.find(lowerName, "house") and not isSafe) then
                    inDangerZone = true
                    break
                end
                currentInst = currentInst.Parent
            end
            if inDangerZone then break end
        end

        if inDangerZone then
            targetCFrame = CFrame.new(120, -350, 150)
            isEmergency = true
        end
    end

    if not isEmergency then
        isEmergency = targetCFrame.Y < -100 or targetCFrame.Y > 10000
    end

    pcall(function() 
        local parent = remote.Parent
        if parent:IsA("Model") then 
            local part = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
            if part then 
                if isEmergency or (part.Position - targetCFrame.Position).Magnitude > 50 then
                    part.CFrame = targetCFrame 
                else
                    part.CFrame = part.CFrame:Lerp(targetCFrame, 0.75) 
                end
            end 
        elseif parent:IsA("BasePart") then 
            if isEmergency or (parent.Position - targetCFrame.Position).Magnitude > 50 then
                parent.CFrame = targetCFrame
            else
                parent.CFrame = parent.CFrame:Lerp(targetCFrame, 0.75) 
            end
        end 
    end)
    
    local now = tick()
    if isEmergency or not lastRemoteFireTimes[remote] or (now - lastRemoteFireTimes[remote]) >= FIRE_INTERVAL then
        lastRemoteFireTimes[remote] = now
        task.spawn(function() 
            pcall(function() remote:InvokeServer(targetCFrame) end) 
        end)
    end
end

