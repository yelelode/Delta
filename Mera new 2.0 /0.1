local function makeHdrBtn(txt, xOff, col)
    local b = Instance.new("TextButton", hdr)
    b.Size = UDim2.fromOffset(28,28)
    b.Position = UDim2.new(1,xOff,0.5,-14)
    b.BackgroundColor3 = C.Surface
    b.BackgroundTransparency = 0.35
    b.Text = txt; b.TextColor3 = col
    b.Font = Enum.Font.GothamBold; b.TextSize = 15
    b.AutoButtonColor = false; b.ZIndex = 14
    corner(b, 8)
    local sc = Instance.new("UIScale", b); sc.Scale = 1
    b.MouseEnter:Connect(function() tween(sc,0.25,{Scale=1.1},Enum.EasingStyle.Back):Play(); tween(b,0.25,{BackgroundTransparency=0.1}):Play() end)
    b.MouseLeave:Connect(function() tween(sc,0.3,{Scale=1},Enum.EasingStyle.Quart):Play(); tween(b,0.3,{BackgroundTransparency=0.35}):Play() end)
    b.MouseButton1Down:Connect(function() tween(sc,0.1,{Scale=0.88}):Play() end)
    b.MouseButton1Up:Connect(function() tween(sc,0.4,{Scale=1.05},Enum.EasingStyle.Back):Play() end)
    return b
end
