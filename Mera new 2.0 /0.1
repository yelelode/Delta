local function makeSlider(name, mn, mx, def, suf)
    local c = Instance.new("Frame", scroll)
    c.Size=UDim2.new(1,0,0,52); c.BackgroundTransparency=1; c.LayoutOrder=ord(); c.ZIndex=8

    local tl=Instance.new("TextLabel",c)
    tl.Size=UDim2.new(0.65,0,0,14); tl.Position=UDim2.new(0,6,0,2)
    tl.BackgroundTransparency=1; tl.Text=name; tl.TextColor3=C.Sub
    tl.Font=Enum.Font.GothamBold; tl.TextSize=10; tl.TextXAlignment=Enum.TextXAlignment.Left; tl.ZIndex=9
    crisp(tl)

    local vb=Instance.new("Frame",c)
    vb.Size=UDim2.new(0,54,0,19); vb.AnchorPoint=Vector2.new(1,0); vb.Position=UDim2.new(1,-4,0,-2)
    vb.BackgroundColor3=C.Teal; vb.BackgroundTransparency=0.82; vb.ZIndex=9
    corner(vb,5); local vs=stroke(vb,C.Teal,1,0.45)
    local vl=Instance.new("TextLabel",vb)
    vl.Size=UDim2.fromScale(1,1); vl.BackgroundTransparency=1
    vl.Text=def..(suf or ""); vl.TextColor3=C.TealBright
    vl.Font=Enum.Font.GothamBold; vl.TextSize=10; vl.ZIndex=10
    crisp(vl)

    local track=Instance.new("TextButton",c)
    track.Size=UDim2.new(1,-18,0,5); track.Position=UDim2.new(0,9,0,30)
    track.BackgroundColor3=C.SurfaceHov; track.Text=""; track.AutoButtonColor=false; track.ZIndex=9
    corner(track,3)

    local fill=Instance.new("Frame",track)
    fill.Size=UDim2.new((def-mn)/(mx-mn),0,1,0)
    fill.BackgroundColor3=Color3.new(1,1,1); fill.ZIndex=10
    corner(fill,3)
    local fg=Instance.new("UIGradient",fill)
    fg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,C.TealDim),
        ColorSequenceKeypoint.new(0.5,C.Teal),
        ColorSequenceKeypoint.new(1,C.Ice),
    })

    local knob=Instance.new("Frame",fill)
    knob.Size=UDim2.fromOffset(14,14); knob.AnchorPoint=Vector2.new(0.5,0.5); knob.Position=UDim2.new(1,0,0.5,0)
    knob.BackgroundColor3=C.White; knob.ZIndex=12; corner(knob,7)
    glow(knob,C.Teal,0.55,2.8,11)
    local ks=stroke(knob,C.Teal,2,0.65)
    local kd=Instance.new("Frame",knob)
    kd.Size=UDim2.fromOffset(6,6); kd.AnchorPoint=Vector2.new(0.5,0.5); kd.Position=UDim2.fromScale(0.5,0.5)
    kd.BackgroundColor3=C.Teal; kd.BorderSizePixel=0; kd.ZIndex=13; corner(kd,3)

    local val=def; local drag=false
    local function upd(i)
        local p=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        tween(fill,0.07,{Size=UDim2.new(p,0,1,0)}):Play()
        val=math.floor(mn+(p*(mx-mn))); vl.Text=val..(suf or "")
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true
            tween(knob,0.35,{Size=UDim2.fromOffset(18,18)},Enum.EasingStyle.Back):Play()
            tween(ks,0.3,{Transparency=0.1,Thickness=3}):Play()
            tween(vb,0.3,{BackgroundTransparency=0.5}):Play()
            upd(i)
        end
    end)
    track.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=false
            tween(knob,0.45,{Size=UDim2.fromOffset(14,14)},Enum.EasingStyle.Exponential):Play()
            tween(ks,0.4,{Transparency=0.65,Thickness=2}):Play()
            tween(vb,0.4,{BackgroundTransparency=0.82}):Play()
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i) end
    end)
    return function() return val end
end

