local function animateWaterfall(container)
    local currentID = (container:GetAttribute("WaterfallID") or 0) + 1
    container:SetAttribute("WaterfallID", currentID)
    
    task.spawn(function()
        local items = {}
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                table.insert(items, child)
                local scale = child:FindFirstChildOfClass("UIScale")
                if not scale then
                    scale = Instance.new("UIScale", child)
                end
                scale.Scale = 0
            end
        end
        
        table.sort(items, function(a, b) 
            return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) 
        end)

        for _, child in ipairs(container:GetAttribute("WaterfallID") ~= currentID and {} or items) do
            local scale = child:FindFirstChildOfClass("UIScale")
            if scale then
                TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                task.wait(0.03)
            end
        end
    end)
end

