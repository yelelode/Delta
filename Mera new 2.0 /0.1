-- 🚀 SMART PROP-BANG REMOVER (F5 KEYBIND & PIGGYBACK SAFE) 🚀
-- =========================================================
local isSmartClearing = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if _G.TXR_InstanceID ~= currentExecutionID then return end
    if not gameProcessed and input.KeyCode == Enum.KeyCode.F5 and not isSmartClearing then
        isSmartClearing = true
        
        task.spawn(function()
            local success, err = pcall(function()
                local houseData = getMyHouse()
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                
                if hrp and houseData then
                    local originalPos = hrp.CFrame
                    local safePos = houseData.Lot.WorldPivot.Position + Vector3.new(0, 3, 0)
                    
                    local attackersToBan = {}
                    local protectedVictims = {}

                    for _, desc in ipairs(lp.Character:GetDescendants()) do
                        if desc:IsA("Weld") or desc:IsA("Motor6D") or desc:IsA("WeldConstraint") then
                            local p0, p1 = desc.Part0, desc.Part1
                            local otherPart = (p0 and not p0:IsDescendantOf(lp.Character) and p0) or (p1 and not p1:IsDescendantOf(lp.Character) and p1)
                            if otherPart then
                                local model = otherPart:FindFirstAncestorOfClass("Model")
                                if model and model ~= lp.Character then
                                    local vicPlayer = Players:GetPlayerFromCharacter(model)
                                    if vicPlayer then
                                        protectedVictims[vicPlayer] = true
                                        protectedVictims[model] = true
                                    end
                                end
                            end
                        end
                    end

                    local boundParts = workspace:GetPartBoundsInRadius(hrp.Position, 40)
                    for _, obj in ipairs(boundParts) do
                        if string.sub(obj.Name, 1, 4) == "Prop" then
                            local ownerName = string.sub(obj.Name, 5)
                            if ownerName ~= "" and ownerName ~= lp.Name then
                                local p = Players:FindFirstChild(ownerName)
                                if p and not protectedVictims[p] then 
                                    attackersToBan[p] = true 
                                end
                            end
                        end
                        local pModel = obj:FindFirstAncestorOfClass("Model")
                        if pModel and pModel ~= lp.Character and not protectedVictims[pModel] then
                            local p = Players:GetPlayerFromCharacter(pModel)
                            if p and not protectedVictims[p] then 
                                attackersToBan[p] = true 
                            end
                        end
                    end

                    for _, desc in ipairs(lp.Character:GetDescendants()) do
                        if desc:IsA("Weld") or desc:IsA("SeatWeld") then
                            local safeParts = {}
                            if desc.Part0 then table.insert(safeParts, desc.Part0) end
                            if desc.Part1 then table.insert(safeParts, desc.Part1) end
                            
                            for _, pt in ipairs(safeParts) do
                                if not pt:IsDescendantOf(lp.Character) then
                                    if string.sub(pt.Name, 1, 4) == "Prop" then
                                        local ownerName = string.sub(pt.Name, 5)
                                        if ownerName ~= "" and ownerName ~= lp.Name then
                                            local p = Players:FindFirstChild(ownerName)
                                            if p and not protectedVictims[p] then 
                                                attackersToBan[p] = true 
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    rawhrp = hrp
                    hrp.CFrame = CFrame.new(safePos)
                    
                    local isCleared = false
                    local safetyCounter = 0
                    
                    while not isCleared and safetyCounter < 70 do
                        task.wait(0.01) 
                        safetyCounter = safetyCounter + 1
                        
                        local foundProp = false
                        local com = workspace:FindFirstChild("WorkspaceCom")
                        if com then
                            for _, f in ipairs(com:GetChildren()) do
                                for _, c in ipairs(f:GetChildren()) do
                                    if string.sub(c.Name, 1, 4) == "Prop" and string.sub(c.Name, 5) ~= lp.Name then
                                        local pt = c:FindFirstChildWhichIsA("BasePart") or c.PrimaryPart
                                        if pt and (pt.Position - rawhrp.Position).Magnitude < 25 then
                                            local ownerName = string.sub(c.Name, 5)
                                            local p = Players:FindFirstChild(ownerName)
                                            if p and not protectedVictims[p] then 
                                                attackersToBan[p] = true 
                                            end
                                            foundProp = true
                                            break
                                        end
                                    end
                                end
                                if foundProp then break end
                            end
                        end

                        if not foundProp then
                            isCleared = true
                        end
                    end
                    
                    if houseData.Disallow then
                        for attacker, _ in pairs(attackersToBan) do
                            if attacker and attacker.Parent and not protectedVictims[attacker] then
                                task.spawn(function() pcall(function() houseData.Disallow:FireServer(attacker) end) end)
                            end
                        end
                    end

                    if houseData.Remote then
                        for i = 1, 20 do
                            task.spawn(function() pcall(function() houseData.Remote:InvokeServer() end) end)
                            task.wait(0.01)
                        end
                    end

                    hrp.CFrame = originalPos
                    
                    if houseData.Allow then
                        for attacker, _ in pairs(attackersToBan) do
                            if attacker and attacker.Parent and not protectedVictims[attacker] then
                                task.spawn(function()
                                    task.wait(0.5)
                                    pcall(function() houseData.Allow:FireServer(attacker) end)
                                end)
                            end
                        end
                    end

                    sendNotif("SMART CLEAR", "Bang Props Banned & Cleared!", 2)
                else
                    if not houseData then
                        sendNotif("⚠️ HOUSE REQUIRED", "Spawn House First! Pehle apna house spawn karein.", 3)
                    end
                end
            end)
            
            if not success then warn("TXR Error:", err) end
            isSmartClearing = false
        end)
    end
end)
