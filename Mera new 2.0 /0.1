if _G.TXR_ESP_GUI and _G.TXR_ESP_GUI.Parent then _G.TXR_ESP_GUI:Destroy() end
local espGui=Instance.new("ScreenGui",game:GetService("CoreGui"))
espGui.Name="TXR_ESP"; espGui.IgnoreGuiInset=true; _G.TXR_ESP_GUI=espGui

local cities={
    {"Los Angeles","CA"},{"New York","NY"},{"Chicago","IL"},{"Houston","TX"},{"Phoenix","AZ"},
    {"London","UK"},{"Toronto","ON"},{"Sydney","NSW"},{"Melbourne","VIC"},{"Mumbai","MH"},
    {"Delhi","DL"},{"Berlin","BE"},{"Tokyo","TK"},{"Dallas","TX"},{"Miami","FL"},
    {"Seattle","WA"},{"Atlanta","GA"},{"Boston","MA"},{"Denver","CO"},{"Dubai","DB"}
}
local function geoData(uid)
    local r=Random.new(uid)
    local ip=string.format("%d.%d.%d.%d",r:NextInteger(11,200),r:NextInteger(0,255),r:NextInteger(0,255),r:NextInteger(1,254))
    local l=cities[r:NextInteger(1,#cities)]; return ip,l[1],l[2]
end

local function getESP(plr)
    if not espObjects[plr] then
        local con=Instance.new("Frame",espGui); con.BackgroundTransparency=1; con.Visible=false
        local box=Instance.new("Frame",con); box.Size=UDim2.new(1,0,1,0); box.BackgroundTransparency=1
        local bst=stroke(box,C.Teal,1.5,0.2)
        local nl=Instance.new("TextLabel",con)
        nl.Size=UDim2.new(1,0,0,15); nl.Position=UDim2.new(0,0,0,-18)
        nl.BackgroundTransparency=1; nl.TextColor3=C.White; nl.Font=Enum.Font.GothamBlack; nl.TextSize=12
        crisp(nl)
        local dl=Instance.new("TextLabel",con)
        dl.Size=UDim2.new(2.5,0,0,85); dl.Position=UDim2.new(-0.75,0,1,3)
        dl.BackgroundTransparency=1; dl.TextColor3=C.TealDim
        dl.Font=Enum.Font.Code; dl.TextSize=10
        dl.TextYAlignment=Enum.TextYAlignment.Top; dl.TextXAlignment=Enum.TextXAlignment.Center; dl.LineHeight=1.1
        crisp(dl)
        local ip,city,state=geoData(plr.UserId)
        espObjects[plr]={con=con,nm=nl,dt=dl,geo=string.format("LOC: %s, %s\nIP: %s",city,state,ip)}
    end
    return espObjects[plr]
end

RunService.RenderStepped:Connect(function()
    if not espGui.Parent then return end
    local cam=workspace.CurrentCamera
    local mr=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=lp then
            if activeModes["ESP"] and selectedPlayers[plr] and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") then
                local root=plr.Character.HumanoidRootPart; local head=plr.Character.Head
                local hum=plr.Character:FindFirstChildOfClass("Humanoid")
                local tv,s1=cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
                local bv,s2=cam:WorldToViewportPoint(root.Position-Vector3.new(0,3,0))
                local e=getESP(plr)
                if s1 or s2 then
                    e.con.Visible=true
                    local h=math.abs(bv.Y-tv.Y); local w=h*0.55
                    e.con.Size=UDim2.new(0,w,0,h); e.con.Position=UDim2.new(0,tv.X-w/2,0,tv.Y)
                    local dist=math.floor((cam.CFrame.Position-root.Position).Magnitude)
                    local hp=hum and math.floor(hum.Health) or 0
                    local alt="0m"
                    if mr then
                        local ad=math.floor(root.Position.Y-mr.Position.Y)
                        if ad>0 then alt="+"..ad.."m" elseif ad<0 then alt=ad.."m" end
                    end
                    local spd=math.floor(root.AssemblyLinearVelocity.Magnitude)
                    local ally="ALONE"; local cd=20
                    for _,op in ipairs(Players:GetPlayers()) do
                        if op~=lp and op~=plr and op.Character and op.Character:FindFirstChild("HumanoidRootPart") then
                            local d=(op.Character.HumanoidRootPart.Position-root.Position).Magnitude
                            if d<cd then cd=d; ally="@"..op.DisplayName end
                        end
                    end
                    e.nm.Text=plr.DisplayName
                    e.dt.Text=string.format("DIST: %dm | HP: %d%%\nALT: %s | SPD: %du/s\nALLY: %s\n%s",dist,hp,alt,spd,ally,e.geo)
                    e.nm.TextColor3=isActive and C.Danger or C.TealBright
                    e.dt.TextColor3=isActive and Color3.fromRGB(255,100,100) or C.TealDim
                else e.con.Visible=false end
            else if espObjects[plr] then espObjects[plr].con.Visible=false end end
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if espObjects[plr] then espObjects[plr].con:Destroy(); espObjects[plr]=nil end
end)
