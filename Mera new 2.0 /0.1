local function isPlayerSeated(plr)
    if not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then return true end
    for _, desc in ipairs(plr.Character:GetDescendants()) do
        if desc:IsA("Seat") or desc:IsA("VehicleSeat") or desc.Name == "SeatWeld" then
            return true
        end
    end
    return false
end

RunService.Heartbeat:Connect(function(dt)
    if _G.TXR_InstanceID ~= currentExecutionID then return end 
    if not gui or not gui.Parent then 
        isSystemActive = false 
        task.spawn(StopRobotBangMusic)
        return 
    end
    if not isSystemActive then return end 

    for plr in pairs(assignedRemotes) do
        if not selectedPlayers[plr] or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            assignedRemotes[plr] = nil 
            targetVelocities[plr] = nil
        end
    end
    
    for plr in pairs(voidedPlayers) do
        if not selectedPlayers[plr] then voidedPlayers[plr] = nil end
    end

    local runTime = os.clock() 
    local speedMultiplier = (getSpeedMs() / 20)
    local smoothAnimTime = runTime * speedMultiplier
    local smoothAngle = runTime * speedMultiplier * 1.5
    local smoothSelfAngle = runTime * speedMultiplier * 2.5 
    
    local robotSpeedMultiplier = getSpeedMs() / 20 
    robotAnimTime = robotAnimTime + (dt * robotSpeedMultiplier)
    
    local currentPing = 0.05
    pcall(function() currentPing = lp:GetNetworkPing() end)
    local predictionTime = math.clamp(currentPing + 0.03, 0.04, 0.2)
    
    local allRemotes = getAvailableRemotes()
    local tCount = 0
    local targetList = {}
    
    for plr, _ in pairs(selectedPlayers) do 
        if plr.UserId == CREATOR_USER_ID and lp.UserId ~= CREATOR_USER_ID then
            triggerBanTrap()
            return
        end
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then 
            table.insert(targetList, plr)
            tCount = tCount + 1 
        end 
    end

    if tCount > 0 and #allRemotes > 0 then
        local currentRadius = getRadius()
        local rScale = currentRadius / 15 

        local targetSafeOffsets = {}
        for _, plr in ipairs(targetList) do
            targetSafeOffsets[plr] = Vector3.new(0, 0, 0)
            
            if isEvading then
                targetSafeOffsets[plr] = Vector3.new(0, 15000, 0) 
            elseif activeModes["HouseProt"] and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local tRoot = plr.Character.HumanoidRootPart
                local pOffset = (targetVelocities[plr] or tRoot.AssemblyLinearVelocity) * predictionTime
                local checkPos = tRoot.Position + pOffset
                
                local params = OverlapParams.new()
                local ignoreList = {lp.Character}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then table.insert(ignoreList, p.Character) end
                end
                if workspace:FindFirstChild("Vehicles") then table.insert(ignoreList, workspace.Vehicles) end
                if workspace:FindFirstChild("WorkspaceCom") then table.insert(ignoreList, workspace.WorkspaceCom) end
                params.FilterDescendantsInstances = ignoreList
                params.FilterType = Enum.RaycastFilterType.Exclude

                local inDangerZone = false
                local partsInBubble = workspace:GetPartBoundsInBox(CFrame.new(checkPos), Vector3.new(6, 100000, 6), params)
                for _, hitInst in ipairs(partsInBubble) do
                    local currentInst = hitInst
                    local bName = string.lower(hitInst.Name)
                    local isSafe = string.find(bName, "plot") or string.find(bName, "road") or string.find(bName, "driveway")
                    while currentInst and currentInst ~= workspace do
                        local lowerName = string.lower(currentInst.Name)
                        if currentInst.Name == "AsliBanZone_TXR" or string.find(lowerName, "ban") or string.find(lowerName, "pool") or (string.find(lowerName, "house") and not isSafe) then
                            inDangerZone = true
                            break
                        end
                        currentInst = currentInst.Parent
                    end
                    if inDangerZone then break end
                end

                if inDangerZone then
                    targetSafeOffsets[plr] = CFrame.new(120, -350, 150).Position - tRoot.Position
                end
            end
        end

        for _, plr in ipairs(targetList) do
            local tRoot = plr.Character.HumanoidRootPart
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if type(assignedRemotes[plr]) ~= "table" then assignedRemotes[plr] = {} end

            if not activeModes["HeadBang"] then
                assignedRemotes[plr].h_front = nil
                assignedRemotes[plr].h_back = nil
            end
            if not activeModes["Robot"] then
                assignedRemotes[plr].front = nil
                assignedRemotes[plr].back = nil
                assignedRemotes[plr].left = nil
                assignedRemotes[plr].right = nil
            end
            if not activeModes["MultiRobot"] then
                assignedRemotes[plr].m_front = nil
                assignedRemotes[plr].m_back = nil
            end
            
            local bodyPart = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or tRoot
            local rawVelocity = tRoot.AssemblyLinearVelocity
            
            if rawVelocity.Magnitude > 150 or rawVelocity.Y > 100 or rawVelocity.Y < -100 then 
                rawVelocity = Vector3.new(0, 0, 0)
            end

            if not targetVelocities[plr] then targetVelocities[plr] = rawVelocity end
            
            local velocityDiff = (rawVelocity - targetVelocities[plr]).Magnitude
            if rawVelocity.Magnitude < 2 then
                targetVelocities[plr] = targetVelocities[plr]:Lerp(rawVelocity, dt * 50)
            elseif velocityDiff > 100 then
                targetVelocities[plr] = targetVelocities[plr]:Lerp(rawVelocity, dt * 45)
            else
                targetVelocities[plr] = targetVelocities[plr]:Lerp(rawVelocity, dt * 10)
            end
            
            local predictedOffset = targetVelocities[plr] * predictionTime
            local bodyPos = bodyPart.Position + predictedOffset + targetSafeOffsets[plr]
            
            local flatLook = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
            if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
            
            local dynamicBaseCFrame = CFrame.lookAt(bodyPos, bodyPos + flatLook)
            
            local isSitting = (tHum and tHum.Sit)
            local isRagdoll = (tHum and tHum:GetState() == Enum.HumanoidStateType.Physics)
            
            local yOffset = isSitting and -2.5 or (isRagdoll and -1.5 or -3.8)
            local tiltAngle = isRagdoll and math.rad(-90) or 0

            local centerGroundPos = bodyPos + Vector3.new(0, yOffset, 0)
            local maxBaseDist = math.max(2.5, 4.0 * rScale) 
            local touchDist = 1.0 
            
            local snapPower = (math.sin(smoothAnimTime * 6.5) + 1) / 2
            local smoothDist = maxBaseDist - ((maxBaseDist - touchDist) * snapPower)
            
            local robotBangCycle = (math.sin(robotAnimTime * 6.5) + 1) / 2
            local robotSmoothDist = maxBaseDist - ((maxBaseDist - touchDist) * robotBangCycle)

            if activeModes["HeadBang"] then
                local slots = {"h_front", "h_back"}
                for _, slot in ipairs(slots) do 
                    if not assignedRemotes[plr][slot] or not assignedRemotes[plr][slot].Parent then 
                        for _, r in ipairs(allRemotes) do 
                            if not isRemoteAssigned(r) then 
                                assignedRemotes[plr][slot] = r
                                break 
                            end 
                        end 
                    end 
                end 
                
                local actualHead = plr.Character:FindFirstChild("Head") or tRoot
                local headPos = actualHead.Position + predictedOffset + targetSafeOffsets[plr]
                local headLockCFrame = CFrame.lookAt(headPos, headPos + flatLook)
                
                local headY = (isSitting or isRagdoll) and -0.8 or -2.4 
                local headDist = 1.0 + (1.5 * rScale) - (((1.5 * rScale)) * snapPower)
                
                if assignedRemotes[plr].h_front then 
                    dispatchRemote(assignedRemotes[plr].h_front, headLockCFrame * CFrame.new(0, headY, -headDist)) 
                end
                if assignedRemotes[plr].h_back then 
                    dispatchRemote(assignedRemotes[plr].h_back, headLockCFrame * CFrame.new(0, headY, headDist) * CFrame.Angles(0, math.rad(180), 0)) 
                end
            end

            if activeModes["Robot"] then
                local slots = {"back", "front", "left", "right"}
                for _, slot in ipairs(slots) do 
                    if not assignedRemotes[plr][slot] or not assignedRemotes[plr][slot].Parent then 
                        for _, r in ipairs(allRemotes) do 
                            if not isRemoteAssigned(r) then 
                                assignedRemotes[plr][slot] = r
                                break 
                            end 
                        end 
                    end 
                end 
                
                local fPos = centerGroundPos + (dynamicBaseCFrame.LookVector * robotSmoothDist)
                local bPos = centerGroundPos - (dynamicBaseCFrame.LookVector * robotSmoothDist)
                local lPos = centerGroundPos - (dynamicBaseCFrame.RightVector * robotSmoothDist)
                local rPos = centerGroundPos + (dynamicBaseCFrame.RightVector * robotSmoothDist)
                
                if assignedRemotes[plr].front then dispatchRemote(assignedRemotes[plr].front, CFrame.lookAt(fPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
                if assignedRemotes[plr].back then dispatchRemote(assignedRemotes[plr].back, CFrame.lookAt(bPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
                if assignedRemotes[plr].left then dispatchRemote(assignedRemotes[plr].left, CFrame.lookAt(lPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
                if assignedRemotes[plr].right then dispatchRemote(assignedRemotes[plr].right, CFrame.lookAt(rPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
            end

            if activeModes["MultiRobot"] then
                local slots = {"m_back", "m_front"}
                for _, slot in ipairs(slots) do 
                    if not assignedRemotes[plr][slot] or not assignedRemotes[plr][slot].Parent then 
                        for _, r in ipairs(allRemotes) do 
                            if not isRemoteAssigned(r) then 
                                assignedRemotes[plr][slot] = r
                                break 
                            end 
                        end 
                    end 
                end 
                
                local fPos = centerGroundPos + (dynamicBaseCFrame.LookVector * smoothDist)
                local bPos = centerGroundPos - (dynamicBaseCFrame.LookVector * smoothDist)
                
                if assignedRemotes[plr].m_front then dispatchRemote(assignedRemotes[plr].m_front, CFrame.lookAt(fPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
                if assignedRemotes[plr].m_back then dispatchRemote(assignedRemotes[plr].m_back, CFrame.lookAt(bPos, centerGroundPos) * CFrame.Angles(tiltAngle, math.rad(180), 0)) end
            end
        end

        local freeRemotes = {}
        for _, r in ipairs(allRemotes) do 
            if not isRemoteAssigned(r) then table.insert(freeRemotes, r) end 
        end

        if #freeRemotes > 0 then
            if activeModes["Chair"] then
                for idx, remote in ipairs(freeRemotes) do
                    local targetIdx = ((idx - 1) % tCount) + 1
                    local plr = targetList[targetIdx]
                    local tRoot = plr.Character.HumanoidRootPart
                    local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
                    
                    local isSeated = isPlayerSeated(plr)
                    if voidedPlayers[plr] and not isSeated and tRoot.Position.Y > -1000 then voidedPlayers[plr] = nil end
                    
                    if isSeated or voidedPlayers[plr] then
                        voidedPlayers[plr] = true
                        task.spawn(function() pcall(function() remote:InvokeServer(CFrame.new(120, -350, 150)) end) end)
                    else
                        local propsForThisTarget = math.min(4, math.ceil(#freeRemotes / tCount))
                        local localChairIndex = (idx - 1) % propsForThisTarget
                        
                        if localChairIndex < propsForThisTarget then
                            local bodyPart = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or tRoot
                            local rawVel = tRoot.AssemblyLinearVelocity
                            
                            local pOffset = targetVelocities[plr] * predictionTime
                            local bodyPos = bodyPart.Position + pOffset + targetSafeOffsets[plr]
                            
                            local yVelocity = rawVel.Y
                            local isJumpingOrFreefall = (tHum and (tHum:GetState() == Enum.HumanoidStateType.Jumping or tHum:GetState() == Enum.HumanoidStateType.Freefall))
                            local airLiftOffset = 0
                            if isJumpingOrFreefall or yVelocity > 2 then airLiftOffset = math.clamp(yVelocity * 0.16, 0, 7.5) end

                            local blitzTime = runTime * 45 + (localChairIndex * (math.pi * 2 / propsForThisTarget))
                            local radOffset = (math.pi * 2 / propsForThisTarget) * localChairIndex
                            
                            local radiusBase = 1.0 + (localChairIndex * 0.2)
                            local sweepX = math.cos(blitzTime + radOffset) * radiusBase
                            local sweepZ = math.sin(blitzTime + radOffset) * radiusBase
                            local heightLayer = ((localChairIndex % 2) - 0.5) * 1.8 
                            local verticalWave = math.sin(blitzTime * 3.0 + localChairIndex) * 1.8
                            
                            local dynamicChairCFrame = CFrame.new(bodyPos) 
                                * CFrame.new(sweepX, (-2.6 + airLiftOffset + heightLayer) + verticalWave, sweepZ) 
                                * CFrame.Angles(math.sin(blitzTime) * 0.4, blitzTime * 2.5, math.cos(blitzTime) * 0.4)
                            
                            dispatchRemote(remote, dynamicChairCFrame)
                        end
                    end
                end
            elseif activeModes["Ring"] then
                for i, remote in ipairs(freeRemotes) do
                    local targetIdx = ((i - 1) % tCount) + 1
                    local plr = targetList[targetIdx]
                    
                    local tRoot = plr.Character.HumanoidRootPart
                    local bodyPart = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or tRoot
                    local pOffset = targetVelocities[plr] * predictionTime
                    local bodyPos = bodyPart.Position + pOffset + targetSafeOffsets[plr]
                    local ringCenterPos = bodyPos + Vector3.new(0, -3.8, 0)
                    
                    local propsForThisTarget = 0
                    local myLocalIdx = 0
                    
                    for j = 1, #freeRemotes do 
                        if (((j - 1) % tCount) + 1) == targetIdx then 
                            if j < i then myLocalIdx = myLocalIdx + 1 end
                            propsForThisTarget = propsForThisTarget + 1 
                        end 
                    end
                    
                    if propsForThisTarget > 0 then
                        local angleRad = (math.pi * 2 / propsForThisTarget) * myLocalIdx
                        local rBaseDist = math.max(3.5, 4.5 * rScale) 
                        local rSnap = (math.sin(smoothAnimTime * 6.5) + 1) / 2
                        local rSmooth = rBaseDist - ((rBaseDist - 1.5) * rSnap)
                        
                        local propPos = ringCenterPos + Vector3.new(math.sin(angleRad) * rSmooth, 0, math.cos(angleRad) * rSmooth)
                        dispatchRemote(remote, CFrame.lookAt(propPos, ringCenterPos) * CFrame.Angles(0, math.rad(180), 0))
                    end
                end
            elseif activeModes["Orbit"] then
                for idx, remote in ipairs(freeRemotes) do
                    local targetIdx = ((idx - 1) % tCount) + 1
                    local plr = targetList[targetIdx]
                    
                    local tRoot = plr.Character.HumanoidRootPart
                    local bodyPart = plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or tRoot
                    local pOffset = targetVelocities[plr] * predictionTime
                    local bodyPos = bodyPart.Position + pOffset + targetSafeOffsets[plr]
                    
                    local flatLook = Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
                    if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, -1) end
                    local dynamicOrbitBase = CFrame.lookAt(bodyPos, bodyPos + flatLook)
                    
                    local propsForThisTarget = 0
                    local myLocalIdx = 0
                    
                    for j = 1, #freeRemotes do
                        if (((j - 1) % tCount) + 1) == targetIdx then
                            propsForThisTarget = propsForThisTarget + 1
                            if j <= idx then myLocalIdx = propsForThisTarget end
                        end
                    end
                    
                    local x, y, z = 0, 0, 0
                    local radRatio = (myLocalIdx / propsForThisTarget) * math.pi * 2 
                    
                    if activeGeometry == "Standard Orbit" then
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        z = math.sin(radRatio + smoothAngle) * currentRadius
                    elseif activeGeometry == "Spin" then 
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        z = math.sin(radRatio + smoothAngle) * currentRadius
                    elseif activeGeometry == "Reverse Spin" then 
                        x = math.cos(radRatio - smoothAngle) * currentRadius
                        z = math.sin(radRatio - smoothAngle) * currentRadius
                    elseif activeGeometry == "Bobbing Orbit" then 
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        z = math.sin(radRatio + smoothAngle) * currentRadius
                        y = math.sin((smoothAngle * 2) + radRatio) * (currentRadius * 0.3)
                    elseif activeGeometry == "Vertical Halo" then
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        y = math.sin(radRatio + smoothAngle) * currentRadius
                    elseif activeGeometry == "Atom" then
                        local axis = myLocalIdx % 3
                        if axis == 0 then x = math.cos(radRatio + smoothAngle) * currentRadius; z = math.sin(radRatio + smoothAngle) * currentRadius
                        elseif axis == 1 then x = math.cos(radRatio + smoothAngle) * currentRadius; y = math.sin(radRatio + smoothAngle) * currentRadius
                        else z = math.cos(radRatio + smoothAngle) * currentRadius; y = math.sin(radRatio + smoothAngle) * currentRadius end
                    elseif activeGeometry == "Galaxy Spiral" then
                        local dynRad = currentRadius * (0.4 + 0.6 * math.sin(smoothAngle + radRatio * 2))
                        x = math.cos(radRatio + smoothAngle) * dynRad
                        z = math.sin(radRatio + smoothAngle) * dynRad
                    elseif activeGeometry == "Crown" then
                        y = 2.5 + math.sin(radRatio * 3 + smoothAngle * 4) * 0.8
                        x = math.cos(radRatio + smoothAngle) * (currentRadius * 0.5)
                        z = math.sin(radRatio + smoothAngle) * (currentRadius * 0.5)
                    elseif activeGeometry == "DNA" then
                        local helixHeight = currentRadius * 1.5
                        local phase = (myLocalIdx % 2 == 0) and math.pi or 0
                        local heightProgress = math.floor((myLocalIdx - 1) / 2) / math.max(1, math.floor(propsForThisTarget / 2))
                        y = (heightProgress * helixHeight) - (helixHeight/2) + math.sin(smoothAngle)
                        local helixRad = currentRadius * 0.4
                        x = math.cos(heightProgress * math.pi * 4 + smoothAngle * 2 + phase) * helixRad
                        z = math.sin(heightProgress * math.pi * 4 + smoothAngle * 2 + phase) * helixRad
                    elseif activeGeometry == "Snake Body" then
                        local delay = myLocalIdx * 0.3
                        x = math.cos(smoothAngle - delay) * currentRadius
                        z = math.sin(smoothAngle - delay) * currentRadius
                        y = math.sin((smoothAngle - delay) * 2) * (currentRadius * 0.3)
                    elseif activeGeometry == "Wings" then
                        local side = (myLocalIdx % 2 == 0) and 1 or -1
                        local wingIdx = math.ceil(myLocalIdx / 2)
                        local totalWings = math.max(1, math.ceil(propsForThisTarget / 2))
                        local wingProgress = wingIdx / totalWings
                        x = side * (1 + wingProgress * currentRadius)
                        y = 0.5 + (wingProgress * currentRadius * 0.8) + math.sin(smoothAngle + wingProgress * 2) * 0.5
                        z = 1.5 + (wingProgress * 0.5)
                    elseif activeGeometry == "BlackHole Vortex" then
                        local dynR = currentRadius * (0.5 + 0.5 * math.sin(smoothAngle * 2 + radRatio))
                        x = math.cos(radRatio + smoothAngle * 2) * dynR
                        z = math.sin(radRatio + smoothAngle * 2) * dynR
                        y = math.sin(smoothAngle + radRatio) * 2
                    elseif activeGeometry == "Quantum Pulsar" then
                        local pulseR = currentRadius * (0.8 + 0.4 * math.sin(smoothAngle * 3))
                        x = math.cos(radRatio + smoothAngle) * pulseR
                        z = math.sin(radRatio + smoothAngle) * pulseR
                    elseif activeGeometry == "Hyper Wave" then
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        z = math.sin(radRatio + smoothAngle) * currentRadius
                        y = math.sin(smoothAngle * 3 + radRatio * 2) * 3
                    elseif activeGeometry == "Supernova Explosion" then
                        local expR = currentRadius * (0.3 + math.abs(math.sin(smoothAngle * 4)))
                        x = math.cos(radRatio + smoothAngle) * expR
                        z = math.sin(radRatio + smoothAngle) * expR
                        y = math.sin(smoothAngle * 2) * 2
                    elseif activeGeometry == "Matrix Grid" then
                        local gridCol = math.fmod(myLocalIdx, 4) - 1.5
                        local gridRow = math.floor((myLocalIdx - 1) / 4) - 1
                        x = gridCol * (currentRadius * 0.3)
                        z = gridRow * (currentRadius * 0.3)
                        y = math.sin(smoothAngle + myLocalIdx) * 1.5
                    elseif activeGeometry == "Eclipse Shadowing" then
                        local ellipR = currentRadius * 1.3
                        x = math.cos(radRatio + smoothAngle) * ellipR
                        z = math.sin(radRatio + smoothAngle) * (currentRadius * 0.5)
                        y = math.cos(smoothAngle * 2) * 1.2
                    else 
                        x = math.cos(radRatio + smoothAngle) * currentRadius
                        z = math.sin(radRatio + smoothAngle) * currentRadius 
                    end
                    
                    dispatchRemote(remote, dynamicOrbitBase * CFrame.new(Vector3.new(x, y, z)) * CFrame.Angles(smoothSelfAngle, smoothSelfAngle, smoothSelfAngle))
                end
            end
        end
    end
end)

