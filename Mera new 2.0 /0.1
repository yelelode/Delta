-- main engine
RunService.Heartbeat:Connect(function(dt)
    if not isActive then return end
    for plr in pairs(assignedRemotes) do
        if not selectedPlayers[plr] or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            assignedRemotes[plr]=nil; targetVelocities[plr]=nil
        end
    end
    for plr in pairs(voidedPlayers) do if not selectedPlayers[plr] then voidedPlayers[plr]=nil end end

    local rt=os.clock(); local sm=getSpeedMs()/20
    local sat=rt*sm; local sa=rt*sm*1.5; local ssa=rt*sm*2.5
    robotAnimTime=robotAnimTime+(dt*3)
    local ping=0.05; pcall(function() ping=lp:GetNetworkPing() end)
    local pred=ping+0.03
    local allR=getRemotes(); local tCount=0; local tList={}
    for plr in pairs(selectedPlayers) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then table.insert(tList,plr); tCount=tCount+1 end
    end
    if tCount==0 or #allR==0 then return end
    local curR=getRadius(); local rs=curR/15

    for _,plr in ipairs(tList) do
        local tr=plr.Character.HumanoidRootPart; local th=plr.Character:FindFirstChildOfClass("Humanoid")
        if type(assignedRemotes[plr])~="table" then assignedRemotes[plr]={} end
        local bp=plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or tr
        local rv=tr.AssemblyLinearVelocity
        if not targetVelocities[plr] then targetVelocities[plr]=rv end
        targetVelocities[plr]=targetVelocities[plr]:Lerp(rv,dt*10)
        local bpos=bp.Position+(targetVelocities[plr]*pred)
        local fl=Vector3.new(tr.CFrame.LookVector.X,0,tr.CFrame.LookVector.Z)
        if fl.Magnitude>0.01 then fl=fl.Unit else fl=Vector3.new(0,0,-1) end
        local dbc=CFrame.lookAt(bpos,bpos+fl)
        local prone=(th and (th:GetState()==Enum.HumanoidStateType.Physics or th.Sit))
        local yOff=prone and -1.5 or -3.8; local tilt=prone and math.rad(-90) or 0
        local cgp=bpos+Vector3.new(0,yOff,0)
        local mbd=math.max(2.5,4.0*rs); local td=1.0
        local sp=math.pow(math.abs(math.sin(sat*6)),2.5); local sd=mbd-((mbd-td)*sp)
        local rbsp=math.pow(math.abs(math.sin(robotAnimTime*6)),2.5); local rsd=mbd-((mbd-td)*rbsp)

        if activeModes["HeadBang"] then
            for _,sl in ipairs({"h_front","h_back"}) do
                if not assignedRemotes[plr][sl] or not assignedRemotes[plr][sl].Parent then
                    for _,r in ipairs(allR) do if not isAssigned(r) then assignedRemotes[plr][sl]=r; break end end
                end
            end
            local ah=plr.Character:FindFirstChild("Head") or tr
            local hp=ah.Position+(targetVelocities[plr]*pred)
            local hlc=CFrame.lookAt(hp,hp+fl)
            local hy=prone and -0.8 or -2.4; local hd=1.0+(1.5*rs)-((1.5*rs)*sp)
            if assignedRemotes[plr].h_front then dispatch(assignedRemotes[plr].h_front,hlc*CFrame.new(0,hy,-hd)) end
            if assignedRemotes[plr].h_back  then dispatch(assignedRemotes[plr].h_back, hlc*CFrame.new(0,hy,hd)*CFrame.Angles(0,math.rad(180),0)) end
        end
        if activeModes["Robot"] then
            for _,sl in ipairs({"back","front","left","right"}) do
                if not assignedRemotes[plr][sl] or not assignedRemotes[plr][sl].Parent then
                    for _,r in ipairs(allR) do if not isAssigned(r) then assignedRemotes[plr][sl]=r; break end end
                end
            end
            local fp=cgp+(dbc.LookVector*rsd); local bkp=cgp-(dbc.LookVector*rsd)
            local lp2=cgp-(dbc.RightVector*rsd); local rp=cgp+(dbc.RightVector*rsd)
            if assignedRemotes[plr].front then dispatch(assignedRemotes[plr].front,CFrame.lookAt(fp,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
            if assignedRemotes[plr].back  then dispatch(assignedRemotes[plr].back, CFrame.lookAt(bkp,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
            if assignedRemotes[plr].left  then dispatch(assignedRemotes[plr].left, CFrame.lookAt(lp2,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
            if assignedRemotes[plr].right then dispatch(assignedRemotes[plr].right,CFrame.lookAt(rp,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
        end
        if activeModes["MultiRobot"] then
            for _,sl in ipairs({"m_back","m_front"}) do
                if not assignedRemotes[plr][sl] or not assignedRemotes[plr][sl].Parent then
                    for _,r in ipairs(allR) do if not isAssigned(r) then assignedRemotes[plr][sl]=r; break end end
                end
            end
            local fp=cgp+(dbc.LookVector*sd); local bkp=cgp-(dbc.LookVector*sd)
            if assignedRemotes[plr].m_front then dispatch(assignedRemotes[plr].m_front,CFrame.lookAt(fp,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
            if assignedRemotes[plr].m_back  then dispatch(assignedRemotes[plr].m_back, CFrame.lookAt(bkp,cgp)*CFrame.Angles(tilt,math.rad(180),0)) end
        end
        if activeModes["Chair"] then
            if voidedPlayers[plr] and not th.Sit then voidedPlayers[plr]=nil end
            if not voidedPlayers[plr] then
                if not assignedRemotes[plr].chair or not assignedRemotes[plr].chair.Parent then
                    for _,r in ipairs(allR) do if not isAssigned(r) then assignedRemotes[plr].chair=r; break end end
                end
                if assignedRemotes[plr].chair then
                    if th.Sit then
                        pcall(function() assignedRemotes[plr].chair:InvokeServer(CFrame.new(0,-5000,0)) end)
                        voidedPlayers[plr]=true; assignedRemotes[plr].chair=nil
                    else
                        dispatch(assignedRemotes[plr].chair,CFrame.new(bpos)*CFrame.new(0,-3.2,0))
                    end
                end
            end
        end
    end

    local freeR={}; for _,r in ipairs(allR) do if not isAssigned(r) then table.insert(freeR,r) end end
    if #freeR==0 then return end

    if activeModes["Ring"] then
        for i,remote in ipairs(freeR) do
            local ti=((i-1)%tCount)+1; local plr=tList[ti]
            local bp=plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or plr.Character.HumanoidRootPart
            local bpos=bp.Position+(targetVelocities[plr]*pred)
            local rcp=bpos+Vector3.new(0,-3.8,0)
            local pft=0; local mli=0
            for j=1,#freeR do if (((j-1)%tCount)+1)==ti then if j<i then mli=mli+1 end; pft=pft+1 end end
            if pft>0 then
                local ar=(math.pi*2/pft)*mli
                local rbd=math.max(3.5,4.5*rs); local rsp=math.pow(math.abs(math.sin(sat*6)),2.5); local rsm=rbd-((rbd-1.5)*rsp)
                local pp=rcp+Vector3.new(math.sin(ar)*rsm,0,math.cos(ar)*rsm)
                dispatch(remote,CFrame.lookAt(pp,rcp)*CFrame.Angles(0,math.rad(180),0))
            end
        end
    end
    if activeModes["Orbit"] then
        for idx,remote in ipairs(freeR) do
            local ti=((idx-1)%tCount)+1; local plr=tList[ti]
            local bp=plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("LowerTorso") or plr.Character.HumanoidRootPart
            local bpos=bp.Position+(targetVelocities[plr]*pred)
            local dob=CFrame.new(bpos)
            local pft=math.ceil(#freeR/tCount); local li=idx%pft
            local x,y,z=0,0,0; local rr=(li/pft)*math.pi*2
            if activeGeometry=="Spin" then x=math.cos(rr+sa)*curR; z=math.sin(rr+sa)*curR
            elseif activeGeometry=="Reverse Spin" then x=math.cos(rr-sa)*curR; z=math.sin(rr-sa)*curR
            elseif activeGeometry=="Bobbing Orbit" then x=math.cos(rr+sa)*curR; z=math.sin(rr+sa)*curR; y=math.sin((sa*2)+rr)*(curR/1.5)
            else x=math.cos(rr+sa)*curR; z=math.sin(rr+sa)*curR end
            dispatch(remote,dob*CFrame.new(Vector3.new(x,y,z))*CFrame.Angles(ssa,ssa,ssa))
        end
    end
end)

