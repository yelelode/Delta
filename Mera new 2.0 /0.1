local function makeBtn(txt, modeKey, isMenu)
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(1,0,0,42)
    btn.BackgroundColor3 = C.Surface
    btn.BackgroundTransparency = 0.3
    btn.Text = "   "..txt
    btn.TextColor3 = C.White
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.LayoutOrder = ord()
    btn.ZIndex = 8
    corner(btn, 10)
    crisp(btn)

    -- Active glow behind button
    local ag = glow(btn, C.Teal, 1.0, 1.4, 7)
    ag.Name = "ActiveGlow"

    -- Left accent bar
    local acc = Instance.new("Frame", btn)
    acc.Name="Accent"; acc.Size=UDim2.new(0,0,0,0)
    acc.Position=UDim2.new(0,0,0.5,0); acc.AnchorPoint=Vector2.new(0,0.5)
    acc.BackgroundColor3=C.Teal; acc.BorderSizePixel=0
    corner(acc,3)

    if isMenu then
        local arr=Instance.new("TextLabel",btn)
        arr.Size=UDim2.new(0,22,1,0); arr.Position=UDim2.new(1,-26,0,0)
        arr.BackgroundTransparency=1; arr.Text=">"; arr.TextColor3=C.Sub
        arr.Font=Enum.Font.GothamBold; arr.TextSize=12; arr.ZIndex=9
    end

    -- Hover states
    local bs=Instance.new("UIScale",btn); bs.Scale=1
    btn:SetAttribute("BaseColor",C.Surface); btn:SetAttribute("BaseTrans",0.3)

    btn.MouseEnter:Connect(function()
        tween(bs,0.35,{Scale=1.03},Enum.EasingStyle.Back):Play()
        if not (modeKey and activeModes[modeKey]) then
            tween(btn,0.3,{BackgroundColor3=C.SurfaceHov,BackgroundTransparency=0.15}):Play()
            tween(ag,0.3,{ImageTransparency=0.82}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        tween(bs,0.4,{Scale=1},Enum.EasingStyle.Quart):Play()
        if not (modeKey and activeModes[modeKey]) then
            tween(btn,0.35,{BackgroundColor3=C.Surface,BackgroundTransparency=0.3}):Play()
            tween(ag,0.35,{ImageTransparency=1.0}):Play()
        end
    end)
    btn.MouseButton1Down:Connect(function() tween(bs,0.1,{Scale=0.92}):Play() end)
    btn.MouseButton1Up:Connect(function() tween(bs,0.45,{Scale=1.03},Enum.EasingStyle.Elastic):Play() end)

    return btn
end

local function setActive(btn, on, col)
    local ag=btn:FindFirstChild("ActiveGlow")
    local ac=btn:FindFirstChild("Accent")
    local tc=col or C.Teal
    if on then
        tween(btn,0.4,{BackgroundColor3=C.ActiveTint,BackgroundTransparency=0.2,TextColor3=tc}):Play()
        if ac then ac.BackgroundColor3=tc; tween(ac,0.4,{Size=UDim2.new(0,3,0.65,0)},Enum.EasingStyle.Back):Play() end
        if ag then ag.ImageColor3=tc; tween(ag,0.4,{ImageTransparency=0.62}):Play() end
    else
        tween(btn,0.4,{BackgroundColor3=C.Surface,BackgroundTransparency=0.3,TextColor3=C.White}):Play()
        if ac then tween(ac,0.35,{Size=UDim2.new(0,0,0,0)}):Play() end
        if ag then tween(ag,0.35,{ImageTransparency=1.0}):Play() end
    end
end

