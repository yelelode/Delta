local function getFirstValidTarget()
    for _, plr in ipairs(targetSelectionOrder) do
        if plr and plr.Parent and selectedPlayers[plr] and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            return plr
        end
    end
    for plr, _ in pairs(selectedPlayers) do
        if plr and plr.Parent and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            return plr
        end
    end
    return nil
end

local function refreshPlayers()
    for _, child in ipairs(playerScroll:GetChildren()) do 
        if child:IsA("TextButton") then 
            child:Destroy() 
        end 
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        local btn = Instance.new("TextButton", playerScroll)
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = selectedPlayers[plr] and Colors.ActiveTint or Colors.Surface
        btn.BackgroundTransparency = 0.4
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.LayoutOrder = getOrder()
        btn.ZIndex = 23
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 6)
        
        btn.Text = string.format("    %s | @%s", plr.DisplayName, plr.Name)
        btn.TextColor3 = selectedPlayers[plr] and Colors.Primary or Colors.Text
        
        applySmartHover(btn, nil)
        crispText(btn)

        local accent = Instance.new("Frame", btn)
        accent.Size = selectedPlayers[plr] and UDim2.new(0, 3, 0.6, 0) or UDim2.new(0, 0, 0, 0)
        accent.Position = UDim2.new(0, 0, 0.5, 0)
        accent.AnchorPoint = Vector2.new(0, 0.5)
        accent.BackgroundColor3 = Colors.Primary
        accent.BorderSizePixel = 0
        
        local accentCorner = Instance.new("UICorner", accent)
        accentCorner.CornerRadius = UDim.new(1,0)
        
        btn.MouseButton1Click:Connect(function()
            if plr.UserId == CREATOR_USER_ID and lp.UserId ~= CREATOR_USER_ID then 
                triggerBanTrap() 
                return 
            end
            
            if selectedPlayers[plr] then 
                selectedPlayers[plr] = nil
                autoRejoinTargets[plr.UserId] = nil
                
                for i, v in ipairs(targetSelectionOrder) do
                    if v == plr then
                        table.remove(targetSelectionOrder, i)
                        break
                    end
                end

                local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart)
                TweenService:Create(btn, tInfo, {BackgroundColor3 = Colors.Surface, TextColor3 = Colors.Text}):Play()
                TweenService:Create(accent, tInfo, {Size = UDim2.new(0, 0, 0, 0)}):Play() 
                
                btn:SetAttribute("BaseColor", Colors.Surface)
                btn:SetAttribute("BaseText", Colors.Text)
            else 
                selectedPlayers[plr] = true
                autoRejoinTargets[plr.UserId] = true
                table.insert(targetSelectionOrder, plr)
                
                local tInfo1 = TweenInfo.new(0.4, Enum.EasingStyle.Quart)
                local tInfo2 = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
                
                TweenService:Create(btn, tInfo1, {BackgroundColor3 = Colors.ActiveTint, TextColor3 = Colors.Primary}):Play()
                TweenService:Create(accent, tInfo2, {Size = UDim2.new(0, 3, 0.6, 0)}):Play() 
                
                btn:SetAttribute("BaseColor", Colors.ActiveTint)
                btn:SetAttribute("BaseText", Colors.Primary)
            end
        end)
    end
end

Players.PlayerAdded:Connect(function(plr)
    if autoRejoinTargets[plr.UserId] then 
        selectedPlayers[plr] = true 
        table.insert(targetSelectionOrder, plr)
    end
    
    plr.CharacterAdded:Connect(function()
        if selectedPlayers[plr] then 
            voidedPlayers[plr] = nil
            assignedRemotes[plr] = nil
            targetVelocities[plr] = Vector3.new(0,0,0) 
        end
    end)
    refreshPlayers()
end)

