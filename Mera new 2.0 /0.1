local function clearProps() 
    task.spawn(function()
        pcall(function() 
            local r = DynamicRemotes.ClearProps or ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Clea1rTool1s")
            if r then
                for i = 1, 3 do
                    r:FireServer("ClearAllProps")
                    r:FireServer("ClearProps") 
                    task.wait(0.05)
                end
            end
        end)
    end)
    
    task.spawn(function()
        local myHouseData = getMyHouse()
        if myHouseData and myHouseData.Remote then
            pcall(function() myHouseData.Remote:InvokeServer() end)
        end
    end)
    
    pcall(function()
        local com = workspace:FindFirstChild("WorkspaceCom")
        if com then
            for _, f in ipairs(com:GetChildren()) do
                for _, c in ipairs(f:GetChildren()) do
                    if c.Name == "Prop" .. lp.Name then
                        pcall(function() c:Destroy() end)
                    end
                end
            end
        end
    end)
    task.wait(0.3) 
end

local function spawnProp(propName, category) 
    pcall(function() 
        local RE = ReplicatedStorage:WaitForChild("RE")
        local r = DynamicRemotes.ClearProps or RE:FindFirstChild("1Clea1rTool1s")
        if not r then
            for _, v in ipairs(RE:GetChildren()) do
                if v:IsA("RemoteEvent") and string.find(string.lower(v.Name), "clear") then
                    r = v
                    break
                end
            end
        end
        if r then
            r:FireServer("RequestingPropName", propName, category) 
        end
    end) 
end

local function getActivePropData()
    local needsChair = activeModes["Chair"]
    local needsRobot = activeModes["Robot"] or activeModes["MultiRobot"] or activeModes["Orbit"] or activeModes["Ring"] or activeModes["HeadBang"]
    
    if needsChair and not needsRobot then 
        return "FurnitureBleachers", "Furniture" 
    else 
        return customPropName, customPropCategory 
    end
end

