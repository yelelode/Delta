local function getMyHouse()
    -- Pehle normal Lots check karo
    local lotsFolder = workspace:FindFirstChild("001_Lots")
    if lotsFolder then
        for _, lot in ipairs(lotsFolder:GetChildren()) do
            if string.find(string.lower(lot.Name), string.lower(lp.Name)) then
                local picked = lot:FindFirstChild("HousePickedByPlayer")
                if picked then
                    local houseModel = picked:FindFirstChild("HouseModel")
                    if houseModel then
                        local clearRemote = houseModel:FindFirstChild("Permissions:ClearProps", true)
                        if clearRemote and clearRemote:IsA("RemoteFunction") then
                            return {Lot = lot, Remote = clearRemote, Type = "Normal"}
                        end
                    end
                end
            end
        end
    end
    
    -- Agar normal Lot nahi mila, toh Apartments me dhundho (Global Workspace scan for our owner tag)
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc.Name == "HousePickedByPlayer" and (tostring(desc.Value) == lp.Name or desc.Value == lp) then
            local parentLot = desc.Parent
            if parentLot then
                local clearRemote = parentLot:FindFirstChild("Permissions:ClearProps", true)
                if clearRemote and clearRemote:IsA("RemoteFunction") then
                    return {Lot = parentLot, Remote = clearRemote, Type = "Apartment"}
                end
            end
        end
    end
    
    return nil
end

