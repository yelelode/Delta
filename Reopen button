-- 🚀 DRAGGING WITH INERTIA & CLAMP
local dragging = false
local dragStart = nil
local startPos = nil
local targetPos = openBtnContainer.Position
local velocity = Vector2.new(0, 0)
local lastInputPos = Vector2.new(0, 0)
local dragLoop = nil

local function getClampedTarget(newXScale, newXOffset, newYScale, newYOffset)
    local parentSize = gui.AbsoluteSize
    local frameSize = openBtnContainer.AbsoluteSize
    local anchor = openBtnContainer.AnchorPoint

    if parentSize.X <= 0 or parentSize.Y <= 0 then
        return UDim2.new(newXScale, newXOffset, newYScale, newYOffset)
    end

    local absX = (newXScale * parentSize.X) + newXOffset
    local absY = (newYScale * parentSize.Y) + newYOffset

    local minX = frameSize.X * anchor.X
    local maxX = parentSize.X - (frameSize.X * (1 - anchor.X))
    local minY = frameSize.Y * anchor.Y
    local maxY = parentSize.Y - (frameSize.Y * (1 - anchor.Y))

    if minX > maxX then minX, maxX = maxX, minX end
    if minY > maxY then minY, maxY = maxY, minY end

    local clampedX = math.clamp(absX, minX, maxX)
    local clampedY = math.clamp(absY, minY, maxY)

    return UDim2.new(newXScale, clampedX - (newXScale * parentSize.X), newYScale, clampedY - (newYScale * parentSize.Y))
end

openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = openBtnContainer.Position
        targetPos = startPos
        lastInputPos = Vector2.new(input.Position.X, input.Position.Y)
        velocity = Vector2.new(0, 0)
        isDraggingOrb = true
        dragThresholdMet = false
        
        if dragLoop then dragLoop:Disconnect() end
        
        dragLoop = RunService.RenderStepped:Connect(function(dt)
            if not gui.Parent then 
                if dragLoop then dragLoop:Disconnect() end
                return 
            end
            
            if dragging then
                openBtnContainer.Position = openBtnContainer.Position:Lerp(targetPos, math.clamp(dt * 25, 0, 1))
            else
                if velocity.Magnitude > 0.5 then
                    velocity = velocity * 0.90
                    targetPos = getClampedTarget(targetPos.X.Scale, targetPos.X.Offset + velocity.X, targetPos.Y.Scale, targetPos.Y.Offset + velocity.Y)
                    openBtnContainer.Position = openBtnContainer.Position:Lerp(targetPos, math.clamp(dt * 15, 0, 1))
                else
                    dragLoop:Disconnect()
                    dragLoop = nil
                end
            end
        end)
    end
end)

openBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        isDraggingOrb = false
        orbHovered = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 8 then 
            dragThresholdMet = true 
        end
        targetPos = getClampedTarget(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        local currentMousePos = Vector2.new(input.Position.X, input.Position.Y)
        velocity = currentMousePos - lastInputPos
        lastInputPos = currentMousePos
    end
end)

