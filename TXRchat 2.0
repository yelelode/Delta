emojiFrame.Size = UDim2.new(0, 240, 0, 160)
emojiFrame.Position = UDim2.new(0.5, -120, 0.5, -80)
emojiFrame.BackgroundColor3 = Colors.Surface
emojiFrame.Visible = false
emojiFrame.ZIndex = 30
Instance.new("UICorner", emojiFrame).CornerRadius = UDim.new(0, 8)
