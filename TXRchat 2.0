local lastTypingBroadcast = 0

local function sanitizeChatInput()
    if chatInput.Text == "TextBox" then
        chatInput.Text = ""
    end
end
chatInput:GetPropertyChangedSignal("Text"):Connect(function()
    sanitizeChatInput()
    if #chatInput.Text > 0 then
        typingIndicator.BackgroundTransparency = 0.2
        if tick() - lastTypingBroadcast > 4 then
            lastTypingBroadcast = tick()
            task.spawn(function()
                if req then
                    pcall(function()
                        req({
                            Url = SERVER_URL .. "/send", Method = "POST",
                            Headers = { ["Content-Type"] = "application/json" },
                            Body = HttpService:JSONEncode({ 
                                user = lp.Name .. "::" .. lp.DisplayName, 
                                msg = "[TYPING]", 
                                jobId = game.JobId, 
                                hidden = true 
                            })
                        })
                    end)
                end
            end)
        end
    else
        typingIndicator.BackgroundTransparency = 1
    end
end)
task.defer(sanitizeChatInput)

chatInput.Focused:Connect(function()
    sanitizeChatInput()
    TweenService:Create(inputStroke, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), {Color = Colors.Primary, Transparency = 0.0, Thickness = 1.4}):Play()
end)
