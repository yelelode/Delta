-- 🔥 3D KINETIC DRAG LOGIC 
local function makeDraggable(frame, handle, ghostAura, isOrb)
    local dragging = false
    local dragStart, startPos, targetPos, velocity = nil, nil, frame.Position, Vector2.new(0, 0)
    local lastInputPos = Vector2.new(0, 0)
    local dragLoop = nil
    local movedEnough = false

    local function getClampedTarget(newXScale, newXOffset, newYScale, newYOffset)
        local parentSize, frameSize, anchor = gui.AbsoluteSize, frame.AbsoluteSize, frame.AnchorPoint
        local absX = (newXScale * parentSize.X) + newXOffset
        local absY = (newYScale * parentSize.Y) + newYOffset
        local minX, maxX, minY, maxY
        if isOrb then
            minX, maxX = frameSize.X * anchor.X, parentSize.X - (frameSize.X * (1 - anchor.X))
            minY, maxY = frameSize.Y * anchor.Y, parentSize.Y - (frameSize.Y * (1 - anchor.Y))
        else
            minX = -frameSize.X * 0.5
            maxX = parentSize.X + (frameSize.X * 0.5)
            minY = -frameSize.Y * 0.5
            maxY = parentSize.Y + (frameSize.Y * 0.5)
        end
        local cx, cy = math.clamp(absX, minX, maxX), math.clamp(absY, minY, maxY)
        return UDim2.new(newXScale, cx - (newXScale * parentSize.X), newYScale, cy - (newYScale * parentSize.Y))
    end

    handle.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging, dragStart, startPos = true, input.Position, frame.Position
            targetPos, lastInputPos, velocity = startPos, Vector2.new(input.Position.X, input.Position.Y), Vector2.new(0,0)
            movedEnough = false
            if isOrb then isDraggingOrb = true end
            if dragLoop then dragLoop:Disconnect() end
            
            dragLoop = RunService.RenderStepped:Connect(function(dt)
                if _G.TXR_BangInstance ~= currentExecutionID then dragLoop:Disconnect(); return end 
                if dragging then
                    frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 25, 0, 1))
                else
                    if velocity.Magnitude > 0.5 then
                        velocity = velocity * 0.90
                        targetPos = getClampedTarget(targetPos.X.Scale, targetPos.X.Offset + velocity.X, targetPos.Y.Scale, targetPos.Y.Offset + velocity.Y)
                        frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 15, 0, 1))
                    else
                        dragLoop:Disconnect(); dragLoop = nil
                    end
                end
            end)
        end 
    end)
    handle.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false
            if isOrb then 
                isDraggingOrb, orbHovered = false, false 
                if not movedEnough then
                    TweenService:Create(openBtnScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0}):Play()
                    task.wait(0.25)
                    openBtnContainer.Visible = false
                    mainFrame.Visible = true
                    aura.Visible = true
                    shadowContainer.Visible = true
                    
                    TweenService:Create(mainScale, TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()
                    TweenService:Create(shadowScale, TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()
                    animateWaterfall(mainList)
                end
            end
        end 
    end)
    UserInputService.InputChanged:Connect(function(input) 
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then movedEnough = true end 
            targetPos = getClampedTarget(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            local currentMousePos = Vector2.new(input.Position.X, input.Position.Y)
            velocity = currentMousePos - lastInputPos
            lastInputPos = currentMousePos
        end 
    end)
end

makeDraggable(mainFrame, header, nil, false) 
makeDraggable(mainFrame, mainFrame, nil, false)
makeDraggable(openBtnContainer, openBtn, nil, true)

-- ORB LOGIC, ANIMATIONS & SONAR
local tTime = 0
local sonarTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if _G.TXR_BangInstance ~= currentExecutionID or not gui.Parent then return end
    tTime = tTime + dt
    
    if mainFrame.Visible then
        if bgGradient then bgGradient.Rotation = ((tTime * 40)/2) - 45 end
        local breath = (math.sin(tTime * 3) + 1) / 2 
        
        aura.ImageTransparency = 0.6 + (breath * 0.1)
        auraScale.Scale = mainScale.Scale
        mainFrame.BackgroundTransparency = 0.40 + (breath * 0.08) 

        -- Dynamic glass edges
        strokeGrad.Rotation = (tTime * 50) % 360
        titleGrad.Offset = Vector2.new(math.sin(tTime * 2) * 0.3, 0)
        scanlines.Position = UDim2.new(0, 0, (tTime * 0.05) % 1 - 1, 0)

        -- Sweeping shiny glass reflection 
        if glassGrad then
            glassGrad.Offset = Vector2.new(0, math.sin(tTime * 1.2) * 1.2)
        end
    end
    
    if openBtnContainer.Visible then
        local targetSpeed = (activeMode ~= nil) and 3 or 1
        if orbHovered then targetSpeed = targetSpeed * 1.5 end
        local activeT = tTime * 3 * targetSpeed
        local baseColor1 = (activeMode ~= nil) and Colors.Danger or Colors.Primary
        local baseColor2 = (activeMode ~= nil) and Colors.Warning or Colors.Purple
        local lerpAlpha = (math.sin(activeT * 0.8) + 1) / 2
        
        coreGlow.ImageColor3 = baseColor1:Lerp(baseColor2, lerpAlpha)
        coreGlow.ImageTransparency = 0.4 + (math.sin(activeT) * 0.25)
        eventGlow.ImageColor3 = baseColor2:Lerp(Color3.new(1,1,1), lerpAlpha)
        openStroke.Color = baseColor1:Lerp(baseColor2, lerpAlpha)
        goGrad.Rotation = (activeT * 50) % 360
        goStroke.Transparency = orbHovered and 0.1 or 0.5
        
        local gPulse = 40 + (math.sin(activeT * 2) * 3)
        gimbals[1].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 0.8)), gPulse)
        gimbals[1].frame.Rotation = (activeT * 20) % 360; gimbals[1].stroke.Color = baseColor1
        gimbals[2].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 0.9)))
        gimbals[2].frame.Rotation = -(activeT * 25) % 360; gimbals[2].stroke.Color = baseColor2
        gimbals[3].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 1.1)), gPulse)
        gimbals[3].frame.Rotation = 45 + (activeT * 15) % 360; gimbals[3].stroke.Color = baseColor1:Lerp(Color3.new(1,1,1), 0.5)
        gimbals[4].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 1.2)))
        gimbals[4].frame.Rotation = -45 - (activeT * 15) % 360; gimbals[4].stroke.Color = baseColor2:Lerp(Color3.new(1,1,1), 0.5)
        
        for i, d in ipairs(diamonds) do
            local breath = math.sin(activeT * 2 + (i * math.pi/2)) * 4
            d.frame.Size = UDim2.fromOffset(24 + breath, 24 - breath)
            d.frame.Rotation = (activeT * 40) * (i%2==0 and 1 or -1) + (i * 22.5)
            d.stroke.Color = (i%2==0) and baseColor1 or baseColor2
        end
        
        crosshair.Rotation = -(activeT * 60) % 360
        crosshair.ImageColor3 = baseColor1
        centerCore.BackgroundColor3 = baseColor1:Lerp(Color3.new(1,1,1), lerpAlpha * 0.5)
        coreStroke.Color = baseColor2

        local rBase = 32 * (orbHovered and 0.6 or 1)
        for i = 1, 12 do
            local offset = (i - 1) * (math.pi * 2 / 4); local orb = orbs[i]
            if i <= 4 then
                local a = activeT * 1.5 + offset; local depth = math.sin(a)
                orb.Position = UDim2.new(0.5, math.cos(a) * rBase, 0.5, depth * (rBase * 0.2))
                orb.Size = UDim2.fromOffset(3.5 + (depth * 2.5), 3.5 + (depth * 2.5)); orb.ZIndex = depth > 0 and 106 or 102; orb.BackgroundColor3 = baseColor1
            elseif i <= 8 then
                local a = -activeT * 1.8 + offset; local depth = math.cos(a)
                orb.Position = UDim2.new(0.5, math.cos(a) * (rBase * 0.2), 0.5, math.sin(a) * rBase)
                orb.Size = UDim2.fromOffset(3.5 + (depth * 2.5), 3.5 + (depth * 2.5)); orb.ZIndex = depth > 0 and 106 or 102; orb.BackgroundColor3 = baseColor2
            else
                local a = activeT * 2.5 + offset; local depth = math.sin(a + math.pi/4)
                orb.Position = UDim2.new(0.5, math.sin(a) * rBase, 0.5, math.sin(a * 2) * (rBase * 0.5))
                orb.Size = UDim2.fromOffset(4 + (depth * 2), 4 + (depth * 2)); orb.BackgroundColor3 = Color3.new(1,1,1)
            end
        end

        sonarTimer = sonarTimer + dt
        if sonarTimer >= ((activeMode ~= nil) and 0.3 or 0.8) then
            sonarTimer = 0
            local ring = Instance.new("Frame", openBtn)
            ring.Size = UDim2.fromOffset(12, 12); ring.Position = UDim2.fromScale(0.5, 0.5); ring.AnchorPoint = Vector2.new(0.5, 0.5); ring.BackgroundTransparency = 1; ring.ZIndex = 101
            Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
            local rs = Instance.new("UIStroke", ring); rs.Color = baseColor1; rs.Thickness = 2
            local pSpeed = (activeMode ~= nil) and 0.8 or 1.2
            TweenService:Create(ring, TweenInfo.new(pSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(105, 105)}):Play()
            TweenService:Create(rs, TweenInfo.new(pSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Transparency = 1}):Play()
            task.delay(pSpeed, function() pcall(function() ring:Destroy() end) end)
        end
    end
end)

openBtn.MouseButton1Down:Connect(function() TweenService:Create(openBtnScale, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Scale = 0.85}):Play() end)
openBtn.MouseButton1Up:Connect(function() TweenService:Create(openBtnScale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.2), {Scale = 1.05}):Play() end)

minimizeBtn.MouseButton1Click:Connect(function()
    TweenService:Create(mainScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0}):Play()
    TweenService:Create(shadowScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0}):Play()
    task.wait(0.4)
    mainFrame.Visible = false; aura.Visible = false; shadowContainer.Visible = false; openBtnContainer.Visible = true; openBtnScale.Scale = 0
    TweenService:Create(openBtnScale, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play() 
end)

closeBtn.MouseButton1Click:Connect(function() stopBang(); gui:Destroy() end)

animateWaterfall(mainList)
sendNotif("👑 TXR GLASSMORPHISM", "Ultimate Premium UI Loaded!", 3)
