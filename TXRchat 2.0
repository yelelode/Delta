efStroke.Color = Colors.Primary
efStroke.Thickness = 1.2

local emojiScroll = Instance.new("ScrollingFrame", emojiFrame)
emojiScroll.Size = UDim2.new(1, -8, 1, -8)
emojiScroll.Position = UDim2.fromOffset(4, 4)
emojiScroll.BackgroundTransparency = 1
emojiScroll.ScrollBarThickness = 2
emojiScroll.CanvasSize = UDim2.new(0, 0, 2.5, 0)
emojiScroll.ZIndex = 31

local emojiGrid = Instance.new("UIGridLayout", emojiScroll)
emojiGrid.CellSize = UDim2.new(0, 26, 0, 26)
emojiGrid.CellPadding = UDim2.new(0, 3, 0, 3)

local emojiRaw = "😃😁😆😂🤣😎🫡🔥💀❤️🖤✨💯👑⚡⚠️🔒💬🍜🍕🚀🎉"
if utf8 and utf8.graphemes then
    for p, c in utf8.graphemes(emojiRaw) do
        local em = string.sub(emojiRaw, p, c)
        local btn = Instance.new("TextButton", emojiScroll)
        btn.Text = em
        btn.TextSize = 15
        btn.BackgroundTransparency = 1
        btn.ZIndex = 32
        btn.MouseButton1Click:Connect(function()
            chatInput.Text = chatInput.Text .. em
            chatInput:CaptureFocus()
        end)
    end
end

emojiBtn.MouseButton1Click:Connect(function()
    emojiFrame.Visible = not emojiFrame.Visible
end)

-- =========================================================
-- 🚀 DRAG & ANIMATION PHYSICS LOOP
-- =========================================================
local dragging = false
local dragStart = nil
local startPos = nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Link GitHub Orb Click to Restore Chat
task.spawn(function()
    while _G.TXR_ChatInstanceID == currentExecutionID and gui.Parent do
        if orbBtn and not orbBtn:GetAttribute("ChatHooked") then
            orbBtn:SetAttribute("ChatHooked", true)
            orbBtn.MouseButton1Click:Connect(function()
                if orbContainer then 
                    orbContainer.Visible = false 
                end
                mainFrame.Visible = true
                aura.Visible = true
                mainScale.Scale = 0.8
                TweenService:Create(mainScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
            end)
            break
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    local t = 0
    RunService.RenderStepped:Connect(function(dt)
        if _G.TXR_ChatInstanceID ~= currentExecutionID or not gui.Parent then return end
        t = t + dt
        if mainFrame.Visible then
            strokeGrad.Rotation = (t * 40) % 360
            local breath = (math.sin(t * 2.5) + 1) / 2
            aura.ImageTransparency = 0.6 + (breath * 0.1)

            local ledAlpha = (math.sin(t * 4) + 1) / 2
            ledDot.BackgroundTransparency = 0.1 + (ledAlpha * 0.5)
        end
    end)
end)

-- =========================================================
-- 📡 SEND MESSAGE (WITH COOLDOWN SHIELD)
-- =========================================================
local isSendingCooldown = false
sendMessageFunc = function(overrideText)
    local text = overrideText or chatInput.Text
    if text == "" or not text then return end
    if isSendingCooldown then return end

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then
        chatInput.Text = ""
        privateTarget = pMatch
        updateInputBar()
        addMessageToFeed("System", "DM mode locked with @" .. pMatch)
        return
    end

    local finalMsg = text
    if privateTarget then
        finalMsg = "( 🔐 " .. lp.Name .. " Private " .. privateTarget .. ") " .. text
    end

    displayBubble(lp.Name, text)
    if not overrideText then chatInput.Text = "" end

    isSendingCooldown = true
    sendBtn.BackgroundColor3 = Colors.SurfaceHover
    sendBtn.Text = "⏳"

    task.spawn(function()
        if req then
            local payload = HttpService:JSONEncode({
                user = lp.Name,
                msg = finalMsg,
                jobId = game.JobId
            })

            pcall(function()
                req({
                    Url = SERVER_URL .. "/send",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = payload
                })
            end)
        end

        task.wait(1.2)
        isSendingCooldown = false
        sendBtn.BackgroundColor3 = Colors.Primary
        sendBtn.Text = "➤"
    end)
end

sendBtn.MouseButton1Click:Connect(function() sendMessageFunc() end)
chatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessageFunc() end
end)

-- =========================================================
-- 📥 POLLING ENGINE & UNREAD PIPELINE
-- =========================================================
task.spawn(function()
    while _G.TXR_IsPolling and task.wait(0.5) do
        if req then
            local success, res = pcall(function()
                return req({
                    Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime),
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Roblox/WinInet" }
                })
            end)

            if success and res and res.StatusCode == 200 then
                local data = HttpService:JSONDecode(res.Body)

                if isInitialSync then
                    isInitialSync = false
                    if #data > 0 then
                        local startIndex = math.max(1, #data - 4)
                        for i = startIndex, #data do
                            local m = data[i]
                            if not m.hidden and m.msg ~= "Joined" then
                                addMessageToFeed(m.user, m.msg, nil, false)
                                updateLiveCounter(m.user)
                            end
                        end
                        lastSyncTime = data[#data].time
                    else
                        lastSyncTime = os.time()
                    end
                    continue
                end

                for _, m in ipairs(data) do
                    if m.time > lastSyncTime then
                        lastSyncTime = m.time
                        knownUsers[m.user:lower()] = m.user
                        updateLiveCounter(m.user)

                        if m.msg == "Joined" then
                            if m.user ~= lp.Name then
                                addJoinNotice(m.user)
                                playSFX("default")
                            end
                            continue
                        end

                        if m.hidden then continue end
                        if chatMode == "server" and m.jobId ~= game.JobId then continue end

                        local pSender, pTarget, pMsg = string.match(m.msg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                        if pSender and pTarget then
                            if lp.Name == pSender then
                                addMessageToFeed(m.user, pMsg, pTarget, true)
                            elseif lp.Name == pTarget then
                                addMessageToFeed(m.user, pMsg, pSender, false)
                                displayBubble(m.user, pMsg)
                                playSFX("dm")
                            end
                            continue
                        end

                        addMessageToFeed(m.user, m.msg, nil, false)

                        if m.user ~= lp.Name then
                            displayBubble(m.user, m.msg)
                            playSFX("default")
                        end
                    end
                end
            end
        end
    end
end)

-- Initial Handshake
task.spawn(function()
    if req then
        pcall(function()
            req({
                Url = SERVER_URL .. "/send", Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                Body = HttpService:JSONEncode({ user = lp.Name, msg = "Joined", jobId = game.JobId, hidden = false })
            })
        end)
    end
    addMessageToFeed("System", "TXR Hyperion Online! Minimize wired to GitHub Orb.")
end)
