local function getAssetThumb(id)
    return string.format("rbxthumb://type=Asset&id=%s&w=420&h=420", tostring(id))
end

local function crispText(element, overrideTransparency)
    local stroke = element:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", element)
    stroke.Color = Color3.new(0, 0, 0)
    stroke.Transparency = overrideTransparency or 0.1 -- Maximum contrast
    stroke.Thickness = 1.0 -- Clean sharp text
end

-- ⚡ CINETMATIC APPLE-STYLE SPRING HOVER
local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    local originalColor = btn.BackgroundColor3
    local originalTransparency = btn.BackgroundTransparency
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
        if btn.BackgroundTransparency < 1 then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.SurfaceHover, BackgroundTransparency = math.max(0, originalTransparency - 0.1)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
        if btn.BackgroundTransparency < 1 then
            TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = originalColor, BackgroundTransparency = originalTransparency}):Play()
        end
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {Scale = 0.95}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
    end)
end

local function playSFX(soundType)
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound")
            if soundType == "mention" or soundType == "dm" then
                s.SoundId = "rbxassetid://9114223177"
                s.Volume = 0.8
            elseif soundType == "meme" then
                s.SoundId = "rbxassetid://9069609268"
                s.Volume = 0.6
            elseif soundType == "swipe" then
                s.SoundId = "rbxassetid://6553245465"
                s.Volume = 0.3
            else
                s.SoundId = "rbxassetid://6518811702"
                s.Volume = 0.4
            end
            s.Parent = SoundService
            s:Play()
            task.delay(1.5, function() pcall(function() s:Destroy() end) end)
        end)
    end)
end

