local function createHeaderBtn(text, onClick)
    local b = Instance.new("TextButton", headerRightCluster)
    b.Size = UDim2.fromOffset(28, 24)
    b.BackgroundColor3 = Color3.fromRGB(15, 18, 22)
    b.BackgroundTransparency = 0.2 
    b.Text = text
    b.TextColor3 = Colors.Text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9.5
    b.AutoButtonColor = false
    b.ZIndex = 15
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local btnStr = Instance.new("UIStroke", b)
    btnStr.Thickness = 1
    btnStr.Color = Colors.PrimaryDark
    btnStr.Transparency = 0.4

    applySpringHover(b)
    b.MouseButton1Click:Connect(function()
        pcall(onClick)
    end)
    return b
end

