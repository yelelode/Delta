local function spawnSonar(pulseColor)
    if not openBtnContainer.Visible then return end
    local ring = Instance.new("Frame", openBtn)
    ring.Size = UDim2.fromOffset(12, 12)
    ring.Position = UDim2.fromScale(0.5, 0.5)
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.BackgroundTransparency = 1
    ring.ZIndex = 101
    Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
    
    local rs = Instance.new("UIStroke", ring)
    rs.Color = pulseColor
    rs.Thickness = 2
    rs.Transparency = 0
    
    local pulseSpeed = 1.0
    TweenService:Create(ring, TweenInfo.new(pulseSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(105, 105)}):Play()
    TweenService:Create(rs, TweenInfo.new(pulseSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Transparency = 1}):Play()
    
    task.delay(pulseSpeed, function()
        pcall(function() ring:Destroy() end)
    end)
end

