local swipeContainer = Instance.new("Frame", mainList)
swipeContainer.Size = UDim2.new(1, 0, 0, 42); swipeContainer.BackgroundColor3 = Colors.Surface; swipeContainer.BackgroundTransparency = 0.85
swipeContainer.ClipsDescendants = true; swipeContainer.LayoutOrder = getOrder(); swipeContainer.ZIndex = 7
Instance.new("UICorner", swipeContainer).CornerRadius = UDim.new(0, 8)

local leftArrow = Instance.new("TextLabel", swipeContainer)
leftArrow.Size = UDim2.new(0, 30, 1, 0); leftArrow.Position = UDim2.new(0, 5, 0, 0); leftArrow.BackgroundTransparency = 1
leftArrow.Text = "<"; leftArrow.TextColor3 = Colors.SubText; leftArrow.Font = Enum.Font.GothamMedium; leftArrow.TextSize = 16; leftArrow.ZIndex = 8
local rightArrow = Instance.new("TextLabel", swipeContainer)
rightArrow.Size = UDim2.new(0, 30, 1, 0); rightArrow.Position = UDim2.new(1, -35, 0, 0); rightArrow.BackgroundTransparency = 1
rightArrow.Text = ">"; rightArrow.TextColor3 = Colors.SubText; rightArrow.Font = Enum.Font.GothamMedium; rightArrow.TextSize = 16; rightArrow.ZIndex = 8

local swipeBtn = Instance.new("TextButton", swipeContainer)
swipeBtn.Size = UDim2.new(1, -60, 1, -8); swipeBtn.Position = UDim2.fromScale(0.5, 0.5); swipeBtn.AnchorPoint = Vector2.new(0.5, 0.5)
swipeBtn.BackgroundColor3 = Colors.ActiveTint; swipeBtn.Text = "🎭 ["..currentEmoteIndex.."/"..#EmoteList.."] " .. EmoteList[1].Name; swipeBtn.TextColor3 = Colors.Primary
swipeBtn.Font = Enum.Font.GothamBold; swipeBtn.TextSize = 12; swipeBtn.AutoButtonColor = false; swipeBtn.ZIndex = 9
swipeBtn.RichText = true
Instance.new("UICorner", swipeBtn).CornerRadius = UDim.new(0, 6)

local swipeScale = Instance.new("UIScale", swipeBtn); swipeScale.Scale = 1
local swipeStroke = Instance.new("UIStroke", swipeBtn); swipeStroke.Color = Colors.Primary; swipeStroke.Thickness = 1; swipeStroke.Transparency = 0.4; swipeStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

local draggingSwipe = false; local swipeStartX = 0
swipeBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSwipe = true; swipeStartX = input.Position.X
        TweenService:Create(swipeScale, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {Scale = 0.96}):Play()
        TweenService:Create(swipeBtn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.PrimaryDark, TextColor3 = Color3.new(1,1,1)}):Play()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingSwipe and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = input.Position.X - swipeStartX
        local moveOffset = math.clamp(deltaX, -100, 100)
        swipeBtn.Position = UDim2.new(0.5, moveOffset, 0.5, 0)
        if moveOffset > 35 then rightArrow.TextColor3 = Colors.Primary; leftArrow.TextColor3 = Colors.SubText
        elseif moveOffset < -35 then leftArrow.TextColor3 = Colors.Primary; rightArrow.TextColor3 = Colors.SubText
        else leftArrow.TextColor3 = Colors.SubText; rightArrow.TextColor3 = Colors.SubText end
    end
end)

local function switchEmoteVisuals()
    local currentStyle = EmoteList[currentEmoteIndex]
    swipeBtn.Text = string.format("🎭 [%d/%d] %s", currentEmoteIndex, #EmoteList, currentStyle.Name)
    local flashTween = TweenService:Create(swipeBtn, TweenInfo.new(0.15), {BackgroundColor3 = Colors.Purple, TextColor3 = Color3.new(1,1,1)})
    flashTween:Play()
    flashTween.Completed:Connect(function() TweenService:Create(swipeBtn, TweenInfo.new(0.3), {BackgroundColor3 = Colors.ActiveTint, TextColor3 = Colors.Primary}):Play() end)
    if activeMode then playAnim() end
    sendNotif("🎭 EMOTE SWITCHED", currentStyle.Name, 1.5)
end

swipeBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not draggingSwipe then return end
        draggingSwipe = false
        local deltaX = input.Position.X - swipeStartX
        if deltaX > 40 then currentEmoteIndex = (currentEmoteIndex % #EmoteList) + 1; switchEmoteVisuals()
        elseif deltaX < -40 then currentEmoteIndex = currentEmoteIndex - 1; if currentEmoteIndex < 1 then currentEmoteIndex = #EmoteList end switchEmoteVisuals() end
        leftArrow.TextColor3 = Colors.SubText; rightArrow.TextColor3 = Colors.SubText
        TweenService:Create(swipeBtn, TweenInfo.new(0.65, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Position = UDim2.fromScale(0.5, 0.5)}):Play()
        TweenService:Create(swipeScale, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()
        TweenService:Create(swipeBtn, TweenInfo.new(0.3), {BackgroundColor3 = Colors.ActiveTint, TextColor3 = Colors.Primary}):Play()
    end
end)

-- =========================================================
-- 🔥 LINKED TOGGLES (NATIVE SPECTATE ADDED)
-- =========================================================
local function createToggle(name, callback)
    local btn = createMainBtn(name, false)
    local state = false
    local accent = btn:FindFirstChild("Accent")
    local glow = btn:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", btn)
    glow.Color = Colors.Primary; glow.Thickness = 1.2; glow.Transparency = 0.85
    glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

    local function updateState(newState)
        state = newState
        local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
        if state then
            btn:SetAttribute("BaseColor", Colors.ActiveTint)
            TweenService:Create(btn, tInfo, {BackgroundColor3 = Colors.ActiveTint, TextColor3 = Colors.Primary, BackgroundTransparency = 0.4}):Play()
            TweenService:Create(accent, tInfo, {Size = UDim2.new(0, 3, 0.6, 0)}):Play()
            TweenService:Create(glow, TweenInfo.new(0.3), {Transparency = 0.35}):Play()
        else
            btn:SetAttribute("BaseColor", Colors.Surface)
            TweenService:Create(btn, tInfo, {BackgroundColor3 = Colors.Surface, TextColor3 = Colors.Text, BackgroundTransparency = 0.9}):Play()
            TweenService:Create(accent, tInfo, {Size = UDim2.new(0, 0, 0, 0)}):Play()
            TweenService:Create(glow, TweenInfo.new(0.3), {Transparency = 0.85}):Play()
        end
    end

    btn.MouseButton1Click:Connect(function()
        updateState(not state)
        callback(state)
    end)
    return updateState
end

local setClassicState, setHeadState, setSpectateState

setClassicState = createToggle("🔞 Classic Back Bang", function(v)
    if v then 
        if activeMode == "Head" then setHeadState(false) end
        if not startBang("Normal") then setClassicState(false) end 
    else 
        if activeMode == "Normal" then stopBang() end 
    end
end)

setHeadState = createToggle("🧠 Head Bang (Face)", function(v)
    if v then 
        if activeMode == "Normal" then setClassicState(false) end
        if not startBang("Head") then setHeadState(false) end 
    else 
        if activeMode == "Head" then stopBang() end 
    end
end)

setSpectateState = createToggle("👁️ Spectate Camera", function(v)
    SpectateFaceCam = v
    if not v then
        Camera.CameraType = Enum.CameraType.Custom
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then 
            Camera.CameraSubject = LP.Character.Humanoid 
        end
    else
        local TargetChar = PlayerSelected and PlayerSelected.Character
        local TargetHum = TargetChar and TargetChar:FindFirstChild("Humanoid")
        if TargetHum then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = TargetHum
        else
            sendNotif("⚠️ ERROR", "Select Target First / Target Not Found")
            setSpectateState(false)
        end
    end
end)

-- Continuous native spectate lock based on V18.26 logic, adapted for PlayerSelected
RunService.RenderStepped:Connect(function()
    if SpectateFaceCam then
        local targetChar = PlayerSelected and PlayerSelected.Character
        local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")
        if targetHum and Camera.CameraSubject ~= targetHum then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = targetHum
        elseif not targetHum then
            Camera.CameraType = Enum.CameraType.Custom
            if LP.Character and LP.Character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = LP.Character.Humanoid
            end
        end
    end
end)

