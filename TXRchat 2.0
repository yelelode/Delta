local function createHeaderBtn(icon, posX, onClick)
    local b = Instance.new("TextButton", header)
    b.Size = UDim2.fromOffset(24, 22)
    b.Position = UDim2.new(1, posX, 0.5, -11)
    b.BackgroundColor3 = Colors.Surface
    b.BackgroundTransparency = 0.45
    b.Text = icon
    b.TextColor3 = Colors.Text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.AutoButtonColor = false
    b.ZIndex = 15
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
    applySpringHover(b)
    b.MouseButton1Click:Connect(function()
        pcall(onClick)
    end)
    return b
end

createHeaderBtn("🎨", -166, function()
    currentThemeIdx = (currentThemeIdx % #Themes) + 1
    local th = Themes[currentThemeIdx]
    Colors.Primary = th.Primary
    Colors.PrimaryDark = th.PrimaryDark
    Colors.Purple = th.Accent
    Colors.ActiveTint = th.ActiveTint

    strokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, th.Primary),
        ColorSequenceKeypoint.new(0.5, th.Accent),
        ColorSequenceKeypoint.new(1, th.Primary)
    })
    aura.ImageColor3 = th.Primary
    headerTitle.TextColor3 = th.Primary
    coreGlow.ImageColor3 = th.Primary
    eventGlow.ImageColor3 = th.Accent
end)

local ghostBtn
ghostBtn = createHeaderBtn("👁️", -138, function()
    if ghostDebounce then return end
    ghostDebounce = true
    task.delay(0.4, function() ghostDebounce = false end)

    isGhostMode = not isGhostMode
    if isGhostMode then
        TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {BackgroundTransparency = 0.82}):Play()
        TweenService:Create(aura, TweenInfo.new(0.35), {ImageTransparency = 0.92}):Play()
        ghostBtn.BackgroundColor3 = Colors.ActiveTint
        ghostBtn.TextColor3 = Colors.Primary
        mainStroke.Transparency = 0.5
    else
        TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {BackgroundTransparency = 0.1}):Play()
        TweenService:Create(aura, TweenInfo.new(0.35), {ImageTransparency = 0.65}):Play()
        ghostBtn.BackgroundColor3 = Colors.Surface
        ghostBtn.TextColor3 = Colors.Text
        mainStroke.Transparency = 0.25
    end
end)

