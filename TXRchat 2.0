-- =========================================================
-- 💬 MESSAGE PIPELINE
-- =========================================================
local function updateLiveCounter(username)
    activeUsersTable[username:lower()] = os.time()
    local count = 0
    local now = os.time()
    for u, t in pairs(activeUsersTable) do
        if now - t < 300 then
            count = count + 1
        else
            activeUsersTable[u] = nil
        end
    end
    liveText.Text = string.format("%d Active", math.max(1, count))
end

-- ⚡ VIP ANIMATED WELCOME SYSTEM
local function addJoinNotice(username)
    local pill = Instance.new("Frame", messageFeed)
    pill.Size = UDim2.new(1, 0, 0, 28)
    pill.BackgroundColor3 = Colors.Surface
    pill.BackgroundTransparency = 0.15
    pill.ZIndex = 9
    Instance.new("UICorner", pill).CornerRadius = UDim.new(0, 8)
    
    local s = Instance.new("UIStroke", pill)
    s.Color = Color3.fromRGB(50, 255, 140)
    s.Thickness = 1.0
    s.Transparency = 0.6

    local lbl = Instance.new("TextLabel", pill)
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.RichText = true
    lbl.Text = string.format("🎉 <font color='#32FF8C'>@%s</font> <i>dropped into the Titan Network</i>", sanitizeXml(username))
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.ZIndex = 10
    crispText(lbl, 0.4)

    local scale = Instance.new("UIScale", pill)
    scale.Scale = 0.5
    TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()

    task.defer(function()
        local maxOffset = math.max(0, messageFeed.AbsoluteCanvasSize.Y - messageFeed.AbsoluteWindowSize.Y)
        if maxOffset - messageFeed.CanvasPosition.Y < 80 then
            messageFeed.CanvasPosition = Vector2.new(0, maxOffset)
        end
    end)
end

local MAX_MESSAGES = 60
local function addMessageToFeed(rawUserName, msg, privateUserTarget, isPrivateSender, msgJobId, scopeType)
    local memeIdMatch = msg:match("%[MEME:(%d+)%]")

    local actualUsername, dispName = rawUserName:match("^(.-)::(.*)$")
    if not actualUsername then
        actualUsername = rawUserName
        local targetPlr = Players:FindFirstChild(rawUserName)
        dispName = targetPlr and targetPlr.DisplayName or rawUserName
    end

    local isMentioned = string.find(string.lower(msg), string.lower(lp.Name), 1, true) or string.find(string.lower(msg), string.lower(lp.DisplayName), 1, true)
    local isAdminUser = Admin[actualUsername:lower()] == true
    local badgeProfile = BadgePresets[currentOwnerBadge] or BadgePresets["OWNER"]

    local count = 0
    for _, child in ipairs(messageFeed:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then 
            count = count + 1 
        end
    end
    if count >= MAX_MESSAGES then
        for _, child in ipairs(messageFeed:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() break end
        end
    end

    -- ⚡ V6 FIXED: Frame Wrapping prevents massive stretching
    local cardRoot = Instance.new("Frame", messageFeed)
    cardRoot.Size = UDim2.new(1, 0, 0, 0) 
    cardRoot.AutomaticSize = Enum.AutomaticSize.Y
    cardRoot.BackgroundTransparency = 1
    cardRoot.ZIndex = 9
    cardRoot:SetAttribute("ChatScope", scopeType or "global")
    cardRoot:SetAttribute("JobId", msgJobId or game.JobId)

    local replyIcon = Instance.new("TextLabel", cardRoot)
    replyIcon.Size = UDim2.fromOffset(40, 40)
    replyIcon.Position = UDim2.new(1, -45, 0.5, -20)
    replyIcon.BackgroundTransparency = 1
    replyIcon.Text = "↩️"
    replyIcon.TextSize = 18
    replyIcon.ZIndex = 8
    
    local dmIcon = Instance.new("TextLabel", cardRoot)
    dmIcon.Size = UDim2.fromOffset(40, 40)
    dmIcon.Position = UDim2.new(0, 5, 0.5, -20)
    dmIcon.BackgroundTransparency = 1
    dmIcon.Text = "🔐"
    dmIcon.TextSize = 18
    dmIcon.ZIndex = 8

    -- ⚡ TRUE OLED BLACK MESSAGE CARD
    local card = Instance.new("Frame", cardRoot)
    card.Name = "SwipeWrapper"
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = Color3.fromRGB(8, 10, 14) -- Deep Space Gray/Black
    card.BackgroundTransparency = 0.05 -- Solid
    card.ClipsDescendants = false
    card.ZIndex = 9
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

    local padFix = Instance.new("UIPadding", card)
    padFix.PaddingBottom = UDim.new(0, 10)
    padFix.PaddingTop = UDim.new(0, 2)

    if chatMode == "server" then
        if scopeType == "global" or (msgJobId and msgJobId ~= "" and msgJobId ~= game.JobId) then
            cardRoot.Visible = false
        end
    else
        if scopeType == "server" then
            cardRoot.Visible = false
        end
    end

    local cardScale = Instance.new("UIScale", cardRoot)
    cardScale.Scale = 0.85
    cardRoot.Position = UDim2.new(0, -20, 0, 0)
    TweenService:Create(cardScale, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Scale = 1}):Play()
    TweenService:Create(cardRoot, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

    local accentStrip = Instance.new("Frame", card)
    accentStrip.Size = UDim2.new(0, 3, 1, -12)
    accentStrip.Position = UDim2.new(0, 5, 0, 6)
    accentStrip.BorderSizePixel = 0
    accentStrip.BackgroundColor3 = Color3.new(1,1,1)
    accentStrip.ZIndex = 10
    Instance.new("UICorner", accentStrip).CornerRadius = UDim.new(1, 0)
    
    local stripGrad = Instance.new("UIGradient", accentStrip)
    stripGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, isMentioned and Colors.MentionGold or (privateUserTarget and Colors.Purple or Colors.Primary)),
        ColorSequenceKeypoint.new(1, isMentioned and Color3.fromRGB(255,180,0) or (privateUserTarget and Colors.PrimaryDark or Colors.PrimaryDark))
    })
    stripGrad.Rotation = 90

    local cardStroke = Instance.new("UIStroke", card)
    cardStroke.Thickness = 1.0
    cardStroke.Transparency = isMentioned and 0.15 or 0.6
    cardStroke.Color = isMentioned and Colors.MentionGold or Colors.SurfaceHover

    local avatarImg = Instance.new("ImageLabel", card)
    avatarImg.Size = UDim2.fromOffset(30, 30)
    avatarImg.Position = UDim2.fromOffset(16, 10)
    avatarImg.BackgroundColor3 = Colors.Background
    avatarImg.BackgroundTransparency = 0.5
    avatarImg.ZIndex = 11
    Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)
    
    local avStroke = Instance.new("UIStroke", avatarImg)
    avStroke.Thickness = 1.2
    avStroke.Transparency = 0.2
    avStroke.Color = isAdminUser and Colors.Primary or Colors.SurfaceHover
    
    if isAdminUser then
        local avGrad = Instance.new("UIGradient", avStroke)
        avGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Colors.Primary),
            ColorSequenceKeypoint.new(1, Colors.Purple)
        })
        avGrad.Rotation = 45
    end

    task.spawn(function()
        local targetPlr = Players:FindFirstChild(actualUsername)
        local uId = targetPlr and targetPlr.UserId or userIdCache[actualUsername:lower()]
        if not uId then
            pcall(function()
                uId = Players:GetUserIdFromNameAsync(actualUsername)
                userIdCache[actualUsername:lower()] = uId
            end)
        end
        if uId and avatarImg and avatarImg.Parent then
            avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", uId)
        end
    end)

    local cardContent = Instance.new("Frame", card)
    cardContent.Size = UDim2.new(1, -56, 0, 0)
    cardContent.Position = UDim2.fromOffset(56, 10)
    cardContent.AutomaticSize = Enum.AutomaticSize.Y
    cardContent.BackgroundTransparency = 1
    cardContent.ZIndex = 11

    local ccLayout = Instance.new("UIListLayout", cardContent)
    ccLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ccLayout.Padding = UDim.new(0, 4)

    local headerRow = Instance.new("Frame", cardContent)
    headerRow.Size = UDim2.new(1, 0, 0, 18)
    headerRow.BackgroundTransparency = 1
    headerRow.LayoutOrder = 1
    headerRow.ZIndex = 11

    local hLayout = Instance.new("UIListLayout", headerRow)
    hLayout.FillDirection = Enum.FillDirection.Horizontal
    hLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    hLayout.Padding = UDim.new(0, 6)
    hLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local timeLbl = Instance.new("TextLabel", headerRow)
    timeLbl.AutomaticSize = Enum.AutomaticSize.X
    timeLbl.Size = UDim2.new(0, 0, 1, 0)
    timeLbl.BackgroundTransparency = 1
    timeLbl.Text = string.format("[%s]", os.date("%H:%M"))
    timeLbl.TextColor3 = Color3.fromRGB(110, 125, 145)
    timeLbl.Font = Enum.Font.GothamBold
    timeLbl.TextSize = 10.5
    timeLbl.LayoutOrder = 1
    timeLbl.ZIndex = 12
    crispText(timeLbl, 0.6)

    if privateUserTarget then
        local dmLbl = Instance.new("TextLabel", headerRow)
        dmLbl.AutomaticSize = Enum.AutomaticSize.X
        dmLbl.Size = UDim2.new(0, 0, 1, 0)
        dmLbl.BackgroundTransparency = 1
        dmLbl.RichText = true
        dmLbl.Text = isPrivateSender and ("[To @" .. sanitizeXml(privateUserTarget) .. "]") or ("[From @" .. sanitizeXml(privateUserTarget) .. "]")
        dmLbl.TextColor3 = Colors.Purple
        dmLbl.Font = Enum.Font.GothamBold
        dmLbl.TextSize = 10.5
        dmLbl.LayoutOrder = 2
        dmLbl.ZIndex = 12
        crispText(dmLbl, 0.5)
    end

    if isAdminUser then
        local tagWidth = TextService:GetTextSize(badgeProfile.Title, 11, Enum.Font.GothamBlack, Vector2.new(1000, 20)).X + 4
        
        local badgeHost = Instance.new("Frame", headerRow)
        badgeHost.Size = UDim2.fromOffset(tagWidth, 18)
        badgeHost.BackgroundTransparency = 1
        badgeHost.BorderSizePixel = 0
        badgeHost.LayoutOrder = 3
        badgeHost.ZIndex = 13

        local badgeGlow = Instance.new("TextLabel", badgeHost)
        badgeGlow.Size = UDim2.fromScale(1, 1)
        badgeGlow.BackgroundTransparency = 1
        badgeGlow.BorderSizePixel = 0
        badgeGlow.Text = badgeProfile.Title
        badgeGlow.TextColor3 = Color3.fromRGB(255, 255, 255)
        badgeGlow.TextTransparency = 0.50
        badgeGlow.Font = Enum.Font.GothamBlack
        badgeGlow.TextSize = 11
        badgeGlow.ZIndex = 13

        local glowStroke = Instance.new("UIStroke", badgeGlow)
        glowStroke.Thickness = 1.0
        glowStroke.Transparency = 0.55
        glowStroke.Color = Color3.fromRGB(255, 255, 255)

        local badgeLabel = Instance.new("TextLabel", badgeHost)
        badgeLabel.Size = UDim2.fromScale(1, 1)
        badgeLabel.BackgroundTransparency = 1
        badgeLabel.BorderSizePixel = 0
        badgeLabel.Text = badgeProfile.Title
        badgeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        badgeLabel.Font = Enum.Font.GothamBlack
        badgeLabel.TextSize = 11
        badgeLabel.ZIndex = 14

        local bStroke = Instance.new("UIStroke", badgeLabel)
        bStroke.Thickness = 0.8
        bStroke.Color = Color3.fromRGB(0, 0, 0)
        bStroke.Transparency = 0.3

        local badgeShine = Instance.new("TextLabel", badgeHost)
        badgeShine.Size = UDim2.fromScale(1, 1)
        badgeShine.BackgroundTransparency = 1
        badgeShine.BorderSizePixel = 0
        badgeShine.Text = badgeProfile.Title
        badgeShine.TextColor3 = Color3.fromRGB(255, 255, 255)
        badgeShine.Font = Enum.Font.GothamBlack
        badgeShine.TextSize = 11
        badgeShine.ZIndex = 75

        local shineGrad = Instance.new("UIGradient", badgeShine)
        shineGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.48, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 255, 255))
        })
        shineGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0.0, 1),
            NumberSequenceKeypoint.new(0.45, 1),
            NumberSequenceKeypoint.new(0.5, 0.05),
            NumberSequenceKeypoint.new(0.55, 1),
            NumberSequenceKeypoint.new(1.0, 1)
        })

        local textGrad = Instance.new("UIGradient", badgeLabel)
        textGrad.Color = ColorSequence.new(badgeProfile.Colors)
        local glowGrad = Instance.new("UIGradient", badgeGlow)
        glowGrad.Color = ColorSequence.new(badgeProfile.Colors)
        local strokeGradGlow = Instance.new("UIGradient", glowStroke)
        strokeGradGlow.Color = ColorSequence.new(badgeProfile.Colors)

        table.insert(activeBadgesList, {
            textGrad = textGrad, glowGrad = glowGrad, strokeGradGlow = strokeGradGlow,
            shineGrad = shineGrad, badgeGlow = badgeGlow, glowStroke = glowStroke,
            speed = badgeProfile.Speed or 1.15
        })
    end

    local nameLbl = Instance.new("TextLabel", headerRow)
    nameLbl.AutomaticSize = Enum.AutomaticSize.X
    nameLbl.Size = UDim2.new(0, 0, 1, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.RichText = true
    nameLbl.Text = sanitizeXml(dispName)
    nameLbl.TextColor3 = (currentThemeIdx == 2 and Color3.fromRGB(255, 45, 85) or Colors.Primary)
    nameLbl.Font = Enum.Font.GothamBlack
    nameLbl.TextSize = 12
    nameLbl.LayoutOrder = 4
    nameLbl.ZIndex = 12
    crispText(nameLbl)

    if actualUsername ~= dispName and actualUsername ~= "System" then
        local handleLbl = Instance.new("TextLabel", headerRow)
        handleLbl.AutomaticSize = Enum.AutomaticSize.X
        handleLbl.Size = UDim2.new(0, 0, 1, 0)
        handleLbl.BackgroundTransparency = 1
        handleLbl.Text = "@" .. sanitizeXml(actualUsername) .. ":"
        handleLbl.TextColor3 = Colors.SubText
        handleLbl.Font = Enum.Font.GothamMedium
        handleLbl.TextSize = 10
        handleLbl.LayoutOrder = 5
        handleLbl.ZIndex = 12
        crispText(handleLbl, 0.6)
    else
        nameLbl.Text = sanitizeXml(dispName) .. ":"
    end

    if memeIdMatch then
        local memeHolder = Instance.new("Frame", cardContent)
        memeHolder.Size = UDim2.new(1, 0, 0, 94)
        memeHolder.BackgroundTransparency = 1
        memeHolder.LayoutOrder = 2
        memeHolder.ZIndex = 12

        local memeImg = Instance.new("ImageLabel", memeHolder)
        memeImg.Size = UDim2.fromOffset(90, 90)
        memeImg.Position = UDim2.fromOffset(0, 2)
        memeImg.BackgroundColor3 = Colors.Background
        memeImg.BackgroundTransparency = 0.3
        memeImg.Image = getAssetThumb(memeIdMatch)
        memeImg.ScaleType = Enum.ScaleType.Fit
        memeImg.ZIndex = 12
        Instance.new("UICorner", memeImg).CornerRadius = UDim.new(0, 8)
        local mStroke = Instance.new("UIStroke", memeImg)
        mStroke.Color = Colors.PrimaryDark
        mStroke.Thickness = 1.0
    else
        local bodyTxt = Instance.new("TextLabel", cardContent)
        bodyTxt.Name = "MsgContent"
        bodyTxt.Size = UDim2.new(1, 0, 0, 0)
        bodyTxt.AutomaticSize = Enum.AutomaticSize.Y
        bodyTxt.BackgroundTransparency = 1
        -- ⚡ TEXT SIZE INCREASED FOR BETTER READABILITY
        bodyTxt.TextColor3 = Color3.fromRGB(250, 252, 255)
        bodyTxt.Font = Enum.Font.GothamMedium 
        bodyTxt.TextSize = 13.5 
        bodyTxt.TextWrapped = true
        bodyTxt.TextXAlignment = Enum.TextXAlignment.Left
        bodyTxt.RichText = true
        bodyTxt.LayoutOrder = 2
        bodyTxt.ZIndex = 12
        bodyTxt.Text = sanitizeXml(msg)
        crispText(bodyTxt)
    end

    if isMentioned and actualUsername ~= lp.Name then
        playSFX("mention")
    elseif memeIdMatch and actualUsername ~= lp.Name then
        playSFX("meme")
    end

    -- ⚡ SWIPE-TO-DM / SWIPE-TO-REPLY ENGINE
    local dragStart = nil
    local isDragging = false
    local hasTriggeredSwipe = false

    card.InputBegan:Connect(function(input)
        if actualUsername == lp.Name or actualUsername == "System" then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = input.Position.X
            isDragging = true
            hasTriggeredSwipe = false
            TweenService:Create(cardScale, TweenInfo.new(0.1), {Scale = 0.98}):Play()
        end
    end)

    card.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position.X - dragStart
            local clampedX = math.clamp(delta, -80, 80)
            card.Position = UDim2.new(0, clampedX, 0, 0)
            
            if clampedX > 50 and not hasTriggeredSwipe then
                hasTriggeredSwipe = true
                playSFX("swipe")
                spawnUIParticles(cardRoot, UDim2.new(0, 20, 0.5, 0), Colors.Purple, 6)
            elseif clampedX < -50 and not hasTriggeredSwipe then
                hasTriggeredSwipe = true
                playSFX("swipe")
                spawnUIParticles(cardRoot, UDim2.new(1, -20, 0.5, 0), Colors.Primary, 6)
            end
        end
    end)

    card.InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and isDragging then
            isDragging = false
            TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play()
            
            local finalDelta = card.Position.X.Offset
            TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

            if finalDelta > 50 then
                privateTarget = actualUsername
                updateInputBar()
                playSFX("dm")
            elseif finalDelta < -50 then
                chatInput.Text = "@" .. actualUsername .. " "
                chatInput:CaptureFocus()
            elseif math.abs(finalDelta) < 5 then
                for _, c in ipairs(actionMenu:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                createActionBtn("COPY", Colors.Text, function()
                    pcall(function() setClip(memeIdMatch and ("ID: " .. memeIdMatch) or msg) end)
                    spawnUIParticles(cardRoot, UDim2.new(0.5, 0, 0.5, 0), Colors.Primary, 10)
                end)
                createActionBtn("TP", Colors.MentionGold, function()
                    local targetPlr = Players:FindFirstChild(actualUsername)
                    if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        lp.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame
                    end
                end)
                createActionBtn("VIEW", Colors.PrimaryDark, function()
                    local targetPlr = Players:FindFirstChild(actualUsername)
                    if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("Humanoid") then
                        Camera.CameraSubject = targetPlr.Character.Humanoid
                    end
                end)
                local cardPos = card.AbsolutePosition - mainFrame.AbsolutePosition
                actionMenu.Position = UDim2.fromOffset(math.clamp(cardPos.X + 25, 10, 180), math.clamp(cardPos.Y - 24, 30, 280))
                actionMenu.Visible = true
            end
        end
    end)

    task.defer(function()
        local maxOffset = math.max(0, messageFeed.AbsoluteCanvasSize.Y - messageFeed.AbsoluteWindowSize.Y)
        if maxOffset - messageFeed.CanvasPosition.Y < 90 then
            messageFeed.CanvasPosition = Vector2.new(0, maxOffset)
        else
            jumpBottomBtn.Visible = true
        end
    end)
end

