local function refreshTargetList()
    for _, c in ipairs(targetScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local btn = Instance.new("TextButton", targetScroll)
            btn.Size = UDim2.new(1, 0, 0, 36); btn.BackgroundColor3 = (PlayerSelected == p) and Colors.ActiveTint or Colors.Surface; btn.BackgroundTransparency = (PlayerSelected == p) and 0.4 or 0.9
            btn.Text = "    " .. p.DisplayName .. " | @" .. p.Name; btn.TextColor3 = (PlayerSelected == p) and Colors.Primary or Colors.Text
            btn.Font = Enum.Font.GothamMedium; btn.TextSize = 11; btn.TextXAlignment = Enum.TextXAlignment.Left; btn.LayoutOrder = getOrder(); btn.ZIndex = 23
            btn.RichText = true
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8); applySmartHover(btn, nil)
            Instance.new("UIStroke", btn).Color = Colors.Primary; btn:FindFirstChildOfClass("UIStroke").Transparency = 0.85

            local accent = Instance.new("Frame", btn)
            accent.Size = (PlayerSelected == p) and UDim2.new(0, 3, 0.6, 0) or UDim2.new(0, 0, 0, 0); accent.Position = UDim2.new(0, 0, 0.5, 0); accent.AnchorPoint = Vector2.new(0, 0.5)
            accent.BackgroundColor3 = Colors.Primary; accent.BorderSizePixel = 0; Instance.new("UICorner", accent).CornerRadius = UDim.new(1,0)

            btn.MouseButton1Click:Connect(function()
                if (p.UserId == CREATOR_USER_ID or p.UserId == NINA_USER_ID) and LP.UserId ~= CREATOR_USER_ID then 
                    triggerBanTrap() 
                    return 
                end
                PlayerSelected = p; targetMenuBtn.Text = "   👥 Target: @" .. p.Name; sendNotif("🎯 TARGET SET", p.DisplayName)
                TweenService:Create(targetMenu, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.fromScale(1.2, 0)}):Play()
                mainList.Visible = true; animateWaterfall(mainList); if activeMode then startBang(activeMode) end
            end)
        end
    end
end
