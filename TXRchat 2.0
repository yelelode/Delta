local function clickFlash(btn)
    local ripple = Instance.new("Frame", btn)
    ripple.BackgroundColor3 = Color3.new(1, 1, 1)
    ripple.BackgroundTransparency = 0.5
    ripple.BorderSizePixel = 0
    ripple.Position = UDim2.fromScale(0.5, 0.5)
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.ZIndex = btn.ZIndex + 2
    Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)
    
    local originalClips = btn.ClipsDescendants
    btn.ClipsDescendants = true
    
    TweenService:Create(ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(btn.AbsoluteSize.X * 1.5, btn.AbsoluteSize.X * 1.5),
        BackgroundTransparency = 1
    }):Play()
    Debris:AddItem(ripple, 0.5)
    task.delay(0.5, function() btn.ClipsDescendants = originalClips end)
end

-- =========================================================
-- 🧠 STATE VARIABLES & PERFECT MATH ENGINE
-- =========================================================
local PlayerSelected = nil
local BangDistance = 2.5
local BangSpeed = 14
local HeadHeightOffset = 1.0
local AngleOffset = 0
local currentTrack = nil
local bangConnection, noclipConnection, antiVoidProtectionConnection, targetCharConnection
local activeMode = nil
local SpectateFaceCam = false

local EmoteList = {
    {Name = "Michael Myers", ID = "rbxassetid://115343850901807"},
    {Name = "Style 2 (Thumka)", ID = "rbxassetid://91657494615033"},
    {Name = "Style 3 (Hard)", ID = "rbxassetid://118483960185564"},
    {Name = "Style 4 (Fast)", ID = "rbxassetid://126627617294709"},
    {Name = "Style 5 (New)", ID = "rbxassetid://106448400820152"} 
}
local currentEmoteIndex = 1

local function spoofNetwork(part)
    if not part then return end
    pcall(function()
        if sethiddenproperty then sethiddenproperty(part, "NetworkIsSleeping", false) end
        if setsimulationradius then setsimulationradius(math.huge, math.huge) end
    end)
end

local function playAnim()
    pcall(function()
        local myChar = LP.Character
        local currentHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if currentHum then
            secureHumanoid(currentHum)
            if currentTrack then currentTrack:Stop() end
            local anim = Instance.new("Animation")
            anim.AnimationId = EmoteList[currentEmoteIndex].ID
            currentTrack = currentHum:LoadAnimation(anim)
            currentTrack.Looped = true
            currentTrack:Play()
            currentTrack:AdjustSpeed(math.clamp(BangSpeed / 9, 0.5, 4))
        end
    end)
end

local function stopBang()
    if bangConnection then bangConnection:Disconnect(); bangConnection = nil end
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    if antiVoidProtectionConnection then antiVoidProtectionConnection:Disconnect(); antiVoidProtectionConnection = nil end
    if targetCharConnection then targetCharConnection:Disconnect(); targetCharConnection = nil end
    if currentTrack then pcall(function() currentTrack:Stop() end); currentTrack = nil end
    pcall(function()
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            LP.Character.Humanoid.PlatformStand = false
            LP.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            if not SpectateFaceCam then
                Camera.CameraType = Enum.CameraType.Custom
                Camera.CameraSubject = LP.Character.Humanoid
            end
        end
    end)
    activeMode = nil
end

LP.CharacterAdded:Connect(function(newChar)
    Char = newChar
    Humanoid = newChar:WaitForChild("Humanoid")
    HRP = newChar:WaitForChild("HumanoidRootPart")
    secureHumanoid(Humanoid)
    if activeMode then task.wait(0.2); playAnim() end
end)

local startBang

local function listenToTargetReset()
    if targetCharConnection then targetCharConnection:Disconnect(); targetCharConnection = nil end
    if PlayerSelected then
        targetCharConnection = PlayerSelected.CharacterAdded:Connect(function(newTargetChar)
            if activeMode then
                task.spawn(function()
                    newTargetChar:WaitForChild("HumanoidRootPart", 10)
                    newTargetChar:WaitForChild("Humanoid", 10)
                    task.wait(0.2)
                    if activeMode then startBang(activeMode) end
                end)
            end
        end)
    end
end

startBang = function(mode)
    if not PlayerSelected then sendNotif("⚠️ ERROR", "Select target first."); return false end
    if PlayerSelected == LP then sendNotif("⚠️ ERROR", "Cannot select self."); return false end

    local TargetChar = PlayerSelected.Character
    local TargetHRP = TargetChar and TargetChar:FindFirstChild("HumanoidRootPart")
    local TargetHum = TargetChar and TargetChar:FindFirstChild("Humanoid")
    if not TargetHRP or not TargetHum or TargetHum.Health <= 0 then
        sendNotif("⚠️ WAITING", "Target currently dead, awaiting respawn...")
    end

    stopBang()
    activeMode = mode
    playAnim()
    listenToTargetReset()

    antiVoidProtectionConnection = RunService.Heartbeat:Connect(function()
        if not activeMode then return end
        local myChar = LP.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHum then
            secureHumanoid(myHum)
            if myHum.Health < 100 and myHum.Health > 0 then pcall(function() myHum.Health = 100 end) end
        end
        if myHRP and (myHRP.Position.Y > 20000 or myHRP.Position.Y < -5000) then
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    noclipConnection = RunService.Stepped:Connect(function()
        if not activeMode then return end
        local myChar = LP.Character
        if myChar then
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if myHum and myHum.Sit then myHum.Sit = false end
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch = false
                    part.CanQuery = false
                end
            end
        end
    end)

    local stepSignal = RunService.PreSimulation or RunService.RenderStepped

    bangConnection = stepSignal:Connect(function(deltaTime)
        if not activeMode then return end

        local dt = (type(deltaTime) == "number" and deltaTime > 0) and deltaTime or 0.016
        local tChar = PlayerSelected and PlayerSelected.Character
        
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHead = tChar and (tChar:FindFirstChild("Head") or tHrp)
        local tHum = tChar and tChar:FindFirstChild("Humanoid")
        
        local myChar = LP.Character
        local currentHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if not tHrp or not tHum or tHum.Health <= 0 or not currentHRP or not tHead then return end

        spoofNetwork(currentHRP)

        local t = os.clock() * BangSpeed
        local wave = (math.sin(t) + 1) / 2
        
        local targetVel = tHrp.AssemblyLinearVelocity
        local leadFactor = (targetVel.Magnitude > 0.5) and 2.4 or 1.0
        local pingOffset = targetVel * (dt * leadFactor)

        local look = tHrp.CFrame.LookVector
        local right = tHrp.CFrame.RightVector
        
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit else flatLook = Vector3.new(0,0,-1) end
        
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit else flatRight = Vector3.new(1,0,0) end
        
        local up = Vector3.new(0, 1, 0)
        local customRot = CFrame.Angles(0, math.rad(AngleOffset), 0)

        if activeMode == "Head" then
            local currentDist = 0.4 + (wave * (BangDistance * 0.55))
            local basePos = tHead.Position + pingOffset + Vector3.new(0, HeadHeightOffset, 0)
            local pureCF = CFrame.fromMatrix(basePos, flatRight, up, -flatLook)
            currentHRP.CFrame = (pureCF * CFrame.new(0, 0, -currentDist)) * CFrame.Angles(0, math.pi, 0) * customRot
        else
            local currentDist = 0.7 + (wave * BangDistance)
            local basePos = tHrp.Position + pingOffset
            local pureCF = CFrame.fromMatrix(basePos, flatRight, up, -flatLook)
            currentHRP.CFrame = (pureCF * CFrame.new(0, 0, currentDist)) * customRot
        end

        currentHRP.AssemblyLinearVelocity = targetVel
        currentHRP.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

