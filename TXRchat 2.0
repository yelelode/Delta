local openPulseTweenInfo = TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local openPulseScale = TweenService:Create(openBtnScale, openPulseTweenInfo, {Scale = 1.05})

openBtnContainer:GetPropertyChangedSignal("Visible"):Connect(function()
    if openBtnContainer.Visible then
        openPulseScale:Play()
    else
        openPulseScale:Cancel()
        openBtnScale.Scale = 1
    end
end)

