-- ⚡ UI PARTICLE SPAWNER
local function spawnUIParticles(parentFrame, positionUDim2, color, count)
    for i = 1, (count or 5) do
        local p = Instance.new("Frame", parentFrame)
        p.Size = UDim2.fromOffset(4, 4)
        p.Position = positionUDim2
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.BackgroundColor3 = color
        p.ZIndex = 100
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        
        local rx = (math.random() - 0.5) * 60
        local ry = (math.random() - 0.5) * 60
        
        TweenService:Create(p, TweenInfo.new(0.5 + math.random()*0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Position = UDim2.new(positionUDim2.X.Scale, positionUDim2.X.Offset + rx, positionUDim2.Y.Scale, positionUDim2.Y.Offset + ry),
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.9, function() pcall(function() p:Destroy() end) end)
    end
end

