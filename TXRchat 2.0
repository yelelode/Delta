local function filterFeedMode()
    for _, cardRoot in ipairs(messageFeed:GetChildren()) do
        if cardRoot:IsA("GuiObject") and cardRoot.Name ~= "UIListLayout" and cardRoot.Name ~= "UIPadding" then
            local cardScope = cardRoot:GetAttribute("ChatScope")
            local cardJob = cardRoot:GetAttribute("JobId")

            if chatMode == "server" then
                if cardScope == "global" then
                    cardRoot.Visible = false
                elseif cardJob and cardJob ~= "" and cardJob ~= game.JobId then
                    cardRoot.Visible = false
                else
                    cardRoot.Visible = true
                end
            else
                if cardScope == "server" then
                    cardRoot.Visible = false
                else
                    cardRoot.Visible = true
                end
            end
        end
    end
end

serverBtn.MouseButton1Click:Connect(function()
    chatMode = "server"
    serverBtn.BackgroundColor3 = Colors.ActiveTint
    serverBtn.BackgroundTransparency = 0
    serverBtn.TextColor3 = Colors.Primary
    globalBtn.BackgroundTransparency = 1
    globalBtn.TextColor3 = Colors.SubText
    filterFeedMode()
end)

