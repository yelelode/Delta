    TweenService:Create(targetMenu, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.fromScale(0, 0)}):Play()
    animateWaterfall(targetScroll)
end)

