        mainStroke.Transparency = 0.2
        mainStroke.Thickness = 1.0
        badgeSelectorModal.BackgroundTransparency = 0.05

        for _, cRoot in ipairs(messageFeed:GetChildren()) do
            if cRoot:IsA("Frame") then
                local card = cRoot:FindFirstChild("SwipeWrapper")
                if card then
                    TweenService:Create(card, TweenInfo.new(0.4), {BackgroundTransparency = 0.05}):Play()
                end
            end
        end
    end
end)

local actionMenu
local memeFrame

createHeaderBtn("-", function()
    if actionMenu then actionMenu.Visible = false end
    if rosterFrame then rosterFrame.Visible = false end
    if memeFrame then memeFrame.Visible = false end
    if badgeSelectorModal then 
        isBadgeModalOpen = false
        badgeSelectorModal:FindFirstChildOfClass("UIScale").Scale = 0
        badgeSelectorModal.Visible = false 
    end
    
    local tInfo1 = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    local tInfo2 = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    
    TweenService:Create(mainScale, tInfo1, {Scale = 0}):Play()
    TweenService:Create(auraScale, tInfo1, {Scale = 0}):Play()
    TweenService:Create(shadowScale, tInfo1, {Scale = 0}):Play()
    TweenService:Create(mainFrame, tInfo2, {BackgroundTransparency = 1}):Play()
    TweenService:Create(aura, tInfo2, {ImageTransparency = 1}):Play()
    TweenService:Create(shadow, tInfo2, {ImageTransparency = 1}):Play()
    
    task.wait(0.35)
    mainFrame.Visible = false
    aura.Visible = false
    shadow.Visible = false
    openBtnContainer.Visible = true
    openBtnScale.Scale = 0
    
    local tInfo3 = TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
    TweenService:Create(openBtnScale, tInfo3, {Scale = 1}):Play()
end)

