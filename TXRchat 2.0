-- 🔥 TACTILE BUTTON HOVER PHYSICS 🔥
local uiHoverCount = 0
local function applySmartHover(btn, isToggleActive)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    btnScale.Scale = 1
    local corner = btn:FindFirstChildOfClass("UICorner")
    if not corner then 
        corner = Instance.new("UICorner", btn)
        corner.CornerRadius = UDim.new(0, 8) 
    end
    if not btn:GetAttribute("BaseColor") then 
        btn:SetAttribute("BaseColor", btn.BackgroundColor3)
        btn:SetAttribute("BaseTrans", btn.BackgroundTransparency)
        btn:SetAttribute("BaseText", btn.TextColor3) 
    end
    btn.ClipsDescendants = true 

    local isHovered = false
    local hoverInInfo = TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
    local hoverOutInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local pressInfo = TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local releaseInfo = TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)

    btn.MouseEnter:Connect(function()
        isHovered = true
        uiHoverCount = uiHoverCount + 1 
        TweenService:Create(btnScale, hoverInInfo, {Scale = 1.03}):Play()
        if not isToggleActive or type(isToggleActive) ~= "function" or not isToggleActive() then 
            TweenService:Create(btn, hoverInInfo, { BackgroundColor3 = Colors.Surface, BackgroundTransparency = 0.75 }):Play() 
        end
        local stroke = btn:FindFirstChildOfClass("UIStroke")
        if stroke and stroke.Name ~= "Accent" then TweenService:Create(stroke, hoverInInfo, {Transparency = 0.3}):Play() end
    end)
    
    btn.MouseLeave:Connect(function()
        isHovered = false
        uiHoverCount = math.max(0, uiHoverCount - 1) 
        TweenService:Create(btnScale, hoverOutInfo, {Scale = 1}):Play()
        if not isToggleActive or type(isToggleActive) ~= "function" or not isToggleActive() then 
            TweenService:Create(btn, hoverOutInfo, { BackgroundColor3 = btn:GetAttribute("BaseColor"), BackgroundTransparency = btn:GetAttribute("BaseTrans") }):Play() 
        end
        local stroke = btn:FindFirstChildOfClass("UIStroke")
        if stroke and stroke.Name ~= "Accent" then TweenService:Create(stroke, hoverOutInfo, {Transparency = 0.85}):Play() end
    end)
    
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(btnScale, pressInfo, {Scale = 0.92}):Play() 
        end
    end)
    
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(btnScale, releaseInfo, {Scale = isHovered and 1.03 or 1}):Play() 
            clickFlash(btn) 
        end
    end)
end

