local function crispText(element)
    local stroke = Instance.new("UIStroke", element)
    stroke.Color = Color3.new(0, 0, 0)
    stroke.Transparency = 0.75
    stroke.Thickness = 1.1
end

local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.05}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {Scale = 1}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {Scale = 0.92}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.3, Enum.EasingStyle.Elastic), {Scale = 1.05}):Play()
    end)
end

local isAudioMuted = false
local function playSFX(soundType)
    if isAudioMuted then return end
    task.spawn(function()
        pcall(function()
            local s = Instance.new("Sound")
            if soundType == "mention" or soundType == "dm" then
                s.SoundId = "rbxassetid://9114223177"
                s.Volume = 0.8
            elseif soundType == "meme" then
                s.SoundId = "rbxassetid://9069609268"
                s.Volume = 0.6
            else
                s.SoundId = "rbxassetid://6518811702"
                s.Volume = 0.4
            end
            s.Parent = SoundService
            s:Play()
            task.delay(1.5, function() pcall(function() s:Destroy() end) end)
        end)
    end)
end

