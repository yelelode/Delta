task.spawn(function()
    pcall(function()
        local orbCode = game:HttpGet(REOPEN_ORB_URL, true)
        if orbCode and orbCode ~= "" then
            local orbFunc = loadstring(orbCode)
            if orbFunc then
                orbFunc()
            end
        end
    end)

    -- Detect loaded standalone Orb
