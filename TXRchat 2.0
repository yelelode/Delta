chatInput.Font = Enum.Font.GothamMedium
chatInput.TextSize = 12
chatInput.ClearTextOnFocus = false
chatInput.TextXAlignment = Enum.TextXAlignment.Left
chatInput.ZIndex = 13

chatInput.Focused:Connect(function()
    TweenService:Create(inputStroke, TweenInfo.new(0.25), {Color = Colors.Primary, Transparency = 0.1, Thickness = 1.8}):Play()
end)
chatInput.FocusLost:Connect(function()
    TweenService:Create(inputStroke, TweenInfo.new(0.25), {Color = Colors.PrimaryDark, Transparency = 0.5, Thickness = 1.2}):Play()
end)

updateInputBar = function()
    if privateTarget then
        dmBadge.Text = "🔐 @" .. privateTarget .. " ✕"
        local w = TextService:GetTextSize(dmBadge.Text, 10, Enum.Font.GothamBlack, Vector2.new(1000, 30)).X + 10
        dmBadge.Size = UDim2.new(0, w, 1, -10)
        dmBadge.Visible = true
        chatInput.Position = UDim2.new(0, w + 10, 0, 0)
        chatInput.Size = UDim2.new(1, -(w + 80), 1, 0)
    else
        dmBadge.Visible = false
        chatInput.Position = UDim2.new(0, 12, 0, 0)
        chatInput.Size = UDim2.new(1, -75, 1, 0)
    end
end

dmBadge.MouseButton1Click:Connect(function()
    privateTarget = nil
    updateInputBar()
end)

