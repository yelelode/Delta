local updateInputBar

local function refreshRosterUI()
    for _, c in ipairs(rosterScroll:GetChildren()) do
        if c:IsA("GuiObject") and c.Name ~= "UIListLayout" then c:Destroy() end
    end
    for u, _ in pairs(activeUsersTable) do
        local uBtn = Instance.new("TextButton", rosterScroll)
        uBtn.Size = UDim2.new(1, 0, 0, 24)
        uBtn.BackgroundColor3 = Color3.fromRGB(12, 14, 18)
        uBtn.BackgroundTransparency = 0.2
        uBtn.Text = "  @" .. u
        uBtn.TextColor3 = Colors.Text
        uBtn.Font = Enum.Font.GothamSemibold 
        uBtn.TextSize = 9.5
        uBtn.TextXAlignment = Enum.TextXAlignment.Left
        uBtn.ZIndex = 42
        Instance.new("UICorner", uBtn).CornerRadius = UDim.new(0, 6)
        
        local ubStr = Instance.new("UIStroke", uBtn)
        ubStr.Color = Colors.SurfaceHover
        ubStr.Thickness = 1
        
        applySpringHover(uBtn)
        uBtn.MouseButton1Click:Connect(function()
            privateTarget = u
            if updateInputBar then updateInputBar() end
            playSFX("dm")
            rosterFrame.Visible = false
        end)
    end
end

