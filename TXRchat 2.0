-- =========================================================
-- 💬 MESSAGE PIPELINE (ANIMATED RED RGB DADDY TAG + FAST SYNC)
-- =========================================================
local function updateLiveCounter(username)
    activeUsersTable[username:lower()] = os.time()
    local count = 0
    local now = os.time()
    for u, t in pairs(activeUsersTable) do
        if now - t < 300 then
            count = count + 1
        else
            activeUsersTable[u] = nil
        end
    end
    liveText.Text = string.format("%d Active", math.max(1, count))
end

local function addJoinNotice(username)
    local pill = Instance.new("Frame", messageFeed)
    pill.Size = UDim2.new(1, 0, 0, 20)
    pill.BackgroundTransparency = 1
    pill.ZIndex = 9

    local lbl = Instance.new("TextLabel", pill)
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 10
    lbl.TextColor3 = Colors.SubText
    lbl.RichText = true
    lbl.Text = string.format("<font color='#50D282'>●</font> <i>@%s connected to network</i>", sanitizeXml(username))
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.ZIndex = 10

    task.defer(function()
        messageFeed.CanvasPosition = Vector2.new(0, math.max(0, messageFeed.AbsoluteCanvasSize.Y - messageFeed.AbsoluteWindowSize.Y))
    end)
end

local MAX_MESSAGES = 60
local function addMessageToFeed(userName, msg, privateUserTarget, isPrivateSender)
    if blockedUsers[userName:lower()] then return end

    local memeIdMatch = msg:match("%[MEME:(%d+)%]")
    local isMentioned = string.find(string.lower(msg), string.lower(lp.Name), 1, true) or string.find(string.lower(msg), "@" .. string.lower(lp.Name), 1, true)

    local count = 0
    for _, child in ipairs(messageFeed:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then 
            count = count + 1 
        end
    end
    if count >= MAX_MESSAGES then
        for _, child in ipairs(messageFeed:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() break end
        end
    end

    local card = Instance.new("TextButton", messageFeed)
    card.Size = memeIdMatch and UDim2.new(1, 0, 0, 130) or UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = memeIdMatch and Enum.AutomaticSize.None or Enum.AutomaticSize.Y
    card.BackgroundColor3 = isMentioned and Colors.MentionBg or (Admin[userName:lower()] and Color3.fromRGB(28, 14, 20) or Colors.Surface)
    card.BackgroundTransparency = isGhostMode and 0.65 or 0.4
    card.Text = ""
    card.AutoButtonColor = false
    card.ClipsDescendants = true
    card.ZIndex = 9
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    local cardScale = Instance.new("UIScale", card)
    cardScale.Scale = 0.88
    TweenService:Create(cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    local accentStrip = Instance.new("Frame", card)
    accentStrip.Size = UDim2.new(0, 3, 1, 0)
    accentStrip.Position = UDim2.new(0, 0, 0, 0)
    accentStrip.BorderSizePixel = 0
    accentStrip.BackgroundColor3 = isMentioned and Colors.MentionGold or (privateUserTarget and Colors.Purple or (Admin[userName:lower()] and Color3.fromRGB(255, 0, 50) or Colors.Primary))
    accentStrip.ZIndex = 10

    local cardStroke = Instance.new("UIStroke", card)
    cardStroke.Thickness = isMentioned and 1.5 or (Admin[userName:lower()] and 1.4 or 1)
    cardStroke.Transparency = isMentioned and 0.2 or (Admin[userName:lower()] and 0.15 or 0.85)
    cardStroke.Color = isMentioned and Colors.MentionGold or (Admin[userName:lower()] and Color3.fromRGB(255, 0, 50) or Colors.PrimaryDark)

    if Admin[userName:lower()] then
        local royalGrad = Instance.new("UIGradient", cardStroke)
        royalGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 55)),
            ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 90, 110)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 0, 30)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 55))
        })
        task.spawn(function()
            local gt = 0
            while card and card.Parent and _G.TXR_ChatInstanceID == currentExecutionID do
                gt = gt + 0.05
                royalGrad.Offset = Vector2.new(math.sin(gt * 2.5) * 0.85, 0)
                task.wait(0.03)
            end
        end)
    end

    local avatarImg = Instance.new("ImageLabel", card)
    avatarImg.Size = UDim2.fromOffset(26, 26)
    avatarImg.Position = UDim2.fromOffset(9, 6)
    avatarImg.BackgroundColor3 = Colors.Background
    avatarImg.BackgroundTransparency = 0.4
    avatarImg.ZIndex = 11
    Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)

    task.spawn(function()
        local targetPlr = Players:FindFirstChild(userName)
        local uId = targetPlr and targetPlr.UserId or userIdCache[userName:lower()]
        if not uId then
            pcall(function()
                uId = Players:GetUserIdFromNameAsync(userName)
                userIdCache[userName:lower()] = uId
            end)
        end
        if uId and avatarImg and avatarImg.Parent then
            avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", uId)
        end
    end)

    local txt = Instance.new("TextLabel", card)
    txt.Size = UDim2.new(1, -44, 0, 0)
    txt.Position = UDim2.fromOffset(42, 6)
    txt.AutomaticSize = Enum.AutomaticSize.Y
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Colors.Text
    txt.Font = Enum.Font.GothamMedium
    txt.TextSize = 11.5
    txt.TextWrapped = true
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.RichText = true
    txt.ZIndex = 10

    local timeStr = os.date("%H:%M")
    local timeTag = string.format("<font color='#657388'>[%s]</font> ", timeStr)
    local cleanUserName = sanitizeXml(userName)

    local dmTag = ""
    if privateUserTarget then
        cardStroke.Color = Colors.Purple
        cardStroke.Transparency = 0.4
        dmTag = isPrivateSender and ("<font color='#A032FF'>[🔐 To @" .. sanitizeXml(privateUserTarget) .. "]</font> ") or ("<font color='#A032FF'>[🔐 From @" .. sanitizeXml(privateUserTarget) .. "]</font> ")
    end

    local nameTag = string.format("<font color='%s'><b>%s:</b></font> ", (currentThemeIdx == 2 and "#FF2D55" or "#00FFC8"), cleanUserName)
    local cleanMsg = sanitizeXml(msg)

    if Admin[userName:lower()] then
        table.insert(adminCardsRegistry, {
            txt = txt,
            headerPrefix = timeTag .. dmTag,
            userTag = nameTag,
            msgContent = cleanMsg,
            isMeme = (memeIdMatch ~= nil)
        })
        txt.Text = timeTag .. dmTag .. getAnimatedDaddyTag(tick()) .. nameTag .. (memeIdMatch and "<font color='#FFD700'><i>[Sticker]</i></font>" or cleanMsg)
    else
        local headerLine = timeTag .. dmTag .. nameTag
        if memeIdMatch then
            txt.Text = headerLine .. "<font color='#FFD700'><i>[Sticker]</i></font>"
        else
            txt.Text = headerLine .. cleanMsg
        end
    end

    if memeIdMatch then
        local memeImg = Instance.new("ImageLabel", card)
        memeImg.Size = UDim2.fromOffset(90, 90)
        memeImg.Position = UDim2.fromOffset(42, 28)
        memeImg.BackgroundColor3 = Colors.Background
        memeImg.BackgroundTransparency = 0.3
        memeImg.Image = getAssetThumb(memeIdMatch)
        memeImg.ScaleType = Enum.ScaleType.Fit
        memeImg.ZIndex = 12
        Instance.new("UICorner", memeImg).CornerRadius = UDim.new(0, 8)
        
        local mStroke = Instance.new("UIStroke", memeImg)
        mStroke.Color = Colors.PrimaryDark
        mStroke.Thickness = 1.2
    else
        local padFix = Instance.new("UIPadding", card)
        padFix.PaddingBottom = UDim.new(0, 6)
    end

    crispText(txt)

    if isMentioned and userName ~= lp.Name then
        playSFX("mention")
    elseif memeIdMatch and userName ~= lp.Name then
        playSFX("meme")
    end

    card.MouseButton1Click:Connect(function()
        if userName == lp.Name or userName == "System" then return end
        
        for _, c in ipairs(actionMenu:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end

        createActionBtn("🔐 DM", Colors.Purple, function()
            privateTarget = userName
            updateInputBar()
            playSFX("dm")
        end)

        createActionBtn("📋 COPY", Colors.Primary, function()
            pcall(function() setClip(memeIdMatch and ("ID: " .. memeIdMatch) or msg) end)
        end)

        createActionBtn("🚀 TP", Colors.MentionGold, function()
            local targetPlr = Players:FindFirstChild(userName)
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                lp.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame
            end
        end)

        createActionBtn("👁️ VIEW", Colors.PrimaryDark, function()
            local targetPlr = Players:FindFirstChild(userName)
            if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = targetPlr.Character.Humanoid
            end
        end)

        createActionBtn("🚫 MUTE", Colors.Danger, function()
            blockedUsers[userName:lower()] = true
            card:Destroy()
        end)

        local cardPos = card.AbsolutePosition - mainFrame.AbsolutePosition
        actionMenu.Position = UDim2.fromOffset(math.clamp(cardPos.X + 30, 10, 170), math.clamp(cardPos.Y - 22, 30, 280))
        actionMenu.Visible = true
    end)

    task.defer(function()
        messageFeed.CanvasPosition = Vector2.new(0, math.max(0, messageFeed.AbsoluteCanvasSize.Y - messageFeed.AbsoluteWindowSize.Y))
    end)
end

