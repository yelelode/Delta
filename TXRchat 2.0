-- =========================================================
local function createSlider(name, min, max, defaultVal, callback)
    local container = Instance.new("Frame", mainList)
    container.Size = UDim2.new(1, 0, 0, 46); container.BackgroundTransparency = 1; container.LayoutOrder = getOrder(); container.ZIndex = 7
    
    local titleLabel = Instance.new("TextLabel", container)
    titleLabel.Size = UDim2.new(0.6, 0, 0, 14); titleLabel.Position = UDim2.new(0, 6, 0, 0); titleLabel.BackgroundTransparency = 1
    titleLabel.Text = name; titleLabel.TextColor3 = Colors.SubText; titleLabel.Font = Enum.Font.GothamBold; titleLabel.TextSize = 11; titleLabel.TextXAlignment = Enum.TextXAlignment.Left; titleLabel.ZIndex = 8
    titleLabel.RichText = true

    local valBadge = Instance.new("Frame", container)
    valBadge.Size = UDim2.new(0, 44, 0, 16); valBadge.AnchorPoint = Vector2.new(1, 0); valBadge.Position = UDim2.new(1, -6, 0, -1)
    valBadge.BackgroundColor3 = Colors.Primary; valBadge.BackgroundTransparency = 0.85; valBadge.ZIndex = 8
    Instance.new("UICorner", valBadge).CornerRadius = UDim.new(0, 6)
    local valStroke = Instance.new("UIStroke", valBadge); valStroke.Color = Colors.Primary; valStroke.Transparency = 0.5; valStroke.Thickness = 1
    
    local valLabel = Instance.new("TextLabel", valBadge)
    valLabel.Size = UDim2.new(1, 0, 1, 0); valLabel.BackgroundTransparency = 1; valLabel.Text = defaultVal
    valLabel.TextColor3 = Colors.Primary; valLabel.Font = Enum.Font.GothamBold; valLabel.TextSize = 11; valLabel.ZIndex = 9
    valLabel.RichText = true

    local bg = Instance.new("Frame", container)
    bg.Size = UDim2.new(1, -20, 0, 3); bg.Position = UDim2.new(0, 10, 0, 26); bg.BackgroundColor3 = Color3.fromRGB(40, 50, 65); bg.ZIndex = 8
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    
    local hitbox = Instance.new("TextButton", container)
    hitbox.Size = UDim2.new(1, 0, 0, 30); hitbox.Position = UDim2.new(0, 0, 0, 13); hitbox.BackgroundTransparency = 1; hitbox.Text = ""; hitbox.ZIndex = 15
    
    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = Colors.PrimaryDark; fill.ZIndex = 9
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", fill)
    knob.Size = UDim2.new(0, 12, 0, 12); knob.AnchorPoint = Vector2.new(0.5, 0.5); knob.Position = UDim2.new(1, 0, 0.5, 0)
    knob.BackgroundColor3 = Colors.Text; knob.ZIndex = 11; Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    
    local knobDot = Instance.new("Frame", knob)
    knobDot.Size = UDim2.new(0, 4, 0, 4); knobDot.AnchorPoint = Vector2.new(0.5, 0.5); knobDot.Position = UDim2.fromScale(0.5, 0.5)
    knobDot.BackgroundColor3 = Colors.Primary; knobDot.BorderSizePixel = 0; knobDot.ZIndex = 12; Instance.new("UICorner", knobDot).CornerRadius = UDim.new(1,0)
    local knobStroke = Instance.new("UIStroke", knob); knobStroke.Color = Colors.Primary; knobStroke.Transparency = 0.8; knobStroke.Thickness = 2

    local dragging = false
    local function update(input) 
        local rawPos = input.Position.X; local relativeX = math.clamp(rawPos - bg.AbsolutePosition.X, 0, bg.AbsoluteSize.X); local pos = relativeX / bg.AbsoluteSize.X
        TweenService:Create(fill, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        local val = math.floor((min + (pos * (max - min))) * 10) / 10; valLabel.Text = tostring(val); callback(val)
    end
    
    hitbox.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = true; uiHoverCount = uiHoverCount + 1
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            TweenService:Create(knobDot, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Size = UDim2.new(0, 8, 0, 8)}):Play()
            TweenService:Create(knobStroke, TweenInfo.new(0.2), {Transparency = 0.2, Thickness = 3}):Play()
            TweenService:Create(valBadge, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
            TweenService:Create(valStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
            TweenService:Create(fill, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(150, 255, 240)}):Play()
            update(input) 
        end 
    end)
    hitbox.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging = false; uiHoverCount = math.max(0, uiHoverCount - 1)
            TweenService:Create(knob, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 12, 0, 12)}):Play()
            TweenService:Create(knobDot, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 4, 0, 4)}):Play()
            TweenService:Create(knobStroke, TweenInfo.new(0.3), {Transparency = 0.8, Thickness = 2}):Play()
            TweenService:Create(valBadge, TweenInfo.new(0.3), {BackgroundTransparency = 0.85}):Play()
            TweenService:Create(valStroke, TweenInfo.new(0.3), {Transparency = 0.5}):Play()
            TweenService:Create(fill, TweenInfo.new(0.3), {BackgroundColor3 = Colors.PrimaryDark}):Play()
        end 
    end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
end

