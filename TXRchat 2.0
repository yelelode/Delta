local matrixChars = {"0", "1", "X", "Z", "9", "A", "F", "TXR", "7", "3"}
local matrixColumns = {}
for i = 1, 16 do
    local col = Instance.new("TextLabel", matrixBox)
    col.Size = UDim2.new(0, 18, 1, 0)
    col.Position = UDim2.new((i - 1) / 16, 4, 0, 0)
    col.BackgroundTransparency = 1
    col.Font = Enum.Font.Code
    col.TextSize = 8 
    col.TextColor3 = Colors.PrimaryDark
    col.TextTransparency = 0.98 -- Faint OLED Burn-in look
    col.TextWrapped = true
    col.TextYAlignment = Enum.TextYAlignment.Top
    col.ZIndex = 6
    table.insert(matrixColumns, col)
end

task.spawn(function()
    while _G.TXR_ChatInstanceID == currentExecutionID and gui.Parent do
        for _, col in ipairs(matrixColumns) do
            local str = ""
            for j = 1, 14 do
                str = str .. matrixChars[math.random(1, #matrixChars)] .. "\n"
            end
            col.Text = str
        end
        task.wait(0.3)
    end
end)

