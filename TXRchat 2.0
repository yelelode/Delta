stopBtn.Text = "⏹ STOP"; stopBtn.TextColor3 = Colors.Danger; stopBtn.Font = Enum.Font.GothamBold; stopBtn.TextSize = 12; stopBtn.AutoButtonColor = false; stopBtn.ZIndex = 16
