-- =========================================================
-- 🚀 BULLETPROOF SAFE CLAMP DRAG ENGINE & ORB RESTORE
-- =========================================================
local function makeDraggable(frame, handle, ghostAura, isOrb)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local targetPos = frame.Position
    local velocity = Vector2.new(0, 0)
    local lastInputPos = Vector2.new(0, 0)
    local dragLoop = nil

    local function getClampedTarget(newXScale, newXOffset, newYScale, newYOffset)
        local parentSize = gui.AbsoluteSize
        local frameSize = frame.AbsoluteSize
        local anchor = frame.AnchorPoint

        if parentSize.X <= 0 or parentSize.Y <= 0 then
            return UDim2.new(newXScale, newXOffset, newYScale, newYOffset)
        end

        local absX = (newXScale * parentSize.X) + newXOffset
        local absY = (newYScale * parentSize.Y) + newYOffset

        local minX, maxX, minY, maxY

        if isOrb then
            minX = frameSize.X * anchor.X
            maxX = parentSize.X - (frameSize.X * (1 - anchor.X))
            minY = frameSize.Y * anchor.Y
            maxY = parentSize.Y - (frameSize.Y * (1 - anchor.Y))
        else
            local visibleWidth = frameSize.X * 0.20
            local visibleHeight = frameSize.Y * 0.20

            minX = (frameSize.X * anchor.X) - (frameSize.X - visibleWidth)
            maxX = parentSize.X - (frameSize.X * (1 - anchor.X)) + (frameSize.X - visibleWidth)
            minY = (frameSize.Y * anchor.Y) - (frameSize.Y - visibleHeight)
            maxY = parentSize.Y - (frameSize.Y * (1 - anchor.Y)) + (frameSize.Y - visibleHeight)
        end

        if minX > maxX then minX, maxX = maxX, minX end
        if minY > maxY then minY, maxY = maxY, minY end

        local clampedX = math.clamp(absX, minX, maxX)
        local clampedY = math.clamp(absY, minY, maxY)

        return UDim2.new(newXScale, clampedX - (newXScale * parentSize.X), newYScale, clampedY - (newYScale * parentSize.Y))
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            targetPos = startPos
            lastInputPos = Vector2.new(input.Position.X, input.Position.Y)
            velocity = Vector2.new(0, 0)
            
            if isOrb then
                isDraggingOrb = true
                dragThresholdMet = false
            end
            
            if dragLoop then dragLoop:Disconnect() end
            
            dragLoop = RunService.RenderStepped:Connect(function(dt)
                if _G.TXR_ChatInstanceID ~= currentExecutionID then
                    dragLoop:Disconnect()
                    return
                end
                
                if dragging then
                    frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 25, 0, 1))
                else
                    if velocity.Magnitude > 0.5 then
                        velocity = velocity * 0.90
                        targetPos = getClampedTarget(targetPos.X.Scale, targetPos.X.Offset + velocity.X, targetPos.Y.Scale, targetPos.Y.Offset + velocity.Y)
                        frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 15, 0, 1))
                    else
                        dragLoop:Disconnect()
                        dragLoop = nil
                    end
                end
                
                if ghostAura then
                    ghostAura.Position = frame.Position
                end
            end)
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            if isOrb then
                isDraggingOrb = false
                orbHovered = false
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if isOrb and delta.Magnitude > 8 then 
                dragThresholdMet = true
            end
            
            targetPos = getClampedTarget(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            local currentMousePos = Vector2.new(input.Position.X, input.Position.Y)
            velocity = currentMousePos - lastInputPos
            lastInputPos = currentMousePos
        end
    end)
end

makeDraggable(mainFrame, header, aura, false)
makeDraggable(openBtnContainer, openBtn, nil, true)

openBtn.MouseButton1Down:Connect(function()
    local tInfo = TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    TweenService:Create(openBtnScale, tInfo, {Scale = 0.85}):Play()
end)

openBtn.MouseButton1Up:Connect(function()
    local tInfo = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.2)
    TweenService:Create(openBtnScale, tInfo, {Scale = 1.05}):Play()
end)

-- Reopen Handler
openBtn.MouseButton1Click:Connect(function()
    if dragThresholdMet then 
        dragThresholdMet = false 
        return 
    end

    ghostDebounce = true
    task.delay(0.5, function() ghostDebounce = false end)
    
    local tInfo1 = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    TweenService:Create(openBtnScale, tInfo1, {Scale = 0}):Play()
    
    task.wait(0.25)
    
    openBtnContainer.Visible = false
    mainFrame.Visible = true
    aura.Visible = true
    mainScale.Scale = 0.8
    auraScale.Scale = 0.8
    
    unreadCount = 0
    unreadBadge.Visible = false
    
    local tInfo2 = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local tInfo3 = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    
    TweenService:Create(mainScale, tInfo2, {Scale = 1}):Play()
    TweenService:Create(auraScale, tInfo2, {Scale = 1}):Play()
    TweenService:Create(mainFrame, tInfo3, {BackgroundTransparency = isGhostMode and 0.82 or 0.1}):Play()
    TweenService:Create(aura, tInfo3, {ImageTransparency = isGhostMode and 0.92 or 0.55}):Play()
end)

-- Keyboard Shortcuts
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if mainFrame.Visible then
            mainFrame.Visible = false
            aura.Visible = false
            openBtnContainer.Visible = true
        else
            openBtnContainer.Visible = false
            mainFrame.Visible = true
            aura.Visible = true
        end
    elseif input.KeyCode == Enum.KeyCode.Semicolon or input.KeyCode == Enum.KeyCode.Slash then
        task.delay(0.05, function() chatInput:CaptureFocus() end)
    end
end)

-- =========================================================
-- ⚡ REACTOR RENDERING ANIMATION & CHROMA ENGINE LOOP
-- =========================================================
local lastChromaUpdate = 0
task.spawn(function()
    local t = 0
    local sonarTimer = 0
    local currentSpeedMod = 1
    local currentRadiusMod = 1
    
    RunService.RenderStepped:Connect(function(dt)
        if _G.TXR_ChatInstanceID ~= currentExecutionID or not gui.Parent then return end
        t = t + dt

        -- ⚡ 60 FPS ULTRA FLUID RED RGB CHROMA UPDATE
        if (t - lastChromaUpdate) >= 0.035 and #adminCardsRegistry > 0 then
            lastChromaUpdate = t
            local currentDaddyTag = getAnimatedDaddyTag(t)
            for i = #adminCardsRegistry, 1, -1 do
                local item = adminCardsRegistry[i]
                if item.txt and item.txt.Parent then
                    if item.isMeme then
                        item.txt.Text = item.headerPrefix .. currentDaddyTag .. item.userTag .. "<font color='#FFD700'><i>[Sticker]</i></font>"
                    else
                        item.txt.Text = item.headerPrefix .. currentDaddyTag .. item.userTag .. item.msgContent
                    end
                else
                    table.remove(adminCardsRegistry, i)
                end
            end
        end

        if mainFrame.Visible then
            strokeGrad.Rotation = (t * 40) % 360
            local breath = (math.sin(t * 2.5) + 1) / 2
            aura.ImageTransparency = isGhostMode and 0.92 or (0.6 + (breath * 0.1))

            local ledAlpha = (math.sin(t * 4) + 1) / 2
            ledDot.BackgroundTransparency = 0.1 + (ledAlpha * 0.5)

            for i, b in ipairs(eqBars) do
                local wave = (math.sin(t * 7 + (i * 1.2)) + 1) / 2
                b.Size = UDim2.new(0, 3, 0.2 + (wave * 0.8), 0)
            end
        end

        if openBtnContainer.Visible then
            local targetSpeed = 1
            if orbHovered then targetSpeed = targetSpeed * 1.5 end
            
            currentSpeedMod = currentSpeedMod + (targetSpeed - currentSpeedMod) * dt * 5
            local targetRadius = orbHovered and 0.6 or 1
            currentRadiusMod = currentRadiusMod + (targetRadius - currentRadiusMod) * dt * 8
            local activeT = t * 3 * currentSpeedMod
            
            local baseColor1 = Colors.Primary
            local baseColor2 = Colors.Purple
            local lerpAlpha = (math.sin(activeT * 0.8) + 1) / 2
            
            coreGlow.ImageColor3 = baseColor1:Lerp(baseColor2, lerpAlpha)
            coreGlow.ImageTransparency = 0.4 + (math.sin(activeT) * 0.25)
            eventGlow.ImageColor3 = baseColor2:Lerp(Color3.new(1,1,1), lerpAlpha)
            
            openStroke.Color = baseColor1:Lerp(baseColor2, lerpAlpha)
            goGrad.Rotation = (activeT * 50) % 360
            goStroke.Transparency = orbHovered and 0.1 or 0.5
            
            local gPulse = 40 + (math.sin(activeT * 2) * 3)
            gimbals[1].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 0.8)), gPulse)
            gimbals[1].frame.Rotation = (activeT * 20) % 360
            gimbals[1].stroke.Color = baseColor1
            
            gimbals[2].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 0.9)))
            gimbals[2].frame.Rotation = -(activeT * 25) % 360
            gimbals[2].stroke.Color = baseColor2
            
            gimbals[3].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 1.1)), gPulse)
            gimbals[3].frame.Rotation = 45 + (activeT * 15) % 360
            gimbals[3].stroke.Color = baseColor1:Lerp(Color3.new(1,1,1), 0.5)
            
            gimbals[4].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 1.2)))
            gimbals[4].frame.Rotation = -45 - (activeT * 15) % 360
            gimbals[4].stroke.Color = baseColor2:Lerp(Color3.new(1,1,1), 0.5)
            
            for i, d in ipairs(diamonds) do
                local breath = math.sin(activeT * 2 + (i * math.pi / 2)) * 4
                d.frame.Size = UDim2.fromOffset(24 + breath, 24 - breath)
                d.frame.Rotation = (activeT * 40) * (i % 2 == 0 and 1 or -1) + (i * 22.5)
                d.stroke.Color = (i % 2 == 0) and baseColor1 or baseColor2
            end
            
            crosshair.Rotation = -(activeT * 60) % 360
            crosshair.ImageColor3 = baseColor1
            
            centerCore.BackgroundColor3 = baseColor1:Lerp(Color3.new(1,1,1), lerpAlpha * 0.5)
            coreStroke.Color = baseColor2

            local rBase = 32 * currentRadiusMod
            for i = 1, 12 do
                local offset = (i - 1) * (math.pi * 2 / 4)
                local orb = orbs[i]
                if i <= 4 then
                    local a = activeT * 1.5 + offset
                    local depth = math.sin(a)
                    orb.Position = UDim2.new(0.5, math.cos(a) * rBase, 0.5, depth * (rBase * 0.2))
                    orb.Size = UDim2.fromOffset(3.5 + (depth * 2.5), 3.5 + (depth * 2.5))
                    orb.ZIndex = depth > 0 and 106 or 102
                    orb.BackgroundColor3 = baseColor1
                elseif i <= 8 then
                    local a = -activeT * 1.8 + offset
                    local depth = math.cos(a)
                    orb.Position = UDim2.new(0.5, math.cos(a) * (rBase * 0.2), 0.5, math.sin(a) * rBase)
                    orb.Size = UDim2.fromOffset(3.5 + (depth * 2.5), 3.5 + (depth * 2.5))
                    orb.ZIndex = depth > 0 and 106 or 102
                    orb.BackgroundColor3 = baseColor2
                else
                    local a = activeT * 2.5 + offset
                    local depth = math.sin(a + math.pi / 4)
                    orb.Position = UDim2.new(0.5, math.sin(a) * rBase, 0.5, math.sin(a * 2) * (rBase * 0.5))
                    orb.Size = UDim2.fromOffset(4 + (depth * 2), 4 + (depth * 2))
                    orb.ZIndex = 107
                    orb.BackgroundColor3 = Color3.new(1,1,1)
                end
            end

            local mouseLoc = UserInputService:GetMouseLocation()
            local btnAbsCenter = openBtnContainer.AbsolutePosition + (openBtnContainer.AbsoluteSize / 2)
            local mPos = Vector2.new(mouseLoc.X, mouseLoc.Y)
            local mDist = (mPos - btnAbsCenter).Magnitude
            local magneticRadius = 150

            if orbHovered and mDist < magneticRadius and not isDraggingOrb then
                local pullStr = 1 - (mDist / magneticRadius)
                local offsetX = (mPos.X - btnAbsCenter.X) * 0.25 * pullStr
                local offsetY = (mPos.Y - btnAbsCenter.Y) * 0.25 * pullStr
                local stretchX = 0.85 + (math.abs(offsetX) / 200)
                local stretchY = 0.85 + (math.abs(offsetY) / 200)

                openBtn.Size = openBtn.Size:Lerp(UDim2.fromScale(stretchX, stretchY), dt * 12)
                openBtn.Position = openBtn.Position:Lerp(UDim2.new(0.5, offsetX, 0.5, offsetY), dt * 10)
                eventGlow.Position = eventGlow.Position:Lerp(UDim2.new(0.5, offsetX * 0.4, 0.5, offsetY * 0.4), dt * 10)
                crosshair.Position = crosshair.Position:Lerp(UDim2.new(0.5, offsetX * 0.7, 0.5, offsetY * 0.7), dt * 12)
                centerCore.Position = centerCore.Position:Lerp(UDim2.new(0.5, offsetX * 1.2, 0.5, offsetY * 1.2), dt * 15)
                
                eventGlow.ImageTransparency = 0.1 + (math.sin(activeT * 10) * 0.05)
            else
                openBtn.Size = openBtn.Size:Lerp(baseOrbScale, dt * 12)
                openBtn.Position = openBtn.Position:Lerp(baseCenterPos, dt * 12)
                eventGlow.Position = eventGlow.Position:Lerp(baseCenterPos, dt * 12)
                crosshair.Position = crosshair.Position:Lerp(baseCenterPos, dt * 12)
                centerCore.Position = centerCore.Position:Lerp(baseCenterPos, dt * 12)
                eventGlow.ImageTransparency = 0.3 + (math.cos(activeT * 2) * 0.3)
            end

            sonarTimer = sonarTimer + dt
            if sonarTimer >= 1.0 then
                sonarTimer = 0
                spawnSonar(baseColor1)
            end
        end
    end)
end)

-- =========================================================
-- 📡 SEND MESSAGE (INSTANT 0MS FEED ENGINE)
-- =========================================================
local isSendingCooldown = false
sendMessageFunc = function(overrideText)
    local text = overrideText or chatInput.Text
    if text == "" or not text then return end
    if isSendingCooldown then return end

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then
        chatInput.Text = ""
        privateTarget = pMatch
        updateInputBar()
        addMessageToFeed("System", "DM mode locked with @" .. pMatch)
        return
    end

    local finalMsg = text
    if privateTarget then
        finalMsg = "( 🔐 " .. lp.Name .. " Private " .. privateTarget .. ") " .. text
    end

    -- ⚡ Instant Local Echo (Zero Latency)
    if privateTarget then
        addMessageToFeed(lp.Name, text, privateTarget, true)
    else
        addMessageToFeed(lp.Name, text, nil, false)
    end
    displayBubble(lp.Name, text)

    table.insert(recentSentCache, { msg = finalMsg, time = os.time() })
    if #recentSentCache > 25 then
        table.remove(recentSentCache, 1)
    end

    if not overrideText then chatInput.Text = "" end

    isSendingCooldown = true
    sendBtn.BackgroundColor3 = Colors.SurfaceHover
    sendBtn.Text = "⏳"

    cdBar.Visible = true
    cdBar.Size = UDim2.new(0, 0, 0, 2)
    TweenService:Create(cdBar, TweenInfo.new(0.6, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 2)}):Play()

    task.spawn(function()
        if req then
            local payload = HttpService:JSONEncode({
                user = lp.Name,
                msg = finalMsg,
                jobId = game.JobId
            })

            pcall(function()
                req({
                    Url = SERVER_URL .. "/send",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = payload
                })
            end)
        end

        task.wait(0.6)
        isSendingCooldown = false
        cdBar.Visible = false
        sendBtn.BackgroundColor3 = Colors.Primary
        sendBtn.Text = "➤"
    end)
end

sendBtn.MouseButton1Click:Connect(function() sendMessageFunc() end)
chatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessageFunc() end
end)

-- =========================================================
-- 📥 HIGH-FREQUENCY POLLING ENGINE (FAST REALTIME SYNC)
-- =========================================================
task.spawn(function()
    while _G.TXR_IsPolling and task.wait(0.25) do
        if req then
            local success, res = pcall(function()
                return req({
                    Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime),
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Roblox/WinInet" }
                })
            end)

            if success and res and res.StatusCode == 200 then
                local decodeSuccess, data = pcall(function()
                    return HttpService:JSONDecode(res.Body)
                end)

                if decodeSuccess and type(data) == "table" then
                    if isInitialSync then
                        isInitialSync = false
                        if #data > 0 then
                            local startIndex = math.max(1, #data - 4)
                            for i = startIndex, #data do
                                local m = data[i]
                                if not m.hidden and m.msg ~= "Joined" then
                                    addMessageToFeed(m.user, m.msg, nil, false)
                                    updateLiveCounter(m.user)
                                end
                            end
                            lastSyncTime = data[#data].time
                        else
                            lastSyncTime = os.time()
                        end
                        continue
                    end

                    for _, m in ipairs(data) do
                        if m.time > lastSyncTime then
                            lastSyncTime = m.time
                            knownUsers[m.user:lower()] = m.user
                            updateLiveCounter(m.user)

                            if m.msg == "Joined" then
                                if m.user ~= lp.Name then
                                    addJoinNotice(m.user)
                                    playSFX("default")
                                end
                                continue
                            end

                            if m.hidden then continue end
                            if chatMode == "server" and m.jobId ~= game.JobId then continue end

                            local isLocalEcho = false
                            if m.user:lower() == lp.Name:lower() then
                                for idx, sent in ipairs(recentSentCache) do
                                    if sent.msg == m.msg and math.abs(m.time - sent.time) <= 20 then
                                        isLocalEcho = true
                                        table.remove(recentSentCache, idx)
                                        break
                                    end
                                end
                            end

                            if isLocalEcho then
                                continue
                            end

                            local pSender, pTarget, pMsg = string.match(m.msg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                            if pSender and pTarget then
                                if lp.Name == pSender then
                                    addMessageToFeed(m.user, pMsg, pTarget, true)
                                elseif lp.Name == pTarget then
                                    addMessageToFeed(m.user, pMsg, pSender, false)
                                    displayBubble(m.user, pMsg)
                                    playSFX("dm")

                                    if not mainFrame.Visible then
                                        unreadCount = unreadCount + 1
                                        unreadTxt.Text = tostring(unreadCount)
                                        unreadBadge.Visible = true
                                    end
                                end
                                continue
                            end

                            addMessageToFeed(m.user, m.msg, nil, false)

                            if m.user ~= lp.Name then
                                displayBubble(m.user, m.msg)
                                playSFX("default")

                                if not mainFrame.Visible then
                                    unreadCount = unreadCount + 1
                                    unreadTxt.Text = tostring(unreadCount)
                                    unreadBadge.Visible = true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Handshake
task.spawn(function()
    if req then
        pcall(function()
            req({
                Url = SERVER_URL .. "/send", Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                Body = HttpService:JSONEncode({ user = lp.Name, msg = "Joined", jobId = game.JobId, hidden = false })
            })
        end)
    end
    addMessageToFeed("System", "TXR Cyber-Titan Online! Tap 🎭 for Meme Stickers.")
end)
