-- =========================================================
-- ⚡ DYNAMIC RED RGB CHROMA GENERATOR
-- =========================================================
local function getAnimatedDaddyTag(animTime)
    local chars = {"[", "👑", " ", "D", "A", "D", "D", "Y", "]"}
    local str = ""
    for i, ch in ipairs(chars) do
        local phase = (animTime * 5.2 - (i * 0.42))
        local wave = (math.sin(phase) + 1) / 2
        local wave2 = (math.cos(phase * 0.7) + 1) / 2
        
        local r = 255
        local g = math.floor(10 + (wave * 90) + (wave2 * 30))
        local b = math.floor(25 + (wave * 85) + (wave2 * 35))
        
        -- Specular neon flash
        if wave > 0.86 then
            g = math.min(255, g + 85)
            b = math.min(255, b + 95)
        end
        
        local hex = string.format("#%02X%02X%02X", r, g, b)
        str = str .. string.format("<font color='%s'><b>%s</b></font>", hex, ch)
    end
    return "<stroke color='#400008' thickness='1.5'>" .. str .. "</stroke> "
end

local function displayBubble(userName, msg)
    local speaker = Players:FindFirstChild(userName)
    if not speaker or not speaker.Character then return end

    local cleanMsg = msg
    if cleanMsg:find("%[MEME:") then
        cleanMsg = "🖼️ [Sticker / Meme]"
    end

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService:DisplayBubble(speaker.Character, cleanMsg)
        else
            local head = speaker.Character:FindFirstChild("Head")
            if head then
                ChatService:Chat(head, cleanMsg, Enum.ChatColor.White)
            end
        end
    end)
end

