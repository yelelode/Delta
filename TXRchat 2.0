-- 🔥 FROSTED TRANSLUCENT BUTTONS 🔥
local function createMainBtn(text, isMenuOpener)
    local btn = Instance.new("TextButton", mainList)
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = Colors.Surface
    btn.BackgroundTransparency = 0.9 
    btn.Text = "   " .. text
    btn.TextColor3 = Colors.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.RichText = true
    btn.LayoutOrder = getOrder()
    btn.ZIndex = 7
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local subtleStroke = Instance.new("UIStroke", btn)
    subtleStroke.Color = Colors.Primary
    subtleStroke.Transparency = 0.85
    subtleStroke.Thickness = 1.2
    subtleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual

    local accent = Instance.new("Frame", btn)
    accent.Name = "Accent"
    accent.Size = UDim2.new(0, 0, 0, 0)
    accent.Position = UDim2.new(0, 0, 0.5, 0)
    accent.AnchorPoint = Vector2.new(0, 0.5)
    accent.BackgroundColor3 = Colors.Primary
    accent.BorderSizePixel = 0
    Instance.new("UICorner", accent).CornerRadius = UDim.new(1,0)
    
    if isMenuOpener then 
        local arrow = Instance.new("TextLabel", btn)
        arrow.Size = UDim2.new(0, 30, 1, 0)
        arrow.Position = UDim2.new(1, -30, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = ">"
        arrow.TextColor3 = Colors.SubText
        arrow.Font = Enum.Font.GothamMedium
        arrow.TextSize = 14 
    end
    applySmartHover(btn, nil)
    return btn
end

