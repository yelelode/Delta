    searchQuery = string.lower(searchBox.Text)
    for _, card in ipairs(messageFeed:GetChildren()) do
        if card:IsA("GuiObject") and card.Name ~= "UIListLayout" and card.Name ~= "UIPadding" then
            local lbl = card:FindFirstChildOfClass("TextLabel")
            if lbl then
                if searchQuery == "" or string.find(string.lower(lbl.Text), searchQuery, 1, true) then
                    card.Visible = true
                else
                    card.Visible = false
                end
            end
        end
    end
end)

