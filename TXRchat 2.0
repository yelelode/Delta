-- =========================================================
-- 💬 MESSAGE PIPELINE
-- =========================================================
local function updateLiveCounter(username)
    activeUsersTable[username:lower()] = os.time()
    local count = 0
    local now = os.time()
    for u, t in pairs(activeUsersTable) do
        if now - t < 300 then
            count = count + 1
        else
            activeUsersTable[u] = nil
        end
    end
    liveText.Text = string.format("%d Active", math.max(1, count))
end

local function addJoinNotice(username)
    local pill = Instance.new("Frame", messageFeed)
    pill.Size = UDim2.new(1, 0, 0, 20)
    pill.BackgroundTransparency = 1
    pill.ZIndex = 9

    local lbl = Instance.new("TextLabel", pill)
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 10
    lbl.TextColor3 = Colors.SubText
    lbl.RichText = true
    lbl.Text = string.format("<font color='#50D282'>●</font> <i>@%s connected to network</i>", username)
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.ZIndex = 10

    task.defer(function()
        messageFeed.CanvasPosition = Vector2.new(0, messageFeed.AbsoluteCanvasSize.Y)
    end)
end

local MAX_MESSAGES = 60
local function addMessageToFeed(userName, msg, privateUserTarget, isPrivateSender)
    if blockedUsers[userName:lower()] then return end

    local isMentioned = string.find(string.lower(msg), string.lower(lp.Name)) or string.find(string.lower(msg), "@" .. string.lower(lp.Name))

    local count = 0
    for _, child in ipairs(messageFeed:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then 
            count = count + 1 
        end
    end
    if count >= MAX_MESSAGES then
        for _, child in ipairs(messageFeed:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() break end
        end
    end

    local card = Instance.new("Frame", messageFeed)
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.BackgroundColor3 = isMentioned and Colors.MentionBg or Colors.Surface
    card.BackgroundTransparency = 0.4
    card.ClipsDescendants = true
    card.ZIndex = 9
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    local cardScale = Instance.new("UIScale", card)
    cardScale.Scale = 0.88
    TweenService:Create(cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    local accentStrip = Instance.new("Frame", card)
    accentStrip.Size = UDim2.new(0, 3, 1, 0)
    accentStrip.Position = UDim2.new(0, 0, 0, 0)
    accentStrip.BorderSizePixel = 0
    accentStrip.BackgroundColor3 = isMentioned and Colors.MentionGold or (privateUserTarget and Colors.Purple or (Admin[userName:lower()] and Color3.fromRGB(255, 45, 85) or Colors.Primary))
    accentStrip.ZIndex = 10

    local cardStroke = Instance.new("UIStroke", card)
    cardStroke.Thickness = isMentioned and 1.5 or 1
    cardStroke.Transparency = isMentioned and 0.2 or 0.85
    cardStroke.Color = isMentioned and Colors.MentionGold or Colors.PrimaryDark

    local avatarImg = Instance.new("ImageLabel", card)
    avatarImg.Size = UDim2.fromOffset(26, 26)
    avatarImg.Position = UDim2.fromOffset(9, 6)
    avatarImg.BackgroundColor3 = Colors.Background
    avatarImg.BackgroundTransparency = 0.4
    avatarImg.ZIndex = 11
    Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)

    task.spawn(function()
        local targetPlr = Players:FindFirstChild(userName)
        local uId = targetPlr and targetPlr.UserId or userIdCache[userName:lower()]
        if not uId then
            pcall(function()
                uId = Players:GetUserIdFromNameAsync(userName)
                userIdCache[userName:lower()] = uId
            end)
        end
        if uId and avatarImg and avatarImg.Parent then
            avatarImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", uId)
        end
    end)

    local txt = Instance.new("TextLabel", card)
    txt.Size = UDim2.new(1, -44, 0, 0)
    txt.Position = UDim2.fromOffset(42, 6)
    txt.AutomaticSize = Enum.AutomaticSize.Y
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Colors.Text
    txt.Font = Enum.Font.GothamMedium
    txt.TextSize = 11.5
    txt.TextWrapped = true
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.RichText = true
    txt.ZIndex = 10

    local timeStr = os.date("%H:%M")
    local timeTag = string.format("<font color='#657388'>[%s]</font> ", timeStr)

    local prefix = ""
    if Admin[userName:lower()] then
        prefix = "<font color='#FF4545'><b>[👑 DADDY]</b></font> "
    end

    if privateUserTarget then
        cardStroke.Color = Colors.Purple
        cardStroke.Transparency = 0.4
        local dmTag = isPrivateSender and ("<font color='#A032FF'>[🔐 To @" .. privateUserTarget .. "]</font> ") or ("<font color='#A032FF'>[🔐 From @" .. privateUserTarget .. "]</font> ")
        txt.Text = timeTag .. dmTag .. prefix .. string.format("<font color='#00FFC8'><b>%s:</b></font> %s", userName, msg)
    else
        txt.Text = timeTag .. prefix .. string.format("<font color='#00FFC8'><b>%s:</b></font> %s", userName, msg)
    end

    crispText(txt)

    local padFix = Instance.new("UIPadding", card)
    padFix.PaddingBottom = UDim.new(0, 6)

    if isMentioned and userName ~= lp.Name then
        playSFX("mention")
    end

    task.defer(function()
        messageFeed.CanvasPosition = Vector2.new(0, messageFeed.AbsoluteCanvasSize.Y)
    end)
end

