    local tagWidth = TextService:GetTextSize(bData.Title, 11, Enum.Font.GothamBlack, Vector2.new(1000, 20)).X + 4
    
    local badgeHost = Instance.new("Frame", bBtn)
    badgeHost.Size = UDim2.fromOffset(tagWidth, 18)
    badgeHost.AnchorPoint = Vector2.new(0, 0.5)
    badgeHost.Position = UDim2.new(0, 12, 0.5, 0)
    badgeHost.BackgroundTransparency = 1
    badgeHost.BorderSizePixel = 0
    badgeHost.ZIndex = 73

    local badgeGlow = Instance.new("TextLabel", badgeHost)
    badgeGlow.Size = UDim2.fromScale(1, 1)
    badgeGlow.BackgroundTransparency = 1
    badgeGlow.BorderSizePixel = 0
    badgeGlow.Text = bData.Title
    badgeGlow.TextColor3 = Color3.fromRGB(255, 255, 255)
    badgeGlow.TextTransparency = 0.50
    badgeGlow.Font = Enum.Font.GothamBlack
    badgeGlow.TextSize = 11
    badgeGlow.ZIndex = 73

    local glowStroke = Instance.new("UIStroke", badgeGlow)
    glowStroke.Thickness = 1.2
    glowStroke.Transparency = 0.55
    glowStroke.Color = Color3.fromRGB(255, 255, 255)

    local badgeLabel = Instance.new("TextLabel", badgeHost)
    badgeLabel.Size = UDim2.fromScale(1, 1)
    badgeLabel.BackgroundTransparency = 1
    badgeLabel.BorderSizePixel = 0
    badgeLabel.Text = bData.Title
    badgeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    badgeLabel.Font = Enum.Font.GothamBlack
    badgeLabel.TextSize = 11
    badgeLabel.ZIndex = 74

    local bStroke = Instance.new("UIStroke", badgeLabel)
    bStroke.Thickness = 0.8
    bStroke.Color = Color3.fromRGB(0, 0, 0)
    bStroke.Transparency = 0.3

    local badgeShine = Instance.new("TextLabel", badgeHost)
    badgeShine.Size = UDim2.fromScale(1, 1)
    badgeShine.BackgroundTransparency = 1
    badgeShine.BorderSizePixel = 0
    badgeShine.Text = bData.Title
    badgeShine.TextColor3 = Color3.fromRGB(255, 255, 255)
    badgeShine.Font = Enum.Font.GothamBlack
    badgeShine.TextSize = 11
    badgeShine.ZIndex = 75

    local shineGrad = Instance.new("UIGradient", badgeShine)
    shineGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.48, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 255, 255))
    })
    shineGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.0, 1),
        NumberSequenceKeypoint.new(0.45, 1),
        NumberSequenceKeypoint.new(0.5, 0.05),
        NumberSequenceKeypoint.new(0.55, 1),
        NumberSequenceKeypoint.new(1.0, 1)
    })

    local textGrad = Instance.new("UIGradient", badgeLabel)
    textGrad.Color = ColorSequence.new(bData.Colors)

    local glowGrad = Instance.new("UIGradient", badgeGlow)
    glowGrad.Color = ColorSequence.new(bData.Colors)

    local strokeGradGlow = Instance.new("UIGradient", glowStroke)
    strokeGradGlow.Color = ColorSequence.new(bData.Colors)

    table.insert(activeBadgesList, {
        textGrad = textGrad, glowGrad = glowGrad, strokeGradGlow = strokeGradGlow,
        shineGrad = shineGrad, badgeGlow = badgeGlow, glowStroke = glowStroke,
        speed = bData.Speed or 1.15
    })

    local dotIndicator = Instance.new("Frame", bBtn)
    dotIndicator.Size = UDim2.fromOffset(8, 8)
    dotIndicator.AnchorPoint = Vector2.new(1, 0.5)
    dotIndicator.Position = UDim2.new(1, -12, 0.5, 0)
    dotIndicator.BackgroundColor3 = Color3.fromRGB(50, 255, 140)
    dotIndicator.BackgroundTransparency = (currentOwnerBadge == bKey) and 0.1 or 1
    dotIndicator.ZIndex = 74
    Instance.new("UICorner", dotIndicator).CornerRadius = UDim.new(1, 0)
    
    local dStroke = Instance.new("UIStroke", dotIndicator)
    dStroke.Color = Color3.fromRGB(0, 0, 0)
    dStroke.Transparency = (currentOwnerBadge == bKey) and 0.4 or 1
    
    modalSelectionIndicators[bKey] = {dot = dotIndicator, stroke = dStroke}

    applySpringHover(bBtn)
    bBtn.MouseButton1Click:Connect(function()
        currentOwnerBadge = bKey
        for k, ind in pairs(modalSelectionIndicators) do
            ind.dot.BackgroundTransparency = (k == currentOwnerBadge) and 0.1 or 1
            ind.stroke.Transparency = (k == currentOwnerBadge) and 0.4 or 1
        end
        
        TweenService:Create(bsmScale, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0}):Play()
        task.delay(0.2, function()
            isBadgeModalOpen = false
            badgeSelectorModal.Visible = false
        end)
        playSFX("default")
    end)
end

