    vLbl.Font = Enum.Font.Code
    vLbl.TextSize = 10
    vLbl.TextXAlignment = Enum.TextXAlignment.Right
    crispText(vLbl)

    local bar = Instance.new("Frame", container)
    bar.Size = UDim2.new(1, -8, 0, 4)
    bar.Position = UDim2.new(0, 4, 0, 24)
    bar.BackgroundColor3 = Colors.SurfaceHover
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((defaultVal - min)/(max - min), 0, 1, 0)
    fill.BackgroundColor3 = Colors.Primary
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", fill)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(1, 0, 0.5, 0)
    knob.BackgroundColor3 = Colors.Text
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local knobDot = Instance.new("Frame", knob)
    knobDot.Size = UDim2.new(0, 4, 0, 4)
    knobDot.AnchorPoint = Vector2.new(0.5, 0.5)
    knobDot.Position = UDim2.fromScale(0.5, 0.5)
    knobDot.BackgroundColor3 = Colors.PrimaryDark
    Instance.new("UICorner", knobDot).CornerRadius = UDim.new(1, 0)

    local hit = Instance.new("TextButton", container)
    hit.Size = UDim2.new(1, 0, 0, 24)
    hit.Position = UDim2.new(0, 0, 0, 14)
    hit.BackgroundTransparency = 1
    hit.Text = ""

    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        TweenService:Create(fill, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        local val = math.floor((min + (pos * (max - min))) * 10) / 10
        vLbl.Text = tostring(val)
        callback(val)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            TweenService:Create(knob, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            TweenService:Create(knobDot, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 8, 0, 8)}):Play()
            update(input)
        end
    end)
    hit.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            TweenService:Create(knob, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Size = UDim2.new(0, 12, 0, 12)}):Play()
            TweenService:Create(knobDot, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 4, 0, 4)}):Play()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

