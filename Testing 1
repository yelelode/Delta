local tTime = 0
RunService.RenderStepped:Connect(function(dt)
    if _G.TXR_BangInstance ~= currentExecutionID or not gui.Parent then return end
    tTime = tTime + dt
    if mainFrame.Visible then
        strokeGrad.Rotation = (tTime * 40) % 360
        bgGradient.Rotation = ((tTime * 40)/2) - 45
        local breath = (math.sin(tTime * 3) + 1) / 2 
        aura.ImageTransparency = 0.45 + (breath * 0.15)
        mainStroke.Transparency = 0.15 + (breath * 0.2)
        titleGrad.Offset = Vector2.new(math.sin(tTime * 2) * 0.3, 0)
        scanlines.Position = UDim2.new(0, 0, (tTime * 0.08) % 1 - 1, 0)
    end
    
    if openBtnContainer.Visible then
        local targetSpeed = (activeMode ~= nil) and 3 or 1
        local activeT = tTime * 3 * targetSpeed
        local baseColor1 = (activeMode ~= nil) and Colors.Danger or Colors.Primary
        local baseColor2 = (activeMode ~= nil) and Colors.Purple or Colors.ActiveTint
        local lerpAlpha = (math.sin(activeT * 0.8) + 1) / 2
        
        coreGlow.ImageColor3 = baseColor1:Lerp(baseColor2, lerpAlpha)
        coreGlow.ImageTransparency = 0.4 + (math.sin(activeT) * 0.25)
        orbStroke.Color = baseColor1
        
        local gPulse = 40 + (math.sin(activeT * 2) * 3)
        gimbals[1].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 0.8)), gPulse)
        gimbals[1].frame.Rotation = (activeT * 20) % 360
        gimbals[1].stroke.Color = baseColor1
        
        gimbals[2].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 0.9)))
        gimbals[2].frame.Rotation = -(activeT * 25) % 360
        gimbals[2].stroke.Color = baseColor2
        
        gimbals[3].frame.Size = UDim2.fromOffset(gPulse * math.abs(math.cos(activeT * 1.1)), gPulse)
        gimbals[3].frame.Rotation = 45 + (activeT * 15) % 360
        gimbals[3].stroke.Color = baseColor1:Lerp(Color3.new(1,1,1), 0.5)
        
        gimbals[4].frame.Size = UDim2.fromOffset(gPulse, gPulse * math.abs(math.sin(activeT * 1.2)))
        gimbals[4].frame.Rotation = -45 - (activeT * 15) % 360
        gimbals[4].stroke.Color = baseColor2:Lerp(Color3.new(1,1,1), 0.5)
    end
end)

local function makeDraggableHeader(frame, handle)
    local dragStart, startPos
    local dragging = false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            aura.Position = frame.Position
        end
    end)
end
