startBang = function(mode)
    if not PlayerSelected then
        sendNotif("⚠️ ERROR", "Select target first.")
        return false
    end
    if PlayerSelected == LP then
        sendNotif("⚠️ ERROR", "Cannot select self.")
        return false
    end

    local TargetChar = PlayerSelected.Character
    local TargetHRP = TargetChar and TargetChar:FindFirstChild("HumanoidRootPart")
    local TargetHum = TargetChar and TargetChar:FindFirstChild("Humanoid")
    if not TargetHRP or not TargetHum or TargetHum.Health <= 0 then
        sendNotif("⚠️ WAITING", "Target currently dead, awaiting respawn...")
    end

    stopBang()
    activeMode = mode
    playAnim()
    listenToTargetReset()

    antiVoidProtectionConnection = RunService.Heartbeat:Connect(function()
        if not activeMode then return end
        local myChar = LP.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if myHum then
            secureHumanoid(myHum)
            if myHum.Health < 100 and myHum.Health > 0 then pcall(function() myHum.Health = 100 end) end
        end

        if myHRP and (myHRP.Position.Y > 20000 or myHRP.Position.Y < -5000) then
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    noclipConnection = RunService.Stepped:Connect(function()
        if not activeMode then return end
        local myChar = LP.Character
        if myChar then
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if myHum and myHum.Sit then myHum.Sit = false end
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch = false
                    part.CanQuery = false
                end
            end
        end
    end)

    local stepSignal = RunService.PreSimulation or RunService.RenderStepped

    bangConnection = stepSignal:Connect(function(deltaTime)
        if not activeMode then return end

        local dt = (type(deltaTime) == "number" and deltaTime > 0) and deltaTime or 0.016
        local tChar = PlayerSelected and PlayerSelected.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHead = tChar and (tChar:FindFirstChild("Head") or tHrp)
        local tHum = tChar and tChar:FindFirstChild("Humanoid")
        local myChar = LP.Character
        local currentHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if not tHrp or not tHum or tHum.Health <= 0 or not currentHRP or not tHead then return end

        spoofNetwork(currentHRP)

        if SpectateFaceCam then
            if Camera.CameraSubject ~= tHead then Camera.CameraSubject = tHead end
        end

        local t = os.clock() * BangSpeed
        local wave = (math.sin(t) + 1) / 2
        local targetVel = tHrp.AssemblyLinearVelocity
        local pingOffset = targetVel * (dt * ((targetVel.Magnitude > 0.5) and 2.4 or 1.0))
        local baseCFrame = tHrp.CFrame
        if tHum.Sit and tHum.SeatPart then baseCFrame = tHum.SeatPart.CFrame end

        if activeMode == "Head" then
            local currentDist = 0.4 + (wave * (BangDistance * 0.55))
            local headCF = tHead.CFrame
            local facePos = (headCF.Position + pingOffset) + (headCF.LookVector * currentDist)
            local finalPos = Vector3.new(facePos.X, headCF.Position.Y + HeadHeightOffset + pingOffset.Y, facePos.Z)
            currentHRP.CFrame = CFrame.lookAt(finalPos, headCF.Position + pingOffset + Vector3.new(0, HeadHeightOffset, 0))
        else
            local currentDist = 0.7 + (wave * BangDistance)
            local finalPos = (baseCFrame + pingOffset) * CFrame.new(0, 0, currentDist)
            currentHRP.CFrame = CFrame.lookAt(finalPos.Position, baseCFrame.Position + pingOffset)
        end

        currentHRP.AssemblyLinearVelocity = targetVel
        currentHRP.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

