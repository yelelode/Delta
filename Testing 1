local function animateWaterfall(container)
    local currentID = (container:GetAttribute("WaterfallID") or 0) + 1
    container:SetAttribute("WaterfallID", currentID)
    task.spawn(function()
        local items = {}
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
                table.insert(items, child)
                local scale = child:FindFirstChildOfClass("UIScale")
                if not scale then scale = Instance.new("UIScale", child) end
                scale.Scale = 0
            end
        end
        table.sort(items, function(a, b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
        for _, child in ipairs(container:GetAttribute("WaterfallID") ~= currentID and {} or items) do
            local scale = child:FindFirstChildOfClass("UIScale")
            if scale then
                TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                task.wait(0.03)
            end
        end
    end)
end

-- 🚀 SMART HOVER & CLICK ENGINE
local function applySmartHover(btn, isToggleActive)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    btnScale.Scale = 1
    local corner = btn:FindFirstChildOfClass("UICorner") or Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 8) 
    
    if not btn:GetAttribute("BaseColor") then btn:SetAttribute("BaseColor", btn.BackgroundColor3) end

    local hoverInInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local hoverOutInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local isHovered = false

    btn.MouseEnter:Connect(function()
        isHovered = true
        TweenService:Create(btnScale, hoverInInfo, {Scale = 1.05}):Play()
        TweenService:Create(corner, hoverInInfo, {CornerRadius = UDim.new(1, 0)}):Play() 
        if not isToggleActive or not isToggleActive() then 
            TweenService:Create(btn, hoverInInfo, { BackgroundColor3 = Colors.SurfaceHover }):Play() 
        end
    end)

    btn.MouseLeave:Connect(function()
        isHovered = false
        TweenService:Create(btnScale, hoverOutInfo, {Scale = 1}):Play()
        TweenService:Create(corner, hoverOutInfo, {CornerRadius = UDim.new(0, 8)}):Play() 
        if not isToggleActive or not isToggleActive() then 
            TweenService:Create(btn, hoverOutInfo, { BackgroundColor3 = btn:GetAttribute("BaseColor") }):Play() 
        end
    end)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            CreateRipple(btn, input.Position.X, input.Position.Y)
            TweenService:Create(btnScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {Scale = 0.9}):Play()
        end
    end)
    
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(btnScale, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = isHovered and 1.05 or 1}):Play()
        end
    end)
end

