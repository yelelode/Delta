-- 🥷 500 Props Error UI Suppressor
local function suppressPropMenu()
    pcall(function()
        local pGui = lp:FindFirstChild("PlayerGui")
        if pGui then
            for _, v in ipairs(pGui:GetDescendants()) do
                if v:IsA("TextLabel") and string.find(string.lower(v.Text), "props") and string.find(v.Text, "500") then
                    local parentFrame = v
                    for i = 1, 6 do
                        if parentFrame.Parent and parentFrame.Parent:IsA("Frame") then
                            parentFrame = parentFrame.Parent
                            if parentFrame.Visible then
                                parentFrame.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- Player ke active props scan karo
local function getAllMyProps()
    local props = {}
    local com = workspace:FindFirstChild("WorkspaceCom")
    if com then
        for _, folder in ipairs(com:GetChildren()) do
            for _, ch in ipairs(folder:GetChildren()) do
                if string.find(ch.Name, "Prop") and string.find(ch.Name, lp.Name) then
                    table.insert(props, ch)
                end
            end
        end
    end
    return props
end

-- 🔍 TARGET JIS HOUSE MEIN HAI USKA DATA NIKALO
local function getHouseTargetIsIn(targetPos)
    local lotsFolder = workspace:FindFirstChild("001_Lots") or workspace:FindFirstChild("Lots")
    if not lotsFolder then return nil end

    for _, lot in ipairs(lotsFolder:GetChildren()) do
        local picked = lot:FindFirstChild("HousePickedByPlayer")
        if picked and picked.Value and picked.Value ~= "" then
            local lotCFrame, lotSize = lot:GetBoundingBox()
            local rel = lotCFrame:PointToObjectSpace(targetPos)
            
            local halfX = (lotSize.X / 2)
            local halfZ = (lotSize.Z / 2)
            
            -- Exact boundary calculation (agar 1 cm bhi bahar hai to false hoga)
            if math.abs(rel.X) <= halfX and math.abs(rel.Z) <= halfZ and rel.Y >= -10 and rel.Y <= 80 then
                return lot
            end
        end
    end
    return nil
end

-- 🛡️ HOUSE BAN-PROPS STATE DETECTOR
local function isHouseBanPropsActive(lot)
    if not lot then return false end
    
    local picked = lot:FindFirstChild("HousePickedByPlayer")
    local houseModel = picked and picked:FindFirstChild("HouseModel")
    
    -- State 1: Banned list check (Agar target ya universal props banned state me hain)
    local disallowRemote = (houseModel and houseModel:FindFirstChild("Permissions:Disallow", true)) or lot:FindFirstChild("Permissions:Disallow", true)
    local clearRemote = (houseModel and houseModel:FindFirstChild("Permissions:ClearProps", true)) or lot:FindFirstChild("Permissions:ClearProps", true)
    
    -- State 2: Brookhaven attributes / values check (Prop ban toggle state)
    local banSetting = lot:FindFirstChild("BanProps") or (houseModel and houseModel:FindFirstChild("BanProps"))
    if banSetting and (banSetting.Value == true or banSetting.Value == 1) then
        return true
    end

    -- State 3: Permissions folder inspection (Disallowed players / Banned Props tag)
    local permFolder = lot:FindFirstChild("Permissions") or (houseModel and houseModel:FindFirstChild("Permissions"))
    if permFolder then
        local propBanVal = permFolder:FindFirstChild("PropBan") or permFolder:FindFirstChild("ClearPropsActive")
        if propBanVal and (propBanVal.Value == true or propBanVal.Value == 1) then
            return true
        end
        
        local disallowList = permFolder:FindFirstChild("Disallowed")
        if disallowList and (disallowList:FindFirstChild(lp.Name) or disallowList:FindFirstChild("All")) then
            return true
        end
    end

    -- State 4: Recent Wipe Detection (Agar house continuous clear invoke kar raha ho)
    if lot:GetAttribute("PropBanActive") == true then
        return true
    end

    return false
end

-- Check karega ki target aisi jagah hai jahan BAN PROPS actually ON hai
local function isTargetInActiveBanProps()
    local targetPlrs = {}
    
    if _G.TXR_ActiveModes and _G.TXR_ActiveModes["SelectedTargetList"] then
        targetPlrs = _G.TXR_ActiveModes["SelectedTargetList"]
    end

    local validTargetCount = 0
    local targetBlockedCount = 0

    for plr, active in pairs(targetPlrs) do
        if active and plr and plr.Parent and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                validTargetCount = validTargetCount + 1
                local lot = getHouseTargetIsIn(hrp.Position)
                
                -- House ke andar hai AUR us house me ban props on hai
                if lot and isHouseBanPropsActive(lot) then
                    targetBlockedCount = targetBlockedCount + 1
                end
            end
        end
    end

    -- Agar active target valid hai aur wo active ban props zone me hai
    if validTargetCount > 0 and validTargetCount == targetBlockedCount then
        return true
    end

    return false
end

-- Mode target limit calculate karna
local function getModeTargetLimit()
    if _G.TXR_ActiveModes and _G.TXR_ActiveModes["Chair"] then
        return 0
    end

    local perTarget = 0
    if _G.TXR_ActiveModes then
        if _G.TXR_ActiveModes["Robot"] then perTarget = perTarget + 4 end
        if _G.TXR_ActiveModes["MultiRobot"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["HeadBang"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["Ring"] then perTarget = perTarget + 8 end
        if _G.TXR_ActiveModes["Orbit"] then perTarget = perTarget + 12 end
    end

    if perTarget == 0 then perTarget = 15 end

    local targets = _G.TXR_SelectedTargets or 1
    return math.clamp(perTarget * targets, 2, 30)
end

