-- =========================================================
-- ⚡ TXR AUTO PROPS SPAWN (EXACT LIMIT & INSTANT ATTACK ENGINE) ⚡
-- =========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local lp = Players.LocalPlayer

local function sendNotif(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 2
        })
    end)
end

if _G.TXR_AutoSpawnConnection then
    pcall(function() _G.TXR_AutoSpawnConnection:Disconnect() end)
    _G.TXR_AutoSpawnConnection = nil
end

_G.TXR_AutoSpawnActive = true
sendNotif("⚡ AUTO SPAWN", "Exact-Cap & Solo Attack Engine Loaded!")

local function suppressPropMenu()
    pcall(function()
        local pGui = lp:FindFirstChild("PlayerGui")
        if pGui then
            for _, v in ipairs(pGui:GetDescendants()) do
                if v:IsA("TextLabel") and string.find(string.lower(v.Text), "props") and string.find(v.Text, "500") then
                    local parentFrame = v
                    for i = 1, 6 do
                        if parentFrame.Parent and parentFrame.Parent:IsA("Frame") then
                            parentFrame = parentFrame.Parent
                            if parentFrame.Visible then
                                parentFrame.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function getAllMyProps()
    local props = {}
    local com = workspace:FindFirstChild("WorkspaceCom")
    if com then
        for _, folder in ipairs(com:GetChildren()) do
            for _, ch in ipairs(folder:GetChildren()) do
                if string.find(ch.Name, "Prop") and string.find(ch.Name, lp.Name) then
                    table.insert(props, ch)
                end
            end
        end
    end
    return props
end

local function getModeTargetLimit()
    if _G.TXR_ActiveModes and _G.TXR_ActiveModes["Chair"] then
        return 0
    end

    local perTarget = 0
    if _G.TXR_ActiveModes then
        if _G.TXR_ActiveModes["Robot"] then perTarget = perTarget + 4 end
        if _G.TXR_ActiveModes["MultiRobot"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["HeadBang"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["Ring"] then perTarget = perTarget + 8 end
        if _G.TXR_ActiveModes["Orbit"] then perTarget = perTarget + 12 end
    end

    if perTarget == 0 then perTarget = 6 end -- default strictly set to 6

    local targets = _G.TXR_SelectedTargets or 1
    return math.clamp(perTarget * targets, 2, 30)
end

local isSpawningLocked = false
local lastSpawnActionTime = 0

-- ⚡ PRECISION SYNC ENGINE
_G.TXR_AutoSpawnConnection = RunService.Heartbeat:Connect(function()
    if not _G.TXR_AutoSpawnActive then return end

    local targetLimit = getModeTargetLimit()
    if targetLimit == 0 then return end

    local now = os.clock()
    local myProps = getAllMyProps()
    local currentCount = #myProps

    suppressPropMenu()

    -- Hard Reset Lock jab tak props delete na ho
    if currentCount >= targetLimit then
        isSpawningLocked = false
        return
    end

    -- Duplicate burst ko exact count me lock rakhna
    if currentCount < targetLimit and not isSpawningLocked and (now - lastSpawnActionTime > 0.35) then
        isSpawningLocked = true
        lastSpawnActionTime = now

        task.spawn(function()
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local backpack = lp:FindFirstChild("Backpack")

            if not char or not hum or not root or hum.Health <= 0 then 
                isSpawningLocked = false 
                return 
            end

            local propName = _G.TXR_CustomPropName or "ScreensRobotBig"
            local propCategory = _G.TXR_CustomPropCategory or "Screens"

            -- CASE A: Ek bhi prop nahi hai (Pehla single prop banao)
            if currentCount == 0 then
                pcall(function()
                    local re = ReplicatedStorage:FindFirstChild("RE")
                    local clearRemote = re and re:FindFirstChild("1Clea1rTool1s")
                    if clearRemote then
                        clearRemote:FireServer("RequestingPropName", propName, propCategory)
                    end
                end)

                local tool = char:FindFirstChild("PropMaker") or (backpack and backpack:FindFirstChild("PropMaker"))
                local wasAlreadyEquipped = (tool and tool.Parent == char)

                if tool then
                    if not wasAlreadyEquipped then
                        tool.Parent = char
                        RunService.Heartbeat:Wait()
                    end

                    local toolRemote = tool:FindFirstChild("Tool_PropMake")
                    if toolRemote then
                        local spawnPos = root.Position + (root.CFrame.LookVector * 3)
                        pcall(function() toolRemote:FireServer(workspace.Terrain, spawnPos) end)
                    end

                    if not wasAlreadyEquipped and backpack then
                        tool.Parent = backpack
                    end
                end

                -- 1st robot ko instantly register karo taaki wo akele attack chalu kar sake
                local firstProp = nil
                for i = 1, 40 do
                    local check = getAllMyProps()
                    if #check > 0 then
                        firstProp = check[1]
                        break
                    end
                    task.wait(0.02)
                end

                -- Remaining exact duplicate burst
                if firstProp then
                    local dupRemote = firstProp:FindFirstChild("DuplicateProp")
                    if dupRemote then
                        local remainingNeeded = targetLimit - #getAllMyProps()
                        for i = 1, remainingNeeded do
                            task.spawn(function()
                                pcall(function() dupRemote:InvokeServer() end)
                            end)
                            task.wait(0.02) -- Millisecond spacing taaki over-spawn (11 props) na ho
                        end
                    end
                end

            -- CASE B: Partial Props Lost (Bina wait kiye bache hue exact slot fill karna)
            else
                local dupRemote = nil
                for _, p in ipairs(myProps) do
                    local d = p:FindFirstChild("DuplicateProp")
                    if d and d.Parent then
                        dupRemote = d
                        break
                    end
                end

                if dupRemote then
                    local neededNow = targetLimit - #getAllMyProps()
                    if neededNow > 0 then
                        for i = 1, neededNow do
                            task.spawn(function()
                                pcall(function() dupRemote:InvokeServer() end)
                            end)
                            task.wait(0.02)
                        end
                    end
                end
            end

            -- Verify final count
            task.wait(0.2)
            isSpawningLocked = false
        end)
    end
end)
