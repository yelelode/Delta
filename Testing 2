-- 🏠 REAL-TIME EVENT HOOK ON ALL HOUSES / LOTS
local function bindLotListeners(lot)
    local function evaluateLotBanState()
        local isBanned = false
        local picked = lot:FindFirstChild("HousePickedByPlayer")
        local houseModel = picked and picked:FindFirstChild("HouseModel")

        -- 1. Value/Attribute checks
        if lot:GetAttribute("PropBanActive") == true then
            isBanned = true
        end

        local banSetting = lot:FindFirstChild("BanProps") or (houseModel and houseModel:FindFirstChild("BanProps"))
        if banSetting and (banSetting.Value == true or banSetting.Value == 1) then
            isBanned = true
        end

        local permFolder = lot:FindFirstChild("Permissions") or (houseModel and houseModel:FindFirstChild("Permissions"))
        if permFolder then
            local propBanVal = permFolder:FindFirstChild("PropBan") or permFolder:FindFirstChild("ClearPropsActive")
            if propBanVal and (propBanVal.Value == true or propBanVal.Value == 1) then
                isBanned = true
            end
            local disallowList = permFolder:FindFirstChild("Disallowed")
            if disallowList and (disallowList:FindFirstChild(lp.Name) or disallowList:FindFirstChild("All")) then
                isBanned = true
            end
        end

        ActiveBanHouses[lot] = isBanned
    end

    -- Initial state calculation
    evaluateLotBanState()
    local cf, sz = lot:GetBoundingBox()
    PlotBoundingBoxes[lot] = {CFrame = cf, Size = sz}

    -- Instant Event Listeners (Zero Polling Overhead)
    local con1 = lot.DescendantAdded:Connect(function() evaluateLotBanState() end)
    local con2 = lot.DescendantRemoving:Connect(function() evaluateLotBanState() end)
    local con3 = lot.AttributeChanged:Connect(function() evaluateLotBanState() end)

    table.insert(_G.TXR_PlotEventCleanups, con1)
    table.insert(_G.TXR_PlotEventCleanups, con2)
    table.insert(_G.TXR_PlotEventCleanups, con3)
end

-- Initialize listeners across all plots
local lotsFolder = workspace:FindFirstChild("001_Lots") or workspace:FindFirstChild("Lots")
if lotsFolder then
    for _, lot in ipairs(lotsFolder:GetChildren()) do
        bindLotListeners(lot)
    end
    local folderCon = lotsFolder.ChildAdded:Connect(function(newLot)
        task.wait(0.2)
        bindLotListeners(newLot)
    end)
    table.insert(_G.TXR_PlotEventCleanups, folderCon)
end

-- Player ke active props scan karo
local function getAllMyProps()
    local props = {}
    local com = workspace:FindFirstChild("WorkspaceCom")
    if com then
        for _, folder in ipairs(com:GetChildren()) do
            for _, ch in ipairs(folder:GetChildren()) do
                if string.find(ch.Name, "Prop") and string.find(ch.Name, lp.Name) then
                    table.insert(props, ch)
                end
            end
        end
    end
    return props
end

-- Check if target is inside an ACTIVE ban lot using cached data
local function isTargetInBannedHouse(targetPos)
    for lot, isBanned in pairs(ActiveBanHouses) do
        if isBanned then
            local data = PlotBoundingBoxes[lot]
            if data then
                local rel = data.CFrame:PointToObjectSpace(targetPos)
                local halfX = (data.Size.X / 2)
                local halfZ = (data.Size.Z / 2)
                
                -- Exact 1cm edge check
                if math.abs(rel.X) <= halfX and math.abs(rel.Z) <= halfZ and rel.Y >= -10 and rel.Y <= 80 then
                    return true
                end
            end
        end
    end
    return false
end

local function areAllTargetsBlocked()
    local targetPlrs = {}
    if _G.TXR_ActiveModes and _G.TXR_ActiveModes["SelectedTargetList"] then
        targetPlrs = _G.TXR_ActiveModes["SelectedTargetList"]
    end

    local validCount = 0
    local blockedCount = 0

    for plr, active in pairs(targetPlrs) do
        if active and plr and plr.Parent and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                validCount = validCount + 1
                if isTargetInBannedHouse(hrp.Position) then
                    blockedCount = blockedCount + 1
                end
            end
        end
    end

    return (validCount > 0 and validCount == blockedCount)
end

local function getModeTargetLimit()
    if _G.TXR_ActiveModes and _G.TXR_ActiveModes["Chair"] then
        return 0
    end

    local perTarget = 0
    if _G.TXR_ActiveModes then
        if _G.TXR_ActiveModes["Robot"] then perTarget = perTarget + 4 end
        if _G.TXR_ActiveModes["MultiRobot"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["HeadBang"] then perTarget = perTarget + 2 end
        if _G.TXR_ActiveModes["Ring"] then perTarget = perTarget + 8 end
        if _G.TXR_ActiveModes["Orbit"] then perTarget = perTarget + 12 end
    end

    if perTarget == 0 then perTarget = 15 end
    local targets = _G.TXR_SelectedTargets or 1
    return math.clamp(perTarget * targets, 2, 30)
end

