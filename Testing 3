-- =========================================================
-- ⚙️ CORE ENGINE STATES & KINEMATICS
-- =========================================================
local isActive = false
local loopStepped = nil
local loopHeartbeat = nil
local jumpConnection = nil
local stateConnection = nil

local MAX_SAFE_LIMIT = 96.5
local isAirborne = false
local airVelY = 0

local function getJumpImpulse(hum)
    local g = workspace.Gravity
    if g <= 0 then g = 196.2 end
    if hum.UseJumpPower then
        local jp = hum.JumpPower
        return (jp > 0 and jp) or 50
    else
        local jh = hum.JumpHeight
        jh = (jh > 0 and jh) or 7.2
        return math.sqrt(2 * g * jh)
    end
end

local function onJumpTrigger()
    if not isActive then return end
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.FloorMaterial ~= Enum.Material.Air and not isAirborne then
        isAirborne = true
        airVelY = getJumpImpulse(hum)
    end
end

local function startVoidLock()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    isAirborne = false
    airVelY = 0

    -- JUMP LISTENERS (Mobile Screen Button & PC Spacebar)
    jumpConnection = UserInputService.JumpRequest:Connect(onJumpTrigger)
    stateConnection = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping then
            onJumpTrigger()
        elseif new == Enum.HumanoidStateType.Landed then
            isAirborne = false
            airVelY = 0
        end
    end)

    -- 1. STEPPED: Local Physics Engine (Smooth Walk, Natural Air Arc & Ghost Stripper)
    loopStepped = RunService.Stepped:Connect(function(_, dt)
        if not isActive or not root or not hum then return end

        local vel = root.AssemblyLinearVelocity
        local g = (workspace.Gravity > 0 and workspace.Gravity) or 196.2
        local onFloor = (hum.FloorMaterial ~= Enum.Material.Air)

        -- Glitch-Free Kinematic Jump Simulation
        if isAirborne then
            airVelY = airVelY - (g * dt)
            if onFloor and airVelY < 0 then
                isAirborne = false
                airVelY = 0
                root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            else
                root.AssemblyLinearVelocity = Vector3.new(vel.X, airVelY, vel.Z)
            end
        else
            if not onFloor then
                isAirborne = true
                airVelY = -4
                root.AssemblyLinearVelocity = Vector3.new(vel.X, airVelY, vel.Z)
            else
                root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        end

        if hum.Sit then hum.Sit = false end
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

        -- Local Part Immunity (Anti-Fling & Clean Floor Contact)
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end

        -- Auto-Strip Hostile Welds
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("Weld") and (v.Name == "SeatWeld" or string.find(v.Name:lower(), "seat")) then
                pcall(function() v:Destroy() end)
            end
        end

        -- PREEMPTIVE COUNTER: Hostile Prop Ghost-Stripper (Disables collisions & touch triggers)
        local com = workspace:FindFirstChild("WorkspaceCom")
        if com then
            for _, folder in ipairs(com:GetChildren()) do
                for _, prop in ipairs(folder:GetChildren()) do
                    if string.sub(prop.Name, 1, 4) == "Prop" and string.sub(prop.Name, 5) ~= lp.Name then
                        for _, part in ipairs(prop:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.CanTouch = false
                            end
                        end
                    end
                end
            end
        end
    end)

    -- 2. HEARTBEAT: Server Replication (Sub-100 Vector Budgeting + Ground Micro-Dip)
    loopHeartbeat = RunService.Heartbeat:Connect(function()
        if not isActive or not root or not hum then return end

        local currentVel = root.AssemblyLinearVelocity
        local hSpeedSq = (currentVel.X * currentVel.X) + (currentVel.Z * currentVel.Z)

        local targetY = -MAX_SAFE_LIMIT
        if hSpeedSq > 0 then
            local remainSq = (MAX_SAFE_LIMIT * MAX_SAFE_LIMIT) - hSpeedSq
            if remainSq > 400 then
                targetY = -math.sqrt(remainSq)
            else
                targetY = -55.0
            end
        end

        -- Replicate safe downward vector to server (Keeps robots deep underground)
        root.AssemblyLinearVelocity = Vector3.new(currentVel.X, targetY, currentVel.Z)

        -- Micro-Dip ONLY on Ground (Protects against Delta-Position math; skipped while jumping)
        if not isAirborne and hum.FloorMaterial ~= Enum.Material.Air then
            if math.floor(os.clock() * 60) % 2 == 0 then
                root.CFrame = root.CFrame * CFrame.new(0, -0.04, 0)
            end
        end
    end)
end

local function stopVoidLock()
    if loopStepped then loopStepped:Disconnect() loopStepped = nil end
    if loopHeartbeat then loopHeartbeat:Disconnect() loopHeartbeat = nil end
    if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end
    if stateConnection then stateConnection:Disconnect() stateConnection = nil end

    isAirborne = false
    airVelY = 0

    if lp.Character then
        local root = lp.Character:FindFirstChild("HumanoidRootPart")
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        if root then root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end
    end
end

-- Store cleanup in global table for re-execution safety
_G.TXR_VoidLock_Cleanup = stopVoidLock

