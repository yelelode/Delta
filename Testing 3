-- =========================================================
-- 🕳️ TXR ANTI-ROBOT (HEADLESS AUTO-TOGGLE MODULE - TESTING 3)
-- Features: Direct Main-Script Toggle (No Extra Screen Buttons)
-- =========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local lp = Players.LocalPlayer

-- =========================================================
-- 🔐 ADMIN ACCESS / WHITELIST SYSTEM
-- =========================================================
local ADMIN_WHITELIST = {
    [9685785248] = true, -- Ashu Papa (Main ID)
    [lp.UserId] = true,  -- Script Executor ID
    [lp.Name] = true,    -- Script Executor Name

    -- Yahan Nothing Panel ke tagged accounts ya trusted IDs add kar sakte ho:
    -- [123456789] = true,
    -- ["TargetUsername"] = true,
}

local function checkAdminAccess(player)
    player = player or lp
    return (ADMIN_WHITELIST[player.UserId] == true or ADMIN_WHITELIST[player.Name] == true)
end

local function sendNotify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 2.5
        })
    end)
end

-- Admin Verification
if not checkAdminAccess(lp) then
    sendNotify("🔒 ACCESS DENIED", "Need admin access", 2.5)
    return
end

-- Purana floating GUI agar bacha ho toh safely destroy karna
if _G.VoidBypassGui then
    pcall(function() _G.VoidBypassGui:Destroy() end)
    _G.VoidBypassGui = nil
end

-- =========================================================
-- 🛑 DEACTIVATION ENGINE (CLEANUP)
-- =========================================================
local function stopVoidLock()
    if _G.TXR_Void_Stepped then
        pcall(function() _G.TXR_Void_Stepped:Disconnect() end)
        _G.TXR_Void_Stepped = nil
    end
    if _G.TXR_Void_Heartbeat then
        pcall(function() _G.TXR_Void_Heartbeat:Disconnect() end)
        _G.TXR_Void_Heartbeat = nil
    end
    if _G.TXR_Void_JumpConn then
        pcall(function() _G.TXR_Void_JumpConn:Disconnect() end)
        _G.TXR_Void_JumpConn = nil
    end
    if _G.TXR_Void_StateConn then
        pcall(function() _G.TXR_Void_StateConn:Disconnect() end)
        _G.TXR_Void_StateConn = nil
    end

    _G.TXR_Void_IsAirborne = false
    _G.TXR_Void_AirVelY = 0

    local char = lp.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end
    end
end

-- =========================================================
-- ⚡ ACTIVATION ENGINE (96.5 SAFE CLAMP + KINEMATIC JUMP)
-- =========================================================
local function startVoidLock()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local MAX_SAFE_LIMIT = 96.5
    _G.TXR_Void_IsAirborne = false
    _G.TXR_Void_AirVelY = 0

    local function getJumpImpulse()
        local g = workspace.Gravity
        if g <= 0 then g = 196.2 end
        if hum.UseJumpPower then
            local jp = hum.JumpPower
            return (jp > 0 and jp) or 50
        else
            local jh = hum.JumpHeight
            jh = (jh > 0 and jh) or 7.2
            return math.sqrt(2 * g * jh)
        end
    end

    local function onJumpTrigger()
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.FloorMaterial ~= Enum.Material.Air and not _G.TXR_Void_IsAirborne then
            _G.TXR_Void_IsAirborne = true
            _G.TXR_Void_AirVelY = getJumpImpulse()
        end
    end

    -- Jump Event Listeners
    _G.TXR_Void_JumpConn = UserInputService.JumpRequest:Connect(onJumpTrigger)
    _G.TXR_Void_StateConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping then
            onJumpTrigger()
        elseif new == Enum.HumanoidStateType.Landed then
            _G.TXR_Void_IsAirborne = false
            _G.TXR_Void_AirVelY = 0
        end
    end)

    -- 1. STEPPED: Local Physics Engine (Smooth Walk & Natural Jump Simulation)
    _G.TXR_Void_Stepped = RunService.Stepped:Connect(function(_, dt)
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end

        local vel = r.AssemblyLinearVelocity
        local g = (workspace.Gravity > 0 and workspace.Gravity) or 196.2
        local onFloor = (h.FloorMaterial ~= Enum.Material.Air)

        if _G.TXR_Void_IsAirborne then
            _G.TXR_Void_AirVelY = _G.TXR_Void_AirVelY - (g * dt)
            if onFloor and _G.TXR_Void_AirVelY < 0 then
                _G.TXR_Void_IsAirborne = false
                _G.TXR_Void_AirVelY = 0
                r.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            else
                r.AssemblyLinearVelocity = Vector3.new(vel.X, _G.TXR_Void_AirVelY, vel.Z)
            end
        else
            if not onFloor then
                _G.TXR_Void_IsAirborne = true
                _G.TXR_Void_AirVelY = -4
                r.AssemblyLinearVelocity = Vector3.new(vel.X, _G.TXR_Void_AirVelY, vel.Z)
            else
                r.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        end

        if h.Sit then h.Sit = false end
        h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

        for _, p in ipairs(c:GetChildren()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end

        for _, v in ipairs(c:GetDescendants()) do
            if v:IsA("Weld") and (v.Name == "SeatWeld" or string.find(v.Name:lower(), "seat")) then
                pcall(function() v:Destroy() end)
            end
        end

        -- Hostile Prop Ghost Stripper
        local com = workspace:FindFirstChild("WorkspaceCom")
        if com then
            for _, folder in ipairs(com:GetChildren()) do
                for _, prop in ipairs(folder:GetChildren()) do
                    if string.sub(prop.Name, 1, 4) == "Prop" and string.sub(prop.Name, 5) ~= lp.Name then
                        for _, part in ipairs(prop:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.CanTouch = false
                            end
                        end
                    end
                end
            end
        end
    end)

    -- 2. HEARTBEAT: Server Replication (Bypasses Nothing Panel 100-Clamp)
    _G.TXR_Void_Heartbeat = RunService.Heartbeat:Connect(function()
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end

        local currentVel = r.AssemblyLinearVelocity
        local hSpeedSq = (currentVel.X * currentVel.X) + (currentVel.Z * currentVel.Z)

        local targetY = -MAX_SAFE_LIMIT
        if hSpeedSq > 0 then
            local remainSq = (MAX_SAFE_LIMIT * MAX_SAFE_LIMIT) - hSpeedSq
            if remainSq > 400 then
                targetY = -math.sqrt(remainSq)
            else
                targetY = -55.0
            end
        end

        r.AssemblyLinearVelocity = Vector3.new(currentVel.X, targetY, currentVel.Z)

        -- Micro-Dip on alternate frames while grounded
        if not _G.TXR_Void_IsAirborne and h.FloorMaterial ~= Enum.Material.Air then
            if math.floor(os.clock() * 60) % 2 == 0 then
                r.CFrame = r.CFrame * CFrame.new(0, -0.04, 0)
            end
        end
    end)
end

-- =========================================================
-- 🔄 TOGGLE CONTROLLER (EXECUTES INSTANTLY ON MAIN BUTTON CLICK)
-- =========================================================
if _G.TXR_VoidLock_Active then
    _G.TXR_VoidLock_Active = false
    stopVoidLock()
    sendNotify("🛡️ ANTI ROBOTS", "Deactivated", 2)
else
    _G.TXR_VoidLock_Active = true
    startVoidLock()
    sendNotify("🛡️ ANTI ROBOTS", "Activated: 96.5 Safe-Void Active", 2.5)
end
