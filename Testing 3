-- =========================================================
-- 🕳️ TXR ANTI-ROBOT (ANTI-ZERO PREDICTION ENGINE - V5)
-- =========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local lp = Players.LocalPlayer

local ADMIN_WHITELIST = {
    [9685785248] = true,
    [lp.UserId] = true,
    [lp.Name] = true,
}

local function checkAdminAccess(player)
    player = player or lp
    return (ADMIN_WHITELIST[player.UserId] == true or ADMIN_WHITELIST[player.Name] == true)
end

local function sendNotify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 2
        })
    end)
end

if not checkAdminAccess(lp) then
    sendNotify("🔒 ACCESS DENIED", "Need admin access", 2.5)
    _G.TXR_VoidLock_Active = false
    return
end

local function stopVoidEngine()
    if _G.TXR_Void_Stepped then pcall(function() _G.TXR_Void_Stepped:Disconnect() end) _G.TXR_Void_Stepped = nil end
    if _G.TXR_Void_Heartbeat then pcall(function() _G.TXR_Void_Heartbeat:Disconnect() end) _G.TXR_Void_Heartbeat = nil end
    if _G.TXR_Void_JumpConn then pcall(function() _G.TXR_Void_JumpConn:Disconnect() end) _G.TXR_Void_JumpConn = nil end
    if _G.TXR_Void_StateConn then pcall(function() _G.TXR_Void_StateConn:Disconnect() end) _G.TXR_Void_StateConn = nil end

    _G.TXR_Void_IsAirborne = false
    _G.TXR_Void_AirVelY = 0

    local char = lp.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end
    end
end

local function startVoidEngine()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local SAFE_CLAMP = 96.4
    _G.TXR_Void_IsAirborne = false
    _G.TXR_Void_AirVelY = 0

    local function getJumpImpulse()
        local g = workspace.Gravity > 0 and workspace.Gravity or 196.2
        if hum.UseJumpPower then
            return (hum.JumpPower > 0 and hum.JumpPower) or 50
        else
            local jh = (hum.JumpHeight > 0 and hum.JumpHeight) or 7.2
            return math.sqrt(2 * g * jh)
        end
    end

    local function onJumpTrigger()
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.FloorMaterial ~= Enum.Material.Air and not _G.TXR_Void_IsAirborne then
            _G.TXR_Void_IsAirborne = true
            _G.TXR_Void_AirVelY = getJumpImpulse()
        end
    end

    _G.TXR_Void_JumpConn = UserInputService.JumpRequest:Connect(onJumpTrigger)
    _G.TXR_Void_StateConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping then
            onJumpTrigger()
        elseif new == Enum.HumanoidStateType.Landed then
            _G.TXR_Void_IsAirborne = false
            _G.TXR_Void_AirVelY = 0
        end
    end)

    -- Loop 1: Physics Lock, Joint Cleaner & Prop Stripper
    _G.TXR_Void_Stepped = RunService.Stepped:Connect(function(_, dt)
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end

        local vel = r.AssemblyLinearVelocity
        local g = workspace.Gravity > 0 and workspace.Gravity or 196.2
        local onFloor = (h.FloorMaterial ~= Enum.Material.Air)

        if _G.TXR_Void_IsAirborne then
            _G.TXR_Void_AirVelY = _G.TXR_Void_AirVelY - (g * dt)
            if onFloor and _G.TXR_Void_AirVelY < 0 then
                _G.TXR_Void_IsAirborne = false
                _G.TXR_Void_AirVelY = 0
                r.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            else
                r.AssemblyLinearVelocity = Vector3.new(vel.X, _G.TXR_Void_AirVelY, vel.Z)
            end
        else
            if not onFloor then
                _G.TXR_Void_IsAirborne = true
                _G.TXR_Void_AirVelY = -4
                r.AssemblyLinearVelocity = Vector3.new(vel.X, _G.TXR_Void_AirVelY, vel.Z)
            else
                r.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        end

        if h.Sit then h.Sit = false end
        h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

        -- Stripping Touches so 0-Prediction hits fail
        for _, p in ipairs(c:GetChildren()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                local tt = p:FindFirstChildOfClass("TouchTransmitter")
                if tt then tt:Destroy() end
            end
        end

        -- Destroy Seats & External Weld Constraints
        for _, v in ipairs(c:GetDescendants()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RigidConstraint") then
                if v.Name == "SeatWeld" or string.find(v.Name:lower(), "seat") then
                    pcall(function() v:Destroy() end)
                end
            end
        end

        -- Invalidate WorkspaceCom Target Collision
        local com = workspace:FindFirstChild("WorkspaceCom")
        if com then
            for _, folder in ipairs(com:GetChildren()) do
                for _, prop in ipairs(folder:GetChildren()) do
                    if string.sub(prop.Name, 1, 4) == "Prop" and string.sub(prop.Name, 5) ~= lp.Name then
                        for _, part in ipairs(prop:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.CanTouch = false
                                part.CanQuery = false
                            end
                        end
                    end
                end
            end
        end
    end)

    -- Loop 2: Anti Zero-Prediction Heartbeat (Coordinate Desync)
    _G.TXR_Void_Heartbeat = RunService.Heartbeat:Connect(function()
        if not _G.TXR_VoidLock_Active then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end

        local currentVel = r.AssemblyLinearVelocity
        local hSpeedSq = (currentVel.X * currentVel.X) + (currentVel.Z * currentVel.Z)

        -- Velocity Desync Fallback
        local targetY = -SAFE_CLAMP
        if hSpeedSq > 0 then
            local remainSq = (SAFE_CLAMP * SAFE_CLAMP) - hSpeedSq
            if remainSq > 400 then
                targetY = -math.sqrt(remainSq)
            else
                targetY = -55.0
            end
        end
        r.AssemblyLinearVelocity = Vector3.new(currentVel.X, targetY, currentVel.Z)

        -- ⚡ Anti Zero-Prediction Phase Shift
        -- Since prediction is 0, the bot tracks literal CFrame.
        -- This shifts the replicated CFrame coordinate back and forth by millimeters 
        -- so the server never gives the bot a static lock point.
        if not _G.TXR_Void_IsAirborne and h.FloorMaterial ~= Enum.Material.Air then
            local tickMod = math.floor(os.clock() * 120) % 2
            if tickMod == 0 then
                r.CFrame = r.CFrame * CFrame.new(0, -0.09, 0)
            else
                r.CFrame = r.CFrame * CFrame.new(0, 0.09, 0)
            end
        end
    end)
end

if _G.TXR_VoidLock_Active then
    _G.TXR_VoidLock_Active = false
    stopVoidEngine()
    sendNotify("🛡️ ANTI ROBOTS", "Deactivated", 2)
else
    _G.TXR_VoidLock_Active = true
    startVoidEngine()
    sendNotify("🛡️ ANTI ROBOTS", "V5 Anti-Zero Prediction Active", 2.5)
end
